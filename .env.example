# Только ИМЕНА переменных. Значения сюда не писать (SECURITY.md §3).

# --- App ---
NODE_ENV=
APP_URL=
PROPERTY_TIMEZONE=
PROPERTY_CURRENCY=
# Необязательно: адрес уже работающего API. Если пусто, npm run dev запускает локальный backend.
APP_API_URL=

# --- Database (production: регион Казахстан, ADR-009 / Q-070) ---
DATABASE_URL=
DATABASE_POOL_MAX=
DIRECT_URL=

# --- Supabase API (server only; does not replace PostgreSQL DATABASE_URL above) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# --- Redis / BullMQ ---
REDIS_URL=

# --- Channex ---
CHANNEX_API_BASE_URL=
CHANNEX_API_KEY=
CHANNEX_WEBHOOK_SECRET=
CHANNEX_PROPERTY_ID=
CHANNEX_ENV=

# --- eQonaq / Smart Bridge (Q-040..Q-046) ---
EQONAQ_API_BASE_URL=
EQONAQ_API_KEY=
EQONAQ_ENV=

# --- Fiscal provider (не выбран, Q-050..Q-053) ---
FISCAL_PROVIDER=
FISCAL_API_BASE_URL=
FISCAL_API_KEY=

# --- Object storage (документы гостей; только после решения Q-072) ---
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Шифрование PII ---
PII_ENCRYPTION_KEY=

# --- Auth ---
JWT_SECRET=
SESSION_SECRET=

# Замок входа (ADR-049). 1 — API отвечает 401 без сессии, стойка уводит на /login.
# В compose он включён по умолчанию; здесь строка нужна для запуска вне контейнеров.
AUTH_REQUIRED=1
APP_AUTH_REQUIRED=1

# ADR-055: регистрация открыта по решению владельца. 0 — явно отключить.
# ADR-057: зарегистрировавшийся входит только после подтверждения почты — для этого нужен MAIL_API_KEY.
# Настройка только у API; стойка читает её через /auth/options, отдельного APP-флага нет.
REGISTRATION_OPEN=1

# Соль для псевдонимов гостей (ADR-018). Любая случайная строка: openssl rand -hex 32
# Если не задана — берётся PII_ENCRYPTION_KEY. Захардкоженной соли в коде больше нет.
ANONYMIZE_SALT=

# Разрешить хранить НАСТОЯЩИЕ ФИО, телефоны и почту гостей: только для production-БД
# в Казахстане (ADR-009, Q-070). Любое другое значение или пустая строка — псевдонимы.
# PII_STORAGE=real

# Отправка почты (срез 13, ADR-046). Ключ создаёт владелец в панели Resend.
# Пустая строка здесь считается «не задано» и ломается на старте, а не посреди регистрации.
MAIL_PROVIDER=
MAIL_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=

# Ключ дежурного агента на сервере (срез 12, шаг 12.3). Пускает только читать сторожа:
# GET /guard/status и GET /guard/incidents, всё остальное отвечает отказом. Нужен, чтобы
# не класть всевластный SERVICE_API_KEY в контейнер с ИИ. Длинная случайная строка:
# openssl rand -hex 32. То же значение — в scripts/ops/guard/.env на сервере.
GUARD_READ_KEY=

# --- Сторож и дежурство (срезы 11 и 12) ---------------------------------------------------------
# Разбор 21.09.2026: этих четырёх строк здесь не было, хотя без них цепочка «сторож увидел →
# человека разбудили» не работает вовсе, а узнать об этом можно только по молчанию в ту ночь,
# когда она понадобится.

# Служебный ключ для скриптов, сверок и сторожа: заголовок x-wetop-service-key. При AUTH_REQUIRED=1
# без него скрипты получают 401. Длинная случайная строка: openssl rand -hex 32.
SERVICE_API_KEY=

# Будильник: бот Telegram шлёт неисправности дежурному (docs/telegram/README.md). Не заданы —
# сторож работает, но человека ночью никто не разбудит. Несколько чатов — через запятую.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Сигнал «я жив» на сервер «сторож сторожа» (срез 12, шаг 12.1). Без URL сигнал выключен, и
# смерть самого API остаётся незамеченной: изнутри её заметить нельзя.
GUARD_HEARTBEAT_URL=
GUARD_HEARTBEAT_SECRET=
