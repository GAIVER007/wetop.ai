# Только ИМЕНА переменных. Значения сюда не писать (SECURITY.md §3).

# --- App ---
NODE_ENV=
APP_URL=
PROPERTY_TIMEZONE=
PROPERTY_CURRENCY=
# Необязательно: адрес уже работающего API. Если пусто, npm run dev запускает локальный backend.
APP_API_URL=

# --- Database (production: регион Казахстан, ADR-009 / Q-070) ---
DATABASE_URL=
DATABASE_POOL_MAX=
DIRECT_URL=

# --- Supabase API (server only; does not replace PostgreSQL DATABASE_URL above) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# --- Redis / BullMQ ---
REDIS_URL=

# --- Channex ---
CHANNEX_API_BASE_URL=
CHANNEX_API_KEY=
CHANNEX_WEBHOOK_SECRET=
CHANNEX_PROPERTY_ID=
CHANNEX_ENV=

# --- eQonaq / Smart Bridge (Q-040..Q-046) ---
EQONAQ_API_BASE_URL=
EQONAQ_API_KEY=
EQONAQ_ENV=

# --- Fiscal provider (не выбран, Q-050..Q-053) ---
FISCAL_PROVIDER=
FISCAL_API_BASE_URL=
FISCAL_API_KEY=

# --- Object storage (документы гостей; только после решения Q-072) ---
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Шифрование PII ---
PII_ENCRYPTION_KEY=

# --- Auth ---
JWT_SECRET=
SESSION_SECRET=

# Самостоятельная регистрация новых организаций на /register. Пусто или 0 — закрыта, и это
# умолчание: пока данные организаций не разделены, новая организация видит объект гостиницы
# (Q-152, приёмка 20.09.2026). Вход сотрудников и приглашения работают всегда.
# Открывать вместе с APP_REGISTRATION_OPEN=1 у стойки — иначе кнопка есть, а API отказывает.
REGISTRATION_OPEN=
APP_REGISTRATION_OPEN=

# Соль для псевдонимов гостей (ADR-018). Любая случайная строка: openssl rand -hex 32
# Если не задана — берётся PII_ENCRYPTION_KEY. Захардкоженной соли в коде больше нет.
ANONYMIZE_SALT=

# Разрешить хранить НАСТОЯЩИЕ ФИО, телефоны и почту гостей: только для production-БД
# в Казахстане (ADR-009, Q-070). Любое другое значение или пустая строка — псевдонимы.
# PII_STORAGE=real

# Отправка почты (срез 13, ADR-046). Ключ создаёт владелец в панели Resend.
# Пустая строка здесь считается «не задано» и ломается на старте, а не посреди регистрации.
MAIL_PROVIDER=
MAIL_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=
