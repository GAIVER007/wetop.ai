# --- Secrets ---
.env
.env.*
!.env.example
*.pem
*.key
.n8n_token
# Ключи интеграций (SECURITY.md §3; агенту закрыт и на чтение — .claude/settings.json)
secrets/

# Ключ туннеля на сервере — обычный .json рядом с конфигом, под *.pem и *.key не попадает
deploy/cloudflared/
!deploy/cloudflared.example.yml
# Состояние выключателя ARI на конкретной машине (scripts/ops/ari.sh), не код
deploy/ari.env
# Копии базы (scripts/ops/db-backup.sh): в них вся база с гостями и деньгами — в git не едут ни при каких условиях
*.dump
*.dump.partial
backups/

# --- Claude Code: личное не едет в репозиторий ---
# settings.json (общие deny-правила) едет. settings.local.json — личные разрешения,
# туда пишутся абсолютные пути и команды целиком; worktrees — рабочие копии сессий.
.claude/settings.local.json
.claude/worktrees/
# Папка выдачи Cowork на Mac: туда ложатся файлы для владельца, в том числе ссылки с правом правки
# (ссылка на правку анкеты Channex лежала здесь в git до 02.10.2026, замечание ментора, ADR-137)
/Claude outputs/

# --- Персональные данные: реальные выгрузки НЕ коммитим (SECURITY.md §4) ---
project-input/retired-source/*
!project-input/retired-source/README.md
!project-input/retired-source/.gitkeep
# Аудит 07.09.2026 — проверено: данных гостей (ФИО, телефоны, email, документы) нет.
# Содержит рабочие email сотрудников и финансовые показатели объекта.
# Только разборы .md: таблица или выгрузка, положенная в эту папку, в git не уезжает (проверка 24.09.2026)
!project-input/retired-source/audit-2026-09-07/
project-input/retired-source/audit-2026-09-07/*
!project-input/retired-source/audit-2026-09-07/*.md
project-input/retired-source-screens/*
!project-input/retired-source-screens/README.md
!project-input/retired-source-screens/.gitkeep
project-input/forms/*
!project-input/forms/README.md
!project-input/forms/.gitkeep
project-input/interviews/*
!project-input/interviews/README.md
!project-input/interviews/.gitkeep

# --- Node ---
# Локальная рабочая копия завершённой сессии, не часть исходников проекта.
.agent-tmp/
node_modules/
dist/
build/
.next/
out/
coverage/
*.tsbuildinfo

# --- Tests ---
playwright-report/
test-results/

# --- OS / editors ---
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# --- Logs ---
*.log
# логи прогонов тестов — знание, едут в репозиторий; секреты вычищаются при записи (TESTING.md §7)
!tests/runs/logs/*.log
npm-debug.log*
pnpm-debug.log*
yarn-error.log*

# --- Prisma generated client (создаётся prisma generate) ---
packages/database/src/generated/

# Isolated UI test build, separate from the interactive preview
.next-ui/

# Замки прогонов: чей-то живой процесс, в историю не едут
tests/runs/.locks/

# --- Дизайн-система: скриншоты архивный источник с закрашенными фамилиями остаются на машине владельца (ADR-048, Д7) ---
design/reference/retired-source/*
!design/reference/retired-source/.gitkeep
tests/runs/.auth/
.agent-tmp/

# Ключ развёртывания дежурного агента на сервере (срез 12, шаг 12.3): кладёт владелец, в git не едет
scripts/ops/guard/ssh/

# Рабочие папки инструментов дизайн-системы: кэш выгрузки в Claude Design (`/design-sync`),
# сборка комплекта и состояние вспомогательных инструментов. Всё это порождается заново из
# design/tokens.json и кода, а `.ds-sync/` носит с собой свой node_modules (21.09.2026).
.design-sync/
.ds-sync/
ds-bundle/
.omx/
# PostgreSQL для локального стенда, скачанная scripts/ops/local-db.sh из npm (22.09.2026)
.local-pg/

# Вложенные клоны проекта на машине владельца: в индекс попали как ссылки без .gitmodules
# (коммит 1ca70ee9), git их не скачивает, а `git submodule status` на них падает насмерть
WETOP-pr93/
/Чат агент/

# Cloudflare Workers (apps/sites, MKT4): локальное состояние wrangler dev и пробные сборки
.wrangler/
.wrangler-dry/
