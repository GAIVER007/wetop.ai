# ──────────────────────────────────────────────────────────────────────
# ИИ-продавец. Имена переменных, значения пустые.
#
# Сведено из десятков боевых проектов: здесь только то, что нужно любому
# продавцу независимо от канала и заказчика. Всё остальное (доступы
# к площадке, к CRM, к телефонии) добавляется своим блоком, когда
# подключаете конкретную систему.
#
# 🔴 Этот файл лежит в репозитории. Реальных значений в нём не бывает
#    НИКОГДА: ни адресов, ни телефонов, ни ключей, ни паролей.
#    Боевой .env в репозиторий не попадает, проверьте .gitignore.
# ──────────────────────────────────────────────────────────────────────


# ─── Приложение ───
APP_ENV=                      # development | staging | production
DEBUG=                        # true только локально
PUBLIC_BASE_URL=              # адрес, по которому сервис виден снаружи
CORS_ORIGINS=                 # домены, которым разрешён доступ, через запятую


# ─── База данных ───
# Образ обязательно с pgvector: обычный postgres не подойдёт.
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=


# ─── Redis ───
REDIS_URL=                    # redis://хост:порт/номер_базы


# ─── Журнал ───
# Уровень: info в бою, debug только когда чините. debug в бою пишет
# в журнал содержимое запросов — вместе с тем, что клиент прислал.
LOG_LEVEL=info
# Ротация: без неё журнал растёт, пока не кончится диск, и падает всё
# сразу — бот, база, панель.
LOG_MAX_SIZE_MB=100
LOG_KEEP_FILES=5


# ─── Согласие на обработку данных ───
# 🔴 Включать ТОЛЬКО если основание обработки — согласие. Если основание
# другое (договор с клиентом, закон), гейт не нужен: он лишний экран
# и лишний отвал. Основание выясняется на брифе, раздел 5б.
CONSENT_GATE_ENABLED=false
CONSENT_POLICY_URL=           # адрес политики обработки у заказчика
CONSENT_POLICY_VERSION=       # редакция: дата или номер, меняется вместе с текстом
CONSENT_BUTTON_TEXT=          # что написано на кнопке, дословно


# ─── Модели ───
# Роутер, совместимый с OpenAI. Адрес меняется переменной, код не трогаем.
# Ключ получается один раз: регистрация → пополнить баланс → создать ключ
# в разделе API Keys. Дальше доступ ко всему каталогу уже есть, отдельно
# договариваться ни с кем не нужно.
# 🔴 Ключ ОДИН на все три модели каскада. Отдельных ключей под основную,
# запасную и аварийную не бывает — меняется только имя модели ниже.
LLM_API_KEY=
LLM_BASE_URL=                 # у российского роутера — https://polza.ai/api/v1

# Каскад из трёх моделей. 🔴 Вендоры обязаны быть РАЗНЫЕ: сбой одного
# поставщика не должен класть все три ступени разом.
LLM_MODEL=                    # основная, на ней идут почти все ходы
LLM_MODEL_FALLBACK=           # запасная, другой вендор
LLM_MODEL_EMERGENCY=          # аварийная, третий вендор

# Модели, которые заказчик вправе выбрать в панели сам. Пусто — выбор
# в панели не показывается вовсе, модель меняется только через настройки.
# 🔴 Список закрытый: свободного поля с именем модели в панели нет.
# Опечатка в имени = продавец молчит, а разбираться приедете вы.
LLM_ALLOWED_MODELS=           # через запятую, имена как у роутера

# Бюджет модели: токенов в сутки на гостиницу (у помощника — на экземпляр).
# Публичный ключ виджета без предела превращается в счёт за модель. Исчерпан —
# гость получает вежливую просьбу оставить контакт, платного вызова нет. 0 — без предела.
LLM_DAILY_TOKEN_BUDGET=3000000

LLM_TIMEOUT_SECONDS=          # на ОДНУ попытку. Измеряется на боевом промпте,
                              # не назначается на глаз. Сумма всей цепочки
                              # обязана быть меньше таймаута воркера
LLM_MAX_TOKENS=
LLM_TEMPERATURE=0.2           # продавцу нужна предсказуемость, не фантазия
LLM_HISTORY_TURNS=20          # сколько последних реплик уходит модели
# Путь к файлу системного промпта; пусто — умолчание data/system_prompt.md.
# Промпт — данные, не код: лежит на томе ./data и правится без пересборки.
PROMPT_PATH=


# ─── Защита ───
INJECTION_STRIKE_LIMIT=       # сколько срабатываний до блокировки
INJECTION_STRIKE_WINDOW_SECONDS=
IP_BLOCK_TTL_SECONDS=         # на сколько блокируется адрес
SLA_SECONDS=                  # дольше этого без ответа — алерт оператору
# Докуда сторож смотрит назад, часы. За пределами окна диалог выпадает
# из выборки: после долгого простоя старые разговоры иначе занимают предел
# и вытесняют свежие нарушения срока. Больше значение — видим дольше.
SLA_LOOKBACK_HOURS=24
# Сторож следит и за здоровьем самого бота. Обе болезни тихие:
# очередь встала или разговоры ждут человека, а в журнале пусто.
WATCH_OUTBOX_STUCK_MINUTES=30   # сколько висит неотправленное, прежде чем это тревога
WATCH_OUTBOX_STUCK_LIMIT=5      # сколько таких строк считаем затором
WATCH_NEEDS_HUMAN_LIMIT=10      # сколько разговоров ждут человека, прежде чем звать

# Предел длины входящего сообщения, символы: длиннее — обрезается до разбора.
GUARD_MAX_INPUT_CHARS=4000
# Дедуп двойной доставки от канала: одинаковый текст от того же клиента
# в этом окне второй раз не обрабатывается.
GUARD_DEDUP_TTL_SECONDS=60
# Крещендо: сколько последних реплик смотрим и сколько попаданий в словарь
# (правила, промпт, роль, забудь…) считаем атакой, размазанной по репликам.
GUARD_CRESCENDO_WINDOW=10
GUARD_CRESCENDO_HITS=3

# Номера и адреса самой компании, которые НЕ считаются утечкой персональных
# данных при маскировке в логах.
# 🔴 Заполняется только в боевом .env. В этом файле остаётся пустым.
PII_ALLOWLIST_PHONES=
PII_ALLOWLIST_EMAILS=


# ─── Панель оператора ───
DASHBOARD_JWT_SECRET=         # длинная случайная строка, не словарное слово
DASHBOARD_ADMIN_EMAIL=

# 🔴 Пароль хранится ХЕШЕМ, а не текстом. Хеш считается один раз
# (bcrypt или argon2) и кладётся сюда. Открытый пароль в файл настроек
# не попадает вовсе: файл читают агент, бэкап и тот, кто зайдёт на сервер.
DASHBOARD_ADMIN_PASSWORD_HASH=
DASHBOARD_SESSION_TTL_HOURS=  # сколько живёт вход, дальше логин заново

# Адрес панели: не /admin, а длинный случайный отрезок пути.
# Не защита сама по себе — она ниже. Но убирает автоматических
# переборщиков, которые ломятся в /admin и /wp-admin круглые сутки.
# 🔴 Заполняется только в боевом .env, в образце остаётся пустым.
DASHBOARD_PATH_PREFIX=        # например: /p7k2m9x4qz1w

# Защита от перебора пароля
DASHBOARD_LOGIN_MAX_ATTEMPTS=     # неудач подряд до блокировки
DASHBOARD_LOGIN_WINDOW_SECONDS=   # окно, в котором они считаются
DASHBOARD_LOGIN_BLOCK_SECONDS=    # на сколько блокируется адрес и учётка
DASHBOARD_LOGIN_ALERT_AFTER=      # с какой попытки идёт алерт владельцу

# Ограничение по адресам: пусто — вход отовсюду. Заполнено — только
# с перечисленных адресов. Ставится, когда у заказчика фиксированный
# офисный адрес; с мобильного интернета работать перестанет.
DASHBOARD_ALLOWED_IPS=

# ─── Второй фактор: код из приложения-аутентификатора ───
# После пароля панель спрашивает шестизначный код из Google Authenticator,
# Яндекс.Ключа или любого другого приложения по тому же стандарту.
# Украденного пароля становится недостаточно.
DASHBOARD_2FA_ENABLED=true
DASHBOARD_2FA_ISSUER=             # что видно в приложении: имя проекта
DASHBOARD_2FA_DRIFT_STEPS=1       # допуск по времени: 1 = ±30 секунд
DASHBOARD_2FA_BACKUP_CODES=8      # сколько резервных кодов выдать при подключении
# Своего предела у кодов нет: неудачный код считается как неудачный пароль,
# и блокировка приходит по DASHBOARD_LOGIN_MAX_ATTEMPTS.
# 🔴 Секрет каждого пользователя хранится в базе (таблица dashboard_users),
# а НЕ здесь: пользователей больше одного, и у каждого свой телефон.


# ─── Алерты: ДВА канала, а не один ───
# Почта — основной. Мессенджер — дубль, а не замена: у одного из наших
# проектов api.telegram.org заблокирован в РФ по IPv4, и алерты уходили
# с задержкой или не уходили вовсе. Один канал = молчание в тот вечер,
# когда алерт нужнее всего.
SMTP_HOST=
SMTP_PORT=                    # 465 (implicit TLS) или 587 (STARTTLS)
SMTP_USER=
SMTP_PASSWORD=                # пароль ПРИЛОЖЕНИЯ, не от почтового ящика
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=               # можно несколько через запятую

# Дубль в мессенджер. Пусто — работает только почта, это допустимо.
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=       # группа менеджеров; узнаётся у самого бота
# Личный адрес владельца: получает те же алерты отдельной строкой очереди.
# Группа дежурных ночью спит, владелец — нет; недоставка в группу не должна
# отменять доставку лично. Совпадает с адресом группы — второй строки нет.
ALERT_TELEGRAM_CHAT_ID_PERSONAL=

# Сколько держим недоставленный алерт, прежде чем сдаться.
ALERT_RETRY_WINDOW_HOURS=24
ALERT_RETRY_INTERVAL_SECONDS=60

# Дедуп: сколько молчать после такого же алерта. Без него один инцидент
# даёт сотни писем за ночь.
ALERT_DEDUP_SLA_MINUTES=10
ALERT_DEDUP_HOT_LEAD_HOURS=24

# Проверка самого канала алертов. Раз в сутки уходит тестовое сообщение:
# не пришло — значит доставка сломалась, и вы узнаёте об этом сами,
# а не в день, когда понадобится настоящий алерт.
ALERT_HEARTBEAT_ENABLED=true
ALERT_HEARTBEAT_HOUR=9        # час по времени сервера

# 🔴 Второй рубеж поверх дедупа: предел ОДНОТИПНЫХ алертов в час.
# Дедуп гасит повтор одного инцидента, но ключ вида «llm_down:{диалог}»
# у каждого диалога свой, и массовый отказ модели даёт шторм: на живом
# прогоне — 334 сообщения за две минуты. Сверх предела уходит ровно одно
# сообщение «поток подавлен», дальше тишина до конца часа.
ALERT_RATE_LIMIT_PER_HOUR=10

# Адрес Bot API бота АЛЕРТОВ. Менять только для прокси или тестов.
ALERT_TELEGRAM_API_BASE=https://api.telegram.org
# Запасные адреса Bot API для бота алертов, через запятую. Пусто —
# берётся ALERT_TELEGRAM_API_BASE.
# 🔴 Перебор идёт СТРОГО по порядку списка. Ставьте живой адрес первым:
# в одном инциденте рабочий стоял последним, мёртвый первым, и перебор
# упирался в таймаут раньше, чем доходил до живого.
ALERT_TELEGRAM_API_BASES=

# Правка части настроек на лету, без перезапуска (src/runtime_settings.py).
# Имена через запятую; чего нет в списке — панель изменить не может.
# 🔴 Системного промпта здесь нет и быть не должно: его источник правды —
# файл на томе (PROMPT_PATH), а не ключ в Redis. Два источника правды
# у промпта означают, что однажды поедет тот, который вы не смотрите.
RUNTIME_SETTINGS_ALLOWED=llm_model,sla_seconds,alert_heartbeat_enabled,guard_max_input_chars

# Сколько суток хранить дампы базы (scripts/backup.sh).
# 🔴 Бэкап не существует, пока из него не восстановились: в первую неделю
# сделайте дамп и поднимите его в отдельную базу.
BACKUP_KEEP_DAYS=14


# ─── Канал: виджет на сайте ───
# Единственный канал клиентов: виджет на страницах платформы. Бот живёт
# внутри платформы и отвечает её пользователям.
# 🔴 Виджет — канал с ВЫТЯГИВАНИЕМ: браузер сам спрашивает новые сообщения
# долгим опросом. Наружу бот ничего не доставляет, поэтому очереди
# исходящих у канала нет.

# Домены платформы через запятую (схема и хост, как их шлёт браузер
# в Origin). По ним проверяется Origin и настраивается CORS.
# 🔴 Пусто — проверка Origin ВЫКЛЮЧЕНА, и виджет отвечает любому сайту.
# Это только для разработки; при старте уходит предупреждение в журнал.
WIDGET_SITE_HOSTS=

# Общий секрет с платформой: им платформа подписывает признак вошедшего
# пользователя (кто пишет, из какой организации, с какой ролью). Бот
# проверяет подпись и срок — тому, что прислал браузер, веры нет.
# 🔴 Пусто — подписанные признаки не принимаются вовсе, все посетители
# обслуживаются как анонимные. Это рабочий режим, а не поломка.
WIDGET_IDENTITY_SECRET=
# Равен сроку сессии платформы (12 ч): виджет читает подпись один раз,
# а приложение платформы ходит по экранам без перезагрузки страницы.
WIDGET_IDENTITY_TTL_SECONDS=43200

# Сколько живёт ключ посетителя в браузере: 30 суток. Срок уезжает
# в браузер ответом /widget/session и хранится рядом с ключом — правка
# здесь меняет поведение виджета без пересборки скрипта.
WIDGET_SESSION_TTL_HOURS=720

# Предел сообщений с одной сессии в час. Сверх него — 429 с нейтральным
# телом: текста ошибки клиенту не показываем.
WIDGET_MESSAGES_PER_HOUR=60

# Предел тела запроса. 🔴 Проверяется по Content-Length ДО чтения:
# прочитать, а потом отбить — значит уже принять переросток в память.
WIDGET_MAX_BODY_BYTES=65536

# Вложения: снимок экрана от пользователя платформы.
WIDGET_ATTACHMENTS_ENABLED=true
WIDGET_ATTACHMENT_MAX_MB=5
WIDGET_ATTACHMENT_DIR=data/attachments
# Папка вложений — на том же диске, что база: предел объёма и срок хранения.
# Сверх предела новый снимок не принимается (507), старше срока — удаляется.
WIDGET_ATTACHMENT_DIR_MAX_MB=500
WIDGET_ATTACHMENT_KEEP_DAYS=30
# Что принимаем. Тип проверяется и по заголовку, и по первым байтам файла:
# заголовку от браузера верить нельзя.
WIDGET_ATTACHMENT_TYPES=image/png,image/jpeg,image/webp

# Долгий опрос: сколько браузер висит на запросе, если новых сообщений нет.
WIDGET_POLL_TIMEOUT_SECONDS=25

# 🔴 Бот алертов из секции «Алерты» — это ДРУГОЙ бот и другая задача.
# Он остаётся: владелец получает уведомления в мессенджер дублем к почте.

# ──────────────────────────────────────────────────────────────────────
# ДАЛЬШЕ — БЛОКИ, КОТОРЫЕ ДОБАВЛЯЮТСЯ ПОД ЗАДАЧУ
#
# Канал: доступы к площадке, мессенджеру или виджету.
# CRM или учётная система: адрес, ключ, права.
# Голос: ключи синтеза и распознавания речи.
#
# Каждый такой блок пишите отдельной секцией с заголовком, а не
# вперемешку с ядром: через полгода вы будете искать, что здесь чьё.
# ──────────────────────────────────────────────────────────────────────


# ─── База знаний ───
# Нарезка документов: размер куска в символах, перекрытие соседних кусков
# и минимальный размер (короче — приклеивается к предыдущему). Строки
# таблиц — всегда отдельный кусок, эти пределы на них не действуют.
KB_CHUNK_CHARS=900
KB_CHUNK_OVERLAP=150
KB_CHUNK_MIN_CHARS=80
# Предел размера загружаемого файла, мегабайты. Проверяется ДО чтения
# файла — по заявленному размеру, чтобы не держать в памяти то, что
# всё равно отклоним.
KB_MAX_FILE_MB=10
# Модель эмбеддингов и её размерность.
# 🔴 Размерность должна совпадать с VECTOR(384) в схеме базы: смена
# модели = смена этого числа и переиндексация всего. То же имя модели
# зашито в Dockerfile (слой с моделью) — меняются оба места.
KB_EMBED_MODEL=intfloat/multilingual-e5-small
KB_EMBED_DIM=384
# Кэш векторов в Redis, секунды (7 суток): один и тот же текст второй раз
# в модель не идёт.
KB_EMBED_CACHE_TTL_SECONDS=604800
# Прогрев модели при старте: первый клиент не ждёт загрузки ~450 МБ.
# Не прогрелась — публичный /health отвечает 503. Выключают только тесты.
KB_EMBED_WARMUP=true
# Сколько кусков базы знаний отдавать модели на один вопрос.
KB_TOP_K=5


# ─── Внешняя система ───
# Режим выбирается НАСТРОЙКОЙ, а не правкой кода: одна реализация
# на протокол, выбор — фабрикой.
#   stub  — честная заглушка для разработки: отвечает «не знаю»
#           и ничего не выдумывает;
#   wetop — реализация под внешнюю систему заказчика.
# Неизвестное значение сводится к stub с предупреждением в журнал.
INTEGRATION_MODE=stub
# 🔴 Адрес и ключ внешней системы в репозиторий не попадают: только здесь.
# Пусто при INTEGRATION_MODE=wetop — работаем на заглушке.
INTEGRATION_BASE_URL=
INTEGRATION_API_KEY=
# Таймаут одного обращения к внешней системе, секунды. Недоступная
# система не должна задерживать ответ клиенту.
INTEGRATION_TIMEOUT_SECONDS=10


# ─── Роль бота ───
# Кем работает этот экземпляр. От роли зависят инструменты модели,
# системный промпт и то, собирается ли контакт:
#   support — помощник платформы: отвечает её пользователям про разделы
#             и ошибки, ищет причину в справочнике и в происшествиях,
#             заявок не собирает — человек уже внутри платформы;
#   seller  — продавец: ведёт клиента по воронке, собирает контакт
#             и передаёт заявку во внешнюю систему.
# Неизвестное значение сводится к support с предупреждением в журнал.
BOT_ROLE=support
# Справочник ошибок платформы. 🔴 Это ДАННЫЕ: их правит владелец на томе,
# без правки кода и без выкатки. Ни адресов, ни ключей, ни персональных
# данных пользователей там быть не должно.
ERRORS_CATALOG_PATH=data/errors.md
# Папка с документацией платформы для разовой загрузки в базу знаний
# (scripts/load_knowledge.py). Документы проходят те же проверки входа,
# что и сообщения: инструкция для модели внутри файла отбивается.
KNOWLEDGE_DIR=data/knowledge
# Как далеко назад бот смотрит происшествия пользователя, часы.
SUPPORT_INCIDENT_WINDOW_HOURS=24
# Сколько происшествий уходит модели за один ответ.
SUPPORT_MAX_INCIDENTS=5


# ─── Служебное ───
# Полный URL SQLAlchemy. Заполнен — переопределяет сборку из POSTGRES_*.
# В бою пусто; нужен тестам (sqlite+aiosqlite:///...) и разовым запускам.
DATABASE_URL=
# Ключ подробной проверки живости /internal/health (заголовок
# X-Internal-Key). Пусто — подробная проверка закрыта, отвечает 403.
# Публичный /health от ключа не зависит и отдаёт только статус.
INTERNAL_HEALTH_KEY=
# Служебный вход платформы WETOP в панель бота (заголовок X-Service-Key).
# Открывает только диалоги, знания, профиль и факты продавца, сводку и песочницу;
# промпт целиком и модель им не меняются. Пусто — вход закрыт.
SELLER_SERVICE_KEY=
# Судья прогона качества ответов (python eval/run.py): другая модель, не из
# каскада выше, лучше другого вендора. Нужен только для прогона, боту не нужен.
EVAL_JUDGE_MODEL=
