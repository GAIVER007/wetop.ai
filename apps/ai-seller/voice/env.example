# Голосовой агент. Имена переменных, значения пустые. Реальных значений в репозитории не бывает.

# VideoSDK: токен из панели https://app.videosdk.live/api-keys
VIDEOSDK_AUTH_TOKEN=
# Ключ Gemini (модель Live)
GOOGLE_API_KEY=

# Идентификатор воркера. Должен совпасть с dispatch.agent.id правила маршрутизации.
VOICE_AGENT_ID=
# Порт воркера
VOICE_WORKER_PORT=8081

# Откуда читать справочники объекта (те же адреса /bot/*, что у текстового продавца)
VOICE_WETOP_BASE_URL=
VOICE_WETOP_SERVICE_KEY=

# Ключ приёма событий звонков в API платформы (VOICE_INGEST_KEY на стороне API). Значение вписывает владелец.
VOICE_INGEST_KEY=
# Каталог очереди событий на смонтированном томе. Пусто: рядом с журналом, <журнал>.outbox
VOICE_OUTBOX_DIR=

# JSON (необязательно, пусто = любая пара из metadata правила маршрутизации; платформа проверяет агента): {"+7XXXXXXXXXX": {"organization_id": "<uuid>", "agent_id": "<uuid>"}}
VOICE_NUMBER_MAP=

# Профиль берётся с платформы по agent_id; значения ниже нужны только если платформа недоступна
VOICE_OBJECT_NAME=
VOICE_NAME=Leda
# Номер администратора для перевода звонка (E.164). Пусто: перевода нет.
VOICE_HANDOFF_NUMBER=

# Файл журнала звонков на смонтированном томе
VOICE_JOURNAL_PATH=
