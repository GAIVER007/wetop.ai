{
  "name": "@wetop/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "expo": "~58.0.19",
    "expo-constants": "~58.0.13",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.26",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "jest": "^30.0.0",
    "jest-expo": "~58.0.12",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "<rootDir>/tests/**/*.test.tsx"
    ],
    "watchman": false
  }
}
