{
  "name": "pms-lux",
  "version": "0.0.0",
  "private": true,
  "description": "PMS MVP for Luxx Aparts (Almaty). Replaces Exely. Modular monolith (ADR-002).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "scripts/*"
  ],
  "scripts": {
    "dev": "tsx scripts/preview/start-real.ts",
    "check:connection": "tsx scripts/preview/start-real.ts --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:record": "tsx tests/tools/cli-record.ts",
    "test:status": "tsx tests/tools/cli-status.ts",
    "test:schema": "tsx tests/tools/cli-test-schema.ts",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --check \"**/*.{ts,tsx,js,json}\"",
    "format:fix": "prettier --write \"**/*.{ts,tsx,js,json}\"",
    "check": "npm run lint && npm run typecheck && npm run typecheck:api && npm run typecheck:web && npm test",
    "e2e": "playwright test",
    "typecheck:web": "tsc -p apps/web/tsconfig.json --noEmit",
    "typecheck:api": "tsc -p apps/api/tsconfig.json --noEmit",
    "morning": "tsx scripts/reconciliation/src/cli-morning-report.ts",
    "telegram:chats": "tsx scripts/ops/telegram-chats.ts",
    "e2e:cleanup": "tsx scripts/reconciliation/src/cli-e2e-cleanup.ts",
    "analytics:retention": "tsx scripts/reconciliation/src/cli-analytics-retention.ts",
    "cutover:channel": "tsx scripts/reconciliation/src/cli-cutover-channel.ts",
    "cutover:ambiguous": "tsx scripts/reconciliation/src/cli-cutover-ambiguous.ts",
    "reconcile:day": "tsx scripts/reconciliation/src/cli-double-entry.ts",
    "reconcile:cancellations": "tsx scripts/reconciliation/src/cli-cancellations.ts",
    "citizenship:audit": "tsx scripts/reconciliation/src/cli-citizenship-audit.ts",
    "accounts": "DATABASE_POOL_MAX=1 tsx scripts/ops/cli-accounts.ts",
    "dev:demo": "node scripts/preview/start-demo.mjs",
    "site:build": "npm run build -w apps/site",
    "site:deploy": "npm run site:build && npx wrangler@latest pages deploy apps/site/out --project-name wetop-site --branch main"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.0",
    "eslint": "^10.10.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true,
    "fsevents@2.3.3": true,
    "esbuild@0.28.2": true
  }
}
