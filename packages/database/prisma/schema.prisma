// Prisma schema — ТОЛЬКО утверждённые разделы DATA_MODEL.md v1.0 (07.09.2026):
//   §1 Объект и физическая структура, §2 Бронирование, §3 Гости, §4 Housekeeping и блокировки,
//   §5 Тарифы, §6 Folio, §7 Channel Manager, §8 Внешние события, §10 Аудит. Плюс SQL вне Prisma: exclusion constraint на allocations (миграция 20260909000003).
// Раздел 6 (Folio) утверждён 09.09.2026 (ADR-014): счёт на проживание, миграция 20260909000006.
// Любое изменение сущности/поля/связи — сначала правка DATA_MODEL.md (AGENTS.md §2).
//
// Соглашения: имена таблиц и колонок — snake_case через @map; id — uuid;
// события — timestamptz (UTC); stay dates — DATE в timezone объекта (AGENTS.md §13).
// Внешние ID действующих каналов хранятся как ссылки, не как собственные ключи (ADR-003, ADR-118).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // url задаётся в prisma.config.ts из DIRECT_URL / DATABASE_URL (значение — только в .env)
}

// ───────────────────────── §1 Объект и физическая структура ─────────────────────────

/// Объект размещения. В MVP одна запись (ADR-001), но все запросы фильтруются по property_id.
/// Вертикаль направления бизнеса (Platform P1, ADR-104, DATA_MODEL §18.1): canonical vertical живёт
/// ТОЛЬКО здесь — не на организации и не на филиале (Q-199, вариант Б).
enum BusinessVertical {
  HOSPITALITY
  BEAUTY
}

/// Удаления строк нет, как во всём §13 — только архив.
enum BusinessStatus {
  ACTIVE
  ARCHIVED
}

enum LocationStatus {
  ACTIVE
  ARCHIVED
}

/// Направление/бренд партнёра (Platform P1, ADR-104, DATA_MODEL §18.1): «Luxx Hotels», «Alma Beauty».
/// У организации N бизнесов; вертикаль — здесь. Тёзки внутри организации допустимы (§18.1).
model Business {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  name           String           @db.VarChar(200)
  vertical       BusinessVertical
  status         BusinessStatus   @default(ACTIVE)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  locations    Location[]

  @@index([organizationId])
  @@map("businesses")
}

/// Филиал бизнеса (Platform P1, ADR-104, DATA_MODEL §18.2): «Luxx Aparts», «Marina». Принадлежит одному
/// Business; БЕЗ organization_id (выводится через business_id — §18.3) и БЕЗ vertical (только у Business).
/// Правило дат AGENTS.md §13 отсчитывается от timezone филиала.
model Location {
  id         String         @id @default(uuid()) @db.Uuid
  businessId String         @map("business_id") @db.Uuid
  name       String         @db.VarChar(200)
  address    String?        @db.VarChar(500)
  phone      String?
  email      String?
  /// IANA, «Asia/Almaty»
  timezone   String         @db.VarChar(50)
  /// операционная валюта филиала (KZT, AED, …)
  currency   String         @db.VarChar(3)
  status     LocationStatus @default(ACTIVE)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  business Business  @relation(fields: [businessId], references: [id])
  property Property?
  sellerAgents SellerAgent[]

  @@index([businessId])
  @@map("locations")
}

model Property {
  id           String   @id @default(uuid()) @db.Uuid
  /// Чей это объект (ADR-061). Обязателен с v1.13 (ADR-103): по нему режет Row Level Security (§17).
  organizationId String @map("organization_id") @db.Uuid
  name         String
  legalName    String?  @map("legal_name")
  bin          String?
  address      String?
  /// Контакты объекта для печатных форм (v1.7, ADR-082): до них телефон и почта были зашиты в код
  /// печати и напечатались бы в договоре любой организации. Пустое — в формах прочерк.
  phone        String?
  email        String?
  /// IANA timezone объекта, например Asia/Almaty
  timezone     String
  /// ISO 4217, на объекте KZT
  currency     String   @db.Char(3)
  /// Локальное время заезда "HH:mm", на объекте 14:00
  checkInTime  String   @map("check_in_time")
  /// Локальное время выезда "HH:mm", на объекте 12:00
  checkOutTime String   @map("check_out_time")
  /// Platform P1 (ADR-104, DATA_MODEL §18.4, v2.6): родитель объекта — филиал (1:1), NOT NULL с миграции
  /// 20260928000032; новый объект — через createPropertyInChain. organization_id остаётся, пока замок
  /// ADR-061 не переведён на цепочку Location → Business, и совпадает с организацией Business.
  locationId   String   @unique @map("location_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Ключ и индекс — как их строит миграция 20260920000016: ON DELETE и ON UPDATE — NO ACTION.
  /// Организацию, за которой числится объект, удалить нельзя: объект не становится ничьим молча.
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// Location удалить, пока на ней объект, нельзя (RESTRICT): объект не остаётся без точки молча.
  location           Location            @relation(fields: [locationId], references: [id], onDelete: Restrict)
  buildings          Building[]
  accommodationTypes AccommodationType[]
  reservations       Reservation[]
  ratePlans          RatePlan[]
  channelMappings    ChannelMapping[]
  payments           Payment[]
  services           Service[]
  trackedSites       TrackedSite[]
  inventoryUnits     InventoryUnit[]
  externalEvents     ExternalEvent[]
  channelOutbox      ChannelOutbox[]

  @@index([organizationId])
  @@map("properties")
}

model Building {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @map("property_id") @db.Uuid
  name       String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  property Property @relation(fields: [propertyId], references: [id])
  floors   Floor[]

  @@unique([propertyId, name])
  @@map("buildings")
}

model Floor {
  id         String   @id @default(uuid()) @db.Uuid
  buildingId String   @map("building_id") @db.Uuid
  name       String
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  building      Building       @relation(fields: [buildingId], references: [id])
  physicalRooms PhysicalRoom[]

  @@unique([buildingId, name])
  @@map("floors")
}

/// Продаваемая категория. Гендерное деление dorm — отдельные категории, не атрибут (DATA_MODEL §1).
enum AccommodationKind {
  PRIVATE_ROOM
  DORM_BED
  APARTMENT
}

model AccommodationType {
  id               String            @id @default(uuid()) @db.Uuid
  propertyId       String            @map("property_id") @db.Uuid
  code             String
  name             String
  kind             AccommodationKind
  capacityAdults   Int               @map("capacity_adults")
  /// На объекте у всех 0: детское размещение выключено
  capacityChildren Int               @default(0) @map("capacity_children")
  active           Boolean           @default(true)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  property        Property                    @relation(fields: [propertyId], references: [id])
  units           InventoryUnit[]
  items           ReservationItem[]
  ratePlanLinks   RatePlanAccommodationType[]
  dailyRates      DailyRate[]
  restrictions    Restriction[]
  channelMappings ChannelMapping[]

  @@unique([propertyId, code])
  @@map("accommodation_types")
}

/// Физическая комната. По ADR-013 при импорте заполняется 1:1 из единицы продажи (Q-095 отложен).
/// Бизнес-логика MVP на неё не опирается — только на InventoryUnit.
model PhysicalRoom {
  id         String   @id @default(uuid()) @db.Uuid
  floorId    String   @map("floor_id") @db.Uuid
  roomNumber String   @map("room_number")
  name       String?
  capacity   Int
  isDorm     Boolean  @default(false) @map("is_dorm")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  floor Floor           @relation(fields: [floorId], references: [id])
  units InventoryUnit[]

  @@unique([floorId, roomNumber])
  @@map("physical_rooms")
}

enum InventoryUnitKind {
  ROOM
  BED
}

/// Рабочий статус уборки. Ремонт/вывод из продажи — InventoryBlock.
enum HousekeepingStatus {
  DIRTY
  CLEAN
  INSPECTED
}

/// Единица продажи = ячейка (ADR-013). На объекте 88 = 16 ROOM + 72 BED.
/// Ничего не выводится из номера единицы — только явные связи (DATA_MODEL принцип 7).
model InventoryUnit {
  id                  String             @id @default(uuid()) @db.Uuid
  /// Объект места (v1.12, ADR-099): дублирует объект категории, чтобы код был уникален внутри объекта
  propertyId          String             @map("property_id") @db.Uuid
  physicalRoomId      String             @map("physical_room_id") @db.Uuid
  accommodationTypeId String             @map("accommodation_type_id") @db.Uuid
  kind                InventoryUnitKind
  /// Код места в PMS; уникален внутри объекта (v1.12) — искать только в паре с объектом
  code                String
  housekeepingStatus  HousekeepingStatus @default(DIRTY) @map("housekeeping_status")
  active              Boolean            @default(true)
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  property           Property            @relation(fields: [propertyId], references: [id])
  physicalRoom       PhysicalRoom        @relation(fields: [physicalRoomId], references: [id])
  accommodationType  AccommodationType   @relation(fields: [accommodationTypeId], references: [id])
  blocks             InventoryBlock[]
  housekeepingEvents HousekeepingEvent[]
  allocations        Allocation[]

  @@unique([propertyId, code])
  @@index([accommodationTypeId])
  @@index([physicalRoomId])
  @@map("inventory_units")
}

// ───────────────────────── §2 Бронирование ─────────────────────────

/// Источник брони. Обязателен без значения по умолчанию (Q-089 — до ответа принято самое строгое).
enum ReservationSource {
  DESK
  PHONE
  WHATSAPP
  WALK_IN
  INSTAGRAM
  OTA
  WEBSITE
}

enum ReservationStatus {
  TENTATIVE
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}

/// Шапка брони (коммерческая бронь). Статус — производный от проживаний (v0.3), хранится для выборок.
/// `confirmationNumber` — бизнес-ключ брони внутри объекта (ADR-003, ADR-007).
model Reservation {
  id                 String            @id @default(uuid()) @db.Uuid
  propertyId         String            @map("property_id") @db.Uuid
  confirmationNumber String            @map("confirmation_number")
  source             ReservationSource
  /// Канал OTA/сайт как текст источника (например Booking.com); null для стойки
  channel            String?
  /// Номер брони на стороне канала (OTA), если известен
  externalId         String?           @map("external_id")
  status             ReservationStatus
  bookedAt           DateTime?         @map("booked_at") @db.Timestamptz(6)
  arrivalDate        DateTime          @map("arrival_date") @db.Date
  departureDate      DateTime          @map("departure_date") @db.Date
  adults             Int
  children           Int               @default(0)
  currency           String            @db.Char(3)
  /// integer minor units (тиын), ADR-008
  totalAmount        BigInt            @map("total_amount")
  primaryGuestId     String?           @map("primary_guest_id") @db.Uuid
  /// Заметки — главный канал передачи смены (FINDINGS §2 #8)
  notes              String?
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  property     Property          @relation(fields: [propertyId], references: [id])
  primaryGuest Guest?            @relation("primaryGuest", fields: [primaryGuestId], references: [id])
  items        ReservationItem[]
  webSessions  WebSession[]

  @@unique([propertyId, confirmationNumber])
  /// дубль OTA-брони отвергает база, NULL ручных броней различны (ТЗ аудита 25.09, С-4; v1.10)
  @@unique([propertyId, externalId])
  @@index([propertyId, arrivalDate])
  @@index([propertyId, departureDate])
  @@index([status])
  @@map("reservations")
}

/// Проживание (room stay): одна ячейка на весь период (ADR-013; `quantity` убран, v0.3).
/// Статус ведётся здесь: no-show, переселение и счёт — на уровне проживания.
model ReservationItem {
  id                  String            @id @default(uuid()) @db.Uuid
  reservationId       String            @map("reservation_id") @db.Uuid
  accommodationTypeId String            @map("accommodation_type_id") @db.Uuid
  arrivalDate         DateTime          @map("arrival_date") @db.Date
  departureDate       DateTime          @map("departure_date") @db.Date
  /// integer minor units (тиын), ADR-008
  price               BigInt
  status              ReservationStatus
  /// Тариф проживания (Q-102); null — тариф ещё не назначен
  ratePlanId          String?           @map("rate_plan_id") @db.Uuid
  /// Гостей на проживании (Q-102): occupancy для цены и штрафа
  adults              Int               @default(1)
  children            Int               @default(0)
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  reservation       Reservation       @relation(fields: [reservationId], references: [id])
  accommodationType AccommodationType @relation(fields: [accommodationTypeId], references: [id])
  ratePlan          RatePlan?         @relation(fields: [ratePlanId], references: [id])
  allocations       Allocation[]
  stayGuests        StayGuest[]
  folio             Folio?

  @@index([reservationId])
  @@index([ratePlanId])
  @@index([accommodationTypeId, arrivalDate, departureDate])
  @@map("reservation_items")
}

/// Кто живёт в каком проживании (v0.3). Нужно для eQonaq (на гостя) и folio по проживанию.
model StayGuest {
  reservationItemId String  @map("reservation_item_id") @db.Uuid
  guestId           String  @map("guest_id") @db.Uuid
  isPrimary         Boolean @default(false) @map("is_primary")

  reservationItem ReservationItem @relation(fields: [reservationItemId], references: [id])
  guest           Guest           @relation(fields: [guestId], references: [id])

  @@id([reservationItemId, guestId])
  @@index([guestId])
  @@map("stay_guests")
}

/// Фактическое назначение ячейки на период [start_date, end_date). Переселение = закрыть одну
/// allocation и открыть другую (ADR-006). Правило автоназначения для OTA — Q-094.
model Allocation {
  id                String   @id @default(uuid()) @db.Uuid
  reservationItemId String   @map("reservation_item_id") @db.Uuid
  inventoryUnitId   String   @map("inventory_unit_id") @db.Uuid
  startDate         DateTime @map("start_date") @db.Date
  endDate           DateTime @map("end_date") @db.Date
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  reservationItem ReservationItem @relation(fields: [reservationItemId], references: [id])
  inventoryUnit   InventoryUnit   @relation(fields: [inventoryUnitId], references: [id])

  @@index([inventoryUnitId, startDate, endDate])
  @@index([reservationItemId])
  @@map("allocations")
}

// ───────────────────────── §3 Гости ─────────────────────────

enum Gender {
  MALE
  FEMALE
  UNKNOWN
}

/// Персональные данные — доступ по роли, не попадают в логи (SECURITY.md §1).
/// В dev-БД только анонимизированные значения (ADR-018).
model Guest {
  id            String    @id @default(uuid()) @db.Uuid
  /// Гость принадлежит своей организации (v1.13 RLS-1, ADR-103; колонку nullable завела Phase 1 ADR-100 §17.2,
  /// NOT NULL и DEFAULT app_current_org() — миграция 20260927000027). Служебный путь передаёт организацию объекта сам.
  organizationId String   @default(dbgenerated("app_current_org()")) @map("organization_id") @db.Uuid
  firstName     String    @map("first_name")
  lastName      String    @map("last_name")
  middleName    String?   @map("middle_name")
  birthDate     DateTime? @map("birth_date") @db.Date
  /// ISO 3166-1 alpha-3 либо NULL; обязательно на check-in, не на импорте (DATA_MODEL §3).
  /// VARCHAR, не CHAR: тип фиксированной длины дополнял пустую строку пробелами, и '   ' читалось
  /// как заполненное гражданство. Формат стережёт CHECK guests_citizenship_alpha3 (Q-117).
  citizenship   String?   @db.VarChar(3)
  gender        Gender    @default(UNKNOWN)
  phone         String?
  email         String?
  notes         String?
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization        Organization    @relation(fields: [organizationId], references: [id])
  documents           GuestDocument[]
  stays               StayGuest[]
  primaryReservations Reservation[]   @relation("primaryGuest")

  @@index([organizationId])
  @@index([lastName, firstName])
  @@index([phone])
  @@map("guests")
}

/// Документ гостя. Номер — только шифротекст (PII_ENCRYPTION_KEY), просмотр логируется.
model GuestDocument {
  id              String    @id @default(uuid()) @db.Uuid
  guestId         String    @map("guest_id") @db.Uuid
  type            String
  numberEncrypted String    @map("number_encrypted")
  /// ISO 3166-1 alpha-3 либо NULL; CHECK guest_documents_issue_country_alpha3 (Q-117)
  /// Открытым остаётся намеренно: класс «персональные», как citizenship, нужен eQonaq (v1.7, ADR-082)
  issueCountry    String?   @map("issue_country") @db.VarChar(3)
  /// Даты документа — особо чувствительные (SECURITY.md §1): ISO-дата, зашифрованная тем же ключом,
  /// что номер (v1.7, ADR-082). В запросах не участвуют — только запись и показ, расшифровка в приложении
  issuedAtEncrypted  String? @map("issued_at_encrypted")
  expiresAtEncrypted String? @map("expires_at_encrypted")
  documentFileId  String?   @map("document_file_id")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  guest Guest @relation(fields: [guestId], references: [id])

  @@index([guestId])
  @@map("guest_documents")
}

// ───────────────────────── §4 Housekeeping и блокировки ─────────────────────────

model HousekeepingEvent {
  id              String             @id @default(uuid()) @db.Uuid
  inventoryUnitId String             @map("inventory_unit_id") @db.Uuid
  fromStatus      HousekeepingStatus @map("from_status")
  toStatus        HousekeepingStatus @map("to_status")
  /// Сущность User появится после Q-060…Q-064; до этого — идентификатор без FK
  userId          String?            @map("user_id") @db.Uuid
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  inventoryUnit InventoryUnit @relation(fields: [inventoryUnitId], references: [id])

  @@index([inventoryUnitId, createdAt])
  @@map("housekeeping_events")
}

enum InventoryBlockType {
  MAINTENANCE
  MANAGEMENT
  OUT_OF_ORDER
  OTHER
}

/// Единственный источник правды для «единица недоступна» (DATA_MODEL v0.3).
/// Даты — DATE в timezone объекта, полуинтервал [date_from, date_to).
model InventoryBlock {
  id              String             @id @default(uuid()) @db.Uuid
  inventoryUnitId String             @map("inventory_unit_id") @db.Uuid
  dateFrom        DateTime           @map("date_from") @db.Date
  dateTo          DateTime           @map("date_to") @db.Date
  reason          String?
  type            InventoryBlockType
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  inventoryUnit InventoryUnit @relation(fields: [inventoryUnitId], references: [id])

  @@index([inventoryUnitId, dateFrom, dateTo])
  @@map("inventory_blocks")
}

// ───────────────────────── §5 Тарифы ─────────────────────────

/// Тарифный план. На объекте 6 (3 без продаж — Q-082: до ответа импортируются с active=false).
/// Питания нет ни у одного; сезонов в модели нет (DailyRate покрывает).
model RatePlan {
  id                  String              @id @default(uuid()) @db.Uuid
  propertyId          String              @map("property_id") @db.Uuid
  code                String
  name                String
  currency            String              @db.Char(3)
  mealPlan            String?             @map("meal_plan")
  active              Boolean             @default(true)
  /// Служебная заметка тарифа; не участвует в расчётах
  note                String?
  /// Штраф при отмене/незаезде (Q-103); умолчание — стоимость первых суток
  cancellationPenalty CancellationPenalty @default(FIRST_NIGHT) @map("cancellation_penalty")
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  property        Property                    @relation(fields: [propertyId], references: [id])
  types           RatePlanAccommodationType[]
  dailyRates      DailyRate[]
  restrictions    Restriction[]
  channelMappings ChannelMapping[]
  items           ReservationItem[]
  trackedSites    TrackedSite[]

  @@unique([propertyId, code])
  @@map("rate_plans")
}

/// Тариф действует на категорию. На объекте — декартово произведение (тарифы на все категории).
model RatePlanAccommodationType {
  ratePlanId          String @map("rate_plan_id") @db.Uuid
  accommodationTypeId String @map("accommodation_type_id") @db.Uuid

  ratePlan          RatePlan          @relation(fields: [ratePlanId], references: [id])
  accommodationType AccommodationType @relation(fields: [accommodationTypeId], references: [id])

  @@id([ratePlanId, accommodationTypeId])
  @@map("rate_plan_accommodation_types")
}

/// Цена за ночь на дату. occupancy — число гостей (1 или 2; отличается только у «Двухместной»).
model DailyRate {
  date                DateTime @db.Date
  accommodationTypeId String   @map("accommodation_type_id") @db.Uuid
  ratePlanId          String   @map("rate_plan_id") @db.Uuid
  occupancy           Int      @default(1)
  /// integer minor units (тиын), ADR-008
  price               BigInt
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  accommodationType AccommodationType @relation(fields: [accommodationTypeId], references: [id])
  ratePlan          RatePlan          @relation(fields: [ratePlanId], references: [id])

  @@id([date, accommodationTypeId, ratePlanId, occupancy])
  @@index([accommodationTypeId, date])
  @@map("daily_rates")
}

/// Ограничения продаж на дату. На объекте сейчас ни одного, механизм обязателен для OTA.
model Restriction {
  date                DateTime @db.Date
  accommodationTypeId String   @map("accommodation_type_id") @db.Uuid
  ratePlanId          String   @map("rate_plan_id") @db.Uuid
  minStay             Int?     @map("min_stay")
  maxStay             Int?     @map("max_stay")
  stopSell            Boolean  @default(false) @map("stop_sell")
  closedToArrival     Boolean  @default(false) @map("closed_to_arrival")
  closedToDeparture   Boolean  @default(false) @map("closed_to_departure")
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  accommodationType AccommodationType @relation(fields: [accommodationTypeId], references: [id])
  ratePlan          RatePlan          @relation(fields: [ratePlanId], references: [id])

  @@id([date, accommodationTypeId, ratePlanId])
  @@index([accommodationTypeId, date])
  @@map("restrictions")
}

// ───────────────────────── §10 Аудит ─────────────────────────

/// Обязательно логируется: даты, цена, room move, cancellation, payment, refund,
/// ручное изменение availability, изменение документа гостя (SECURITY.md §6). Без PII в логах.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  action     String
  before     Json?
  after      Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Чья запись (v1.13 ADR-103 + Phase 1 ADR-100 §17.2). Пишет код из контекста запроса (attachAuthor), добирает
  /// триггер audit_logs_organization (организация запроса, иначе — по сущности). NULL — платформа/система.
  organizationId String?       @map("organization_id") @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ───────────────────────── §7 Channel Manager ─────────────────────────

/// Соответствие наших сущностей объектам Channex и каналов (DATA_MODEL §7). Vendor ID живут только здесь
/// и в packages/integrations (ADR-004). Одна строка = одна пара (категория, тариф) у одного провайдера.
model ChannelMapping {
  id                       String   @id @default(uuid()) @db.Uuid
  propertyId               String   @map("property_id") @db.Uuid
  /// Провайдер: пока только `channex`
  provider                 String
  /// Канал (booking.com, agoda, …); null для сущностей уровня провайдера
  channel                  String?
  localAccommodationTypeId String?  @map("local_accommodation_type_id") @db.Uuid
  localRatePlanId          String?  @map("local_rate_plan_id") @db.Uuid
  providerPropertyId       String   @map("provider_property_id")
  providerRoomTypeId       String?  @map("provider_room_type_id")
  providerRatePlanId       String?  @map("provider_rate_plan_id")
  channelPropertyId        String?  @map("channel_property_id")
  channelRoomId            String?  @map("channel_room_id")
  channelRateId            String?  @map("channel_rate_id")
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  property          Property           @relation(fields: [propertyId], references: [id])
  accommodationType AccommodationType? @relation(fields: [localAccommodationTypeId], references: [id])
  ratePlan          RatePlan?          @relation(fields: [localRatePlanId], references: [id])

  @@unique([provider, providerRatePlanId])
  @@index([propertyId, provider])
  @@index([localAccommodationTypeId])
  @@index([localRatePlanId])
  @@map("channel_mappings")
}

// ───────────────────────── §8 Внешние события ─────────────────────────

enum ExternalEventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
}

/// Журнал входящих событий (webhook, revision feed). UNIQUE(provider, external_event_id) —
/// идемпотентность обязательна (ADR-007): сначала записано, потом обработано, повтор безопасен.
model ExternalEvent {
  id              String              @id @default(uuid()) @db.Uuid
  /// Чей это объект (Phase 1 изоляции, ADR-100 §17.2, DATA_MODEL v2.1): scope по объекту — событие канала
  /// принадлежит гостинице, не организации. NULL — принадлежность не выведена при backfill (отчёт 20260927000026).
  /// Таблица без RLS (DATA_MODEL §17.3): читает и служебный путь; чтения стойки фильтрует код (Phase 1).
  propertyId      String?             @map("property_id") @db.Uuid
  property        Property?           @relation(fields: [propertyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  provider        String
  externalEventId String              @map("external_event_id")
  type            String
  receivedAt      DateTime            @default(now()) @map("received_at") @db.Timestamptz(6)
  payloadHash     String              @map("payload_hash")
  payload         Json?
  status          ExternalEventStatus @default(RECEIVED)
  attemptCount    Int                 @default(0) @map("attempt_count")
  lastError       String?             @map("last_error")
  /// Каким путём дошло: webhook, опрос ленты или кнопка «Обработать заново». Без этого поля
  /// «бронь пришла сама» и «подобрал опрос через пять минут» в журнале неразличимы.
  receivedVia     ExternalEventVia    @default(PULL) @map("received_via")
  processedAt     DateTime?           @map("processed_at") @db.Timestamptz(6)

  @@unique([provider, externalEventId])
  @@index([propertyId])
  @@index([status, receivedAt])
  @@map("external_events")
}

enum ExternalEventVia {
  WEBHOOK
  PULL
  MANUAL
}

enum ChannelOutboxKind {
  AVAILABILITY
  RESTRICTIONS
}

enum ChannelOutboxStatus {
  PENDING
  SENT
  FAILED
}

/// Очередь исходящих изменений ARI (DATA_MODEL §7, ChannelOutbox). Не бизнес-данные.
model ChannelOutbox {
  id            String              @id @default(uuid()) @db.Uuid
  /// Чей это объект (Phase 1 изоляции, ADR-100 §17.2, DATA_MODEL v2.1). NULL — backfill не вывел однозначно.
  /// Таблица без RLS (DATA_MODEL §17.3): читает и служебный путь; чтения стойки фильтрует код (Phase 1).
  propertyId    String?             @map("property_id") @db.Uuid
  property      Property?           @relation(fields: [propertyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  provider      String
  kind          ChannelOutboxKind
  payload       Json
  status        ChannelOutboxStatus @default(PENDING)
  attempts      Int                 @default(0)
  nextAttemptAt DateTime            @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  taskId        String?             @map("task_id")
  lastError     String?             @map("last_error")
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  sentAt        DateTime?           @map("sent_at") @db.Timestamptz(6)

  @@index([propertyId])
  @@index([provider, status, nextAttemptAt])
  @@map("channel_outbox")
}

// ───────────────────────── §6 Folio (финансы) ─────────────────────────

/// Штраф при отмене и незаезде — политика тарифа (Q-103): «первые сутки» по умолчанию
enum CancellationPenalty {
  NONE
  FIRST_NIGHT
  FULL_STAY
}

enum FolioStatus {
  OPEN
  CLOSED
}

enum ChargeKind {
  ACCOMMODATION
  SERVICE
  PENALTY
  ADJUSTMENT
}

/// Способы оплаты WETOP; «Наличными через кассу» сведено в CASH (Q-083).
enum PaymentMethod {
  CASH
  CARD_TERMINAL
  BANK_TRANSFER_LEGAL
  EXTERNAL
  BANK_TRANSFER_PERSON
  CARD_GUARANTEE
  DEPOSIT
  HALYK
  KASPI
}

enum PaymentStatus {
  COMPLETED
  VOIDED
}

/// Счёт гостя — один на проживание (ADR-014). Создаётся вместе с проживанием.
model Folio {
  id                String      @id @default(uuid()) @db.Uuid
  reservationItemId String      @unique @map("reservation_item_id") @db.Uuid
  status            FolioStatus @default(OPEN)
  currency          String      @db.Char(3)
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  closedAt          DateTime?   @map("closed_at") @db.Timestamptz(6)

  reservationItem ReservationItem     @relation(fields: [reservationItemId], references: [id])
  charges         Charge[]
  allocations     PaymentAllocation[]
  refunds         Refund[]

  @@map("folios")
}

model Service {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @map("property_id") @db.Uuid
  code       String
  nameRu     String   @map("name_ru")
  nameKz     String?  @map("name_kz")
  /// integer minor units (тиын), ADR-008
  price      BigInt
  tax        Int?
  group      String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  property Property @relation(fields: [propertyId], references: [id])
  charges  Charge[]

  @@unique([propertyId, code])
  @@map("services")
}

/// Начисление на счёт. Сторно — voided_at, строка не удаляется.
model Charge {
  id          String     @id @default(uuid()) @db.Uuid
  folioId     String     @map("folio_id") @db.Uuid
  kind        ChargeKind
  serviceId   String?    @map("service_id") @db.Uuid
  description String
  quantity    Int        @default(1)
  /// integer minor units (тиын), ADR-008
  unitPrice   BigInt     @map("unit_price")
  /// integer minor units; ADJUSTMENT может быть отрицательным
  amount      BigInt
  serviceDate DateTime?  @map("service_date") @db.Date
  createdBy   String?    @map("created_by") @db.Uuid
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  voidedAt    DateTime?  @map("voided_at") @db.Timestamptz(6)

  folio   Folio    @relation(fields: [folioId], references: [id])
  service Service? @relation(fields: [serviceId], references: [id])

  @@index([folioId])
  @@map("charges")
}

/// Платёж. Распределяется по счетам через PaymentAllocation (Σ = amount).
model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  propertyId        String        @map("property_id") @db.Uuid
  method            PaymentMethod
  /// integer minor units (тиын), ADR-008
  amount            BigInt
  currency          String        @db.Char(3)
  status            PaymentStatus @default(COMPLETED)
  /// Ссылка банка/канала для внешних платежей
  externalReference String?       @map("external_reference")
  note              String?
  paidAt            DateTime      @default(now()) @map("paid_at") @db.Timestamptz(6)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  property    Property            @relation(fields: [propertyId], references: [id])
  allocations PaymentAllocation[]
  refunds     Refund[]

  @@unique([propertyId, externalReference])
  @@index([propertyId, paidAt])
  @@map("payments")
}

model PaymentAllocation {
  paymentId String @map("payment_id") @db.Uuid
  folioId   String @map("folio_id") @db.Uuid
  /// integer minor units (тиын), ADR-008
  amount    BigInt

  payment Payment @relation(fields: [paymentId], references: [id])
  folio   Folio   @relation(fields: [folioId], references: [id])

  @@id([paymentId, folioId])
  @@index([folioId])
  @@map("payment_allocations")
}

model Refund {
  id                String   @id @default(uuid()) @db.Uuid
  paymentId         String   @map("payment_id") @db.Uuid
  folioId           String   @map("folio_id") @db.Uuid
  /// integer minor units (тиын), ADR-008
  amount            BigInt
  reason            String?
  externalReference String?  @map("external_reference")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  payment Payment @relation(fields: [paymentId], references: [id])
  folio   Folio   @relation(fields: [folioId], references: [id])

  @@index([folioId])
  @@map("refunds")
}

// ───────────────────────── §11 Аналитика сайта ─────────────────────────
// Срез 8 (план plans/slice-8-web-analytics.md, принят владельцем 12.09.2026). Персональных данных нет по
// построению: IP и полный User-Agent не сохраняются, visitor_key — случайное число из браузера (ADR-018).

enum TrackedSiteStatus {
  ACTIVE
  PAUSED
}

enum WebSourceKind {
  DIRECT
  SEARCH
  SOCIAL
  PAID
  EMAIL
  REFERRAL
}

enum WebDevice {
  DESKTOP
  MOBILE
  TABLET
}

/// Сайт объекта со счётчиком. Ключ стоит в HTML сайта — не секрет; домены ограничивают приёмник.
model TrackedSite {
  id                String            @id @default(uuid()) @db.Uuid
  propertyId        String            @map("property_id") @db.Uuid
  name              String
  /// Домены сайта; Origin/Referer приёмника должны совпадать (сам домен или поддомен)
  hosts             String[]
  /// pms_ + 12 hex — ключ в атрибуте data-site
  publicKey         String            @unique @map("public_key")
  status            TrackedSiteStatus @default(ACTIVE)
  /// Виджет бронирования на сайте (срез 9): выключен, пока владелец не включит на карточке сайта
  bookingEnabled    Boolean           @default(false) @map("booking_enabled")
  /// Тариф, по которому виджет считает цену и создаёт бронь; null — бронирование не настроено
  bookingRatePlanId String?           @map("booking_rate_plan_id") @db.Uuid
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  property        Property     @relation(fields: [propertyId], references: [id])
  bookingRatePlan RatePlan?    @relation(fields: [bookingRatePlanId], references: [id])
  sessions        WebSession[]

  @@index([propertyId])
  @@map("tracked_sites")
}

/// Сессия посетителя (GA4: рвётся после 30 минут бездействия). Источник и устройство — на первом просмотре.
model WebSession {
  id              String        @id @default(uuid()) @db.Uuid
  siteId          String        @map("site_id") @db.Uuid
  visitorKey      String        @map("visitor_key")
  sessionKey      String        @map("session_key")
  startedAt       DateTime      @map("started_at") @db.Timestamptz(6)
  lastSeenAt      DateTime      @map("last_seen_at") @db.Timestamptz(6)
  pageviews       Int           @default(0)
  /// last_seen_at − started_at, обновляется приёмником
  durationSeconds Int           @default(0) @map("duration_seconds")
  landingPath     String?       @map("landing_path")
  referrerHost    String?       @map("referrer_host")
  sourceKind      WebSourceKind @default(DIRECT) @map("source_kind")
  source          String?
  medium          String?
  campaign        String?
  content         String?
  term            String?
  device          WebDevice     @default(DESKTOP)
  browser         String?
  os              String?
  language        String?
  /// Бронь, сделанная виджетом в этой сессии (срез 9): конверсия по источникам
  reservationId   String?       @map("reservation_id") @db.Uuid

  site         TrackedSite   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  reservation  Reservation?  @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  pageviewRows WebPageview[]
  events       WebEvent[]

  @@unique([siteId, sessionKey])
  @@index([siteId, startedAt])
  @@map("web_sessions")
}

model WebPageview {
  id        String   @id @default(uuid()) @db.Uuid
  sessionId String   @map("session_id") @db.Uuid
  at        DateTime @db.Timestamptz(6)
  path      String
  title     String?

  session WebSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([at])
  @@map("web_pageviews")
}

/// Событие с сайта: search (даты заезда → календарь спроса), booking_step, phone_click, whatsapp_click, custom.
/// props — только ключи из allow-list домена (arrival, departure, adults, children, category, rate, step).
model WebEvent {
  id        String   @id @default(uuid()) @db.Uuid
  sessionId String   @map("session_id") @db.Uuid
  at        DateTime @db.Timestamptz(6)
  name      String
  props     Json?

  session WebSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([at])
  @@map("web_events")
}

// ───────────────────────── §12 Неисправности системы ─────────────────────────
// Одно место для всего, что сломалось (ADR-028, срез 11). Техническая таблица, бизнес-данных не хранит.

enum IncidentClass {
  A
  B
  C
}

enum IncidentSeverity {
  CRITICAL
  WARNING
}

enum IncidentStatus {
  OPEN
  FIXING
  ESCALATED
  ACKNOWLEDGED
  RESOLVED
}

enum IncidentResolvedBy {
  GUARD
  AGENT
  STAFF
}

/// Одна строка на неисправность: пока не закрыта, повтор с тем же fingerprint только увеличивает occurrences
/// (частичный уникальный индекс WHERE status <> 'RESOLVED' — в миграции, Prisma такой не описывает).
/// В subject_id и details нет ФИО, телефонов, тел запросов и секретов (DATA_MODEL §12).
model SystemIncident {
  id             String              @id @default(uuid()) @db.Uuid
  kind           String
  class          IncidentClass
  severity       IncidentSeverity
  fingerprint    String
  status         IncidentStatus      @default(OPEN)
  title          String
  subjectType    String?             @map("subject_type")
  subjectId      String?             @map("subject_id")
  details        Json?
  occurrences    Int                 @default(1)
  firstSeenAt    DateTime            @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt     DateTime            @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  fixAttempts    Int                 @default(0) @map("fix_attempts")
  lastFixAt      DateTime?           @map("last_fix_at") @db.Timestamptz(6)
  lastFixResult  String?             @map("last_fix_result")
  alertedAt      DateTime?           @map("alerted_at") @db.Timestamptz(6)
  acknowledgedAt DateTime?           @map("acknowledged_at") @db.Timestamptz(6)
  resolvedAt     DateTime?           @map("resolved_at") @db.Timestamptz(6)
  resolvedBy     IncidentResolvedBy? @map("resolved_by")

  @@index([status, severity])
  @@index([kind, firstSeenAt])
  @@index([resolvedAt])
  @@map("system_incidents")
}

enum OrganizationStatus {
  TRIAL
  ACTIVE
  READ_ONLY
  SUSPENDED
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

/// Арендатор: одна организация — один клиент платформы (DATA_MODEL §13, ADR-046).
/// Разделения данных объекта по организациям в срезе 13 нет: пробный период пускает в демо-объект.
model Organization {
  id          String             @id @default(uuid()) @db.Uuid
  name        String             @db.VarChar(200)
  status      OrganizationStatus @default(TRIAL)
  /// Отчётная валюта партнёра (Platform P1, ADR-104, DATA_MODEL §18.4): в неё сводится аналитика филиалов
  /// с разными операционными валютами. Backfill — из фактической валюты Property, где она однозначна.
  reportingCurrency String       @default("KZT") @map("reporting_currency") @db.VarChar(3)
  trialEndsAt DateTime?          @map("trial_ends_at") @db.Timestamptz(6)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  memberships Membership[]
  sessions    Session[]
  invites     Invite[]
  properties  Property[]
  businesses  Business[]
  userErrors  UserError[]
  sellerProfile SellerProfile?
  agents SellerAgent[]
  wizardDrafts WizardDraft[]
  extensions  OrganizationExtension[]
  guests      Guest[]
  auditLogs   AuditLog[]

  @@map("organizations")
}

/// Человек. Почта в нижнем регистре — за этим следит CHECK в миграции, Prisma такого не описывает.
/// Паролей нет намеренно (ADR-046): вход по одноразовому коду на почту.
model User {
  id          String     @id @default(uuid()) @db.Uuid
  email       String     @unique @db.VarChar(320)
  name        String?    @db.VarChar(200)
  status      UserStatus @default(ACTIVE)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  lastLoginAt DateTime?  @map("last_login_at") @db.Timestamptz(6)
  /// Когда человек подтвердил почту по ссылке из письма (решение владельца 20.09.2026).
  /// NULL — не подтвердил: вход закрыт. У заведённых до 20.09.2026 проставлено миграцией.
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(6)

  /// Вход по паролю (§13.8, ADR-049, миграция 20260915000014). Пустая строка — пароль не задан:
  /// такой человек по паролю не войдёт. scrypt из node:crypto, формат «scrypt$N$r$p$соль$хеш».
  passwordHash   String    @default("") @map("password_hash")
  /// Промахи подряд; после пяти вход заперт до locked_until (домен accounts)
  failedAttempts Int       @default(0) @map("failed_attempts")
  lockedUntil    DateTime? @map("locked_until") @db.Timestamptz(6)

  sellerAgents SellerAgent[]
  wizardDrafts WizardDraft[]
  memberships    Membership[]
  sessions       Session[]
  invitesIssued  Invite[]        @relation("InviteCreatedBy")
  passwordResets PasswordReset[]
  emailVerifications EmailVerification[]
  auditLogs      AuditLog[]
  userErrors     UserError[]
  sellerProfileEdits SellerProfile[]
  platformAdmin  PlatformAdmin?
  extensionEdits OrganizationExtension[]

  @@map("users")
}

/// Одноразовая ссылка на установку пароля: приглашение сотрудника и сброс по его просьбе (§13.9, ADR-049).
/// В базе только хеш токена — утечка базы не даёт задать пароль.
model PasswordReset {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("password_resets")
}

/// Ссылка подтверждения почты. В базе только хеш ссылки, срок 72 часа, ссылка одноразовая.
/// Новая ссылка гасит прежние: одна живая ссылка на человека.
model EmailVerification {
  /// id выдаёт база, у ключа на users нет ON UPDATE — как в миграции 20260920000015
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("email_verifications")
}

/// Роль в организации (DATA_MODEL §16.1, ADR-083). MANAGER — управляющий (v1.14, ADR-107); STAFF на экране —
/// «администратор». Роль — готовый набор прав (§16.5, `packages/domain/src/accounts/permissions.ts`).
enum MembershipRole {
  OWNER
  MANAGER
  STAFF
}

/// Человек в организации. Роль — §16.1: у самого раннего участника организации `OWNER` (миграция 20260925000020).
model Membership {
  userId         String         @map("user_id") @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  role           MembershipRole @default(STAFF)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  user         User         @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@id([userId, organizationId])
  @@index([organizationId])
  @@map("memberships")
}


/// Активная сессия. В куке подписанное значение, не сам id. «Выйти везде» проставляет revoked_at всем строкам.
model Session {
  id             String    @id @default(uuid()) @db.Uuid
  tokenHash      String    @unique @map("token_hash") @db.VarChar(64)
  userId         String    @map("user_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  issuedAt       DateTime  @default(now()) @map("issued_at") @db.Timestamptz(6)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  userAgent      String?   @map("user_agent") @db.VarChar(400)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)
  /// Когда сессию видели последний раз: заполняется при проверке токена (§13.9)
  lastSeenAt     DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)

  user         User         @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Приглашение в организацию по почте. В базе только хеш ссылки, срок 7 суток.
model Invite {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  email          String    @db.VarChar(320)
  /// С какой ролью человек войдёт (v1.14, ADR-107): MANAGER или STAFF; CHECK invites_role_not_owner — не OWNER
  role           MembershipRole @default(STAFF)
  tokenHash      String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  acceptedAt     DateTime? @map("accepted_at") @db.Timestamptz(6)
  createdBy      String    @map("created_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  creator      User         @relation("InviteCreatedBy", fields: [createdBy], references: [id])

  @@index([organizationId])
  @@map("invites")
}

// ───────────────────────── §14 Ошибки, которые видит человек ─────────────────────────

/// Ответ API с ошибкой (4xx, 5xx), который получил вошедший человек (DATA_MODEL §14, ТЗ ред. 1 П3, ADR-079).
/// Читает ИИ-помощник по узкому ключу. Время ставит приложение — у колонки нет DEFAULT; CHECK status 400…599 — в миграции.
/// Тела запроса, значений из адреса и данных гостей нет по построению: маршрут шаблоном, текст ответа с маской.
model UserError {
  id             String   @id @default(uuid()) @db.Uuid
  at             DateTime @db.Timestamptz(6)
  userId         String   @map("user_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  method         String   @db.VarChar(10)
  route          String   @db.VarChar(200)
  status         Int      @db.SmallInt
  message        String   @db.VarChar(500)
  requestId      String   @map("request_id") @db.Uuid

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId, organizationId, at])
  @@index([at])
  @@map("user_errors")
}

// ───────────────────────── §15 Профиль ИИ-продавца ─────────────────────────

enum SellerAddressForm {
  FORMAL
  INFORMAL
}

/// Эмодзи в ответах продавца — значения модели бота `SellerProfile` (Б6): нет, изредка, только в приветствии
enum SellerEmoji {
  NEVER
  MODERATE
  GREETING_ONLY
}

/// Длина реплик — значения модели бота: коротко или развёрнуто
enum SellerReplyLength {
  SHORT
  DETAILED
}

/// Профиль ИИ-продавца: одна строка на организацию (DATA_MODEL §15, ТЗ ред. 1 П5, ADR-079, ADR-081). Поля экрана
/// «Настройки», не текст промпта: ядро правил держит бот. Перечисления и пределы — модели бота `SellerProfile`. Поля
/// доставки (П8) ведёт платформа. CHECK на число языков и строк в списках — в миграции.
model SellerProfile {
  organizationId   String            @id @map("organization_id") @db.Uuid
  botName          String?           @map("bot_name") @db.VarChar(40)
  addressForm      SellerAddressForm @map("address_form")
  emoji            SellerEmoji       @default(NEVER)
  replyLength      SellerReplyLength @map("reply_length")
  languages        String[]
  greeting         String            @default("") @db.VarChar(300)
  includedInPrice  String            @default("") @map("included_in_price") @db.VarChar(1000)
  extraCharges     String            @default("") @map("extra_charges") @db.VarChar(1000)
  houseRules       String            @default("") @map("house_rules") @db.VarChar(2000)
  /// Запреты по одному в строке: до 30 (CHECK в миграции), строка до 300 — проверяет домен
  prohibitions     String[]          @default([])
  /// Когда звать человека, по одному в строке: до 30 (CHECK), строка до 300
  callHumanWhen    String[]          @default([]) @map("call_human_when")
  /// [{ question, answer }], до 50 — проверяет домен (`parseSellerProfile`)
  faq              Json              @default("[]")
  /// Инструкция продавцу одним текстом (ADR-097); есть — продавцу уходит она, а не поля выше
  promptText       String?           @map("prompt_text") @db.VarChar(20000)
  updatedAt        DateTime          @map("updated_at") @db.Timestamptz(6)
  updatedBy        String?           @map("updated_by") @db.Uuid
  /// Агент, которому принадлежит профиль (DATA_MODEL §20.2). Пусто при вставке — триггер ставит `organization_id` и заводит
  /// перенесённого агента (id = organization_id). Уникален; FK на `seller_agents`. NOT NULL и смена ключа — в «сужении» (§20.7 п. 6)
  agentId          String?           @unique @map("agent_id") @db.Uuid
  agent            SellerAgent?      @relation(fields: [agentId], references: [id], onDelete: Restrict)
  /// Версия профиля (`updated_at`), которую продавец принял; NULL — не принимал
  profileAppliedAt DateTime?         @map("profile_applied_at") @db.Timestamptz(6)
  /// SHA-256 последних доставленных фактов объекта
  factsHash        String?           @map("facts_hash") @db.Char(64)
  factsAppliedAt   DateTime?         @map("facts_applied_at") @db.Timestamptz(6)
  /// Последний отказ продавца, маскированный; NULL — отказов нет
  lastError        String?           @map("last_error") @db.VarChar(500)
  lastErrorAt      DateTime?         @map("last_error_at") @db.Timestamptz(6)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  editor       User?        @relation(fields: [updatedBy], references: [id], onDelete: SetNull)

  @@map("seller_profiles")
}

/// Главный администратор платформы (DATA_MODEL §16.2, ADR-083). Ставит и снимает только команда на сервере
/// (`npm run accounts -- platform-admin`): маршрута API, который пишет сюда, нет. Действует, пока `revoked_at` пуст.
/// Отдельная таблица, а не поле в `users`: правка профиля человека не может задеть отметку.
model PlatformAdmin {
  userId    String    @id @map("user_id") @db.Uuid
  grantedAt DateTime  @default(now()) @map("granted_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  note      String?   @db.VarChar(200)

  user User @relation(fields: [userId], references: [id])

  @@map("platform_admins")
}

/// Платное расширение организации (DATA_MODEL §16.3, ADR-083)
enum ExtensionKind {
  AI_SELLER
}

/// `TRIAL` — пробный, `ACTIVE` — оплачен, `OFF` — выключен
enum ExtensionStatus {
  TRIAL
  ACTIVE
  OFF
}

/// Расширение действует, если статус `TRIAL` или `ACTIVE` и срок не вышел (`active_until` пуст — бессрочно). Меняет
/// только главный администратор; строки не удаляются, выключение — `OFF`. Денег здесь нет (Q-141, Q-143).
model OrganizationExtension {
  organizationId String          @map("organization_id") @db.Uuid
  extension      ExtensionKind
  status         ExtensionStatus
  /// NULL — бессрочно; у пробного обязателен (CHECK в миграции)
  activeUntil    DateTime?       @map("active_until") @db.Timestamptz(6)
  /// Номер счёта и т. п.; без персональных данных
  note           String?         @db.VarChar(300)
  updatedAt      DateTime        @map("updated_at") @db.Timestamptz(6)
  updatedBy      String?         @map("updated_by") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  editor       User?        @relation(fields: [updatedBy], references: [id], onDelete: SetNull)

  @@id([organizationId, extension])
  @@map("organization_extensions")
}


/// Guest onboarding model approved 26.09.2026; production migration requires separate cutover.
model SellerAgent {
  createdBy String @map("created_by") @db.Uuid
  creator User @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name String @db.VarChar(200)
  scenario String @default("sales") @db.VarChar(16)
  /// Хранимых состояний четыре: draft / active / paused / archived (DATA_MODEL §20.3); active и paused — только с филиалом (CHECK)
  lifecycle String @default("draft") @db.VarChar(16)
  /// Филиал агента (DATA_MODEL §20.2). Частичный уникальный индекс `seller_agents_one_seller_per_location` — не более
  /// одного неархивного AI-продавца (scenario = 'sales') на филиал; триггер сверяет организацию филиала с организацией агента
  locationId String? @map("location_id") @db.Uuid
  location Location? @relation(fields: [locationId], references: [id], onDelete: Restrict)
  profile Json @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  draft WizardDraft?
  /// Рабочий профиль продавца этого агента (`seller_profiles`, DATA_MODEL §20.2); у агентов мастера пусто
  workingProfile SellerProfile?
  @@index([organizationId])
  @@index([locationId])
  @@map("seller_agents")
}

model WizardSession {
  id String @id @default(uuid()) @db.Uuid
  tokenHash String @unique @map("token_hash") @db.VarChar(64)
  ref String @default("") @db.VarChar(200)
  lastStep String @default("intro") @map("last_step") @db.VarChar(24)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  draft WizardDraft?
  survey WizardSurvey?
  events WizardEvent[]
  @@index([expiresAt])
  @@map("wizard_sessions")
}

model WizardDraft {
  claimedBy String? @map("claimed_by") @db.Uuid
  claimant User? @relation(fields: [claimedBy], references: [id], onDelete: Restrict)
  organizationId String? @map("organization_id") @db.Uuid
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  id String @id @default(uuid()) @db.Uuid
  guestSessionId String @unique @map("guest_session_id") @db.Uuid
  session WizardSession @relation(fields: [guestSessionId], references: [id], onDelete: Cascade)
  businessName String @default("") @map("business_name") @db.VarChar(200)
  niche String @default("") @db.VarChar(200)
  description String @default("") @db.VarChar(10000)
  config Json @default("{}")
  sources Json @default("[]")
  revision Int @default(0)
  generatedRevision Int? @map("generated_revision")
  generatedPrompt String? @map("generated_prompt")
  generatedKnowledge Json @default("[]") @map("generated_knowledge")
  testMessagesUsed Int @default(0) @map("test_messages_used")
  agentId String? @unique @map("agent_id") @db.Uuid
  agent SellerAgent? @relation(fields: [agentId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  jobs WizardJob[]
  messages WizardMessage[]
  @@map("wizard_drafts")
}

model WizardJob {
  id String @id @default(uuid()) @db.Uuid
  draftId String @map("draft_id") @db.Uuid
  draft WizardDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  kind String @db.VarChar(16)
  revision Int
  state String @default("queued") @db.VarChar(16)
  attempt Int @default(0)
  retryAt DateTime? @map("retry_at") @db.Timestamptz(6)
  maskedError String? @map("masked_error") @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  @@unique([draftId, kind, revision])
  @@map("wizard_jobs")
}

model WizardMessage {
  id String @id @default(uuid()) @db.Uuid
  draftId String @map("draft_id") @db.Uuid
  draft WizardDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  requestId String @map("request_id") @db.VarChar(64)
  role String @db.VarChar(16)
  text String @db.VarChar(16000)
  state String @db.VarChar(16)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  @@unique([draftId, requestId, role])
  @@map("wizard_messages")
}

model WizardSurvey {
  guestSessionId String @id @map("guest_session_id") @db.Uuid
  session WizardSession @relation(fields: [guestSessionId], references: [id], onDelete: Cascade)
  goal String @default("") @db.VarChar(1000)
  teamSize String @default("") @map("team_size") @db.VarChar(32)
  leadsPerDay String @default("") @map("leads_per_day") @db.VarChar(32)
  source String @default("") @db.VarChar(200)
  industry String @default("") @db.VarChar(200)
  @@map("wizard_surveys")
}

model WizardEvent {
  id String @id @default(uuid()) @db.Uuid
  guestSessionId String @map("guest_session_id") @db.Uuid
  session WizardSession @relation(fields: [guestSessionId], references: [id], onDelete: Cascade)
  eventType String @map("event_type") @db.VarChar(60)
  payload Json @default("{}")
  deduplicationKey String @unique @map("deduplication_key") @db.VarChar(200)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  @@index([guestSessionId, createdAt])
  @@map("wizard_events")
}
