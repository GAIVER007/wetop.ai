// Prisma schema — ТОЛЬКО утверждённые разделы DATA_MODEL.md v1.0 (07.09.2026):
//   §1 Объект и физическая структура, §2 Бронирование, §3 Гости, §4 Housekeeping и блокировки,
//   §5 Тарифы, §6 Folio, §7 Channel Manager, §8 Внешние события, §10 Аудит. Плюс SQL вне Prisma: exclusion constraint на allocations (миграция 20260909000003).
// Раздел 6 (Folio) утверждён 09.09.2026 (ADR-014): счёт на проживание, миграция 20260909000006.
// Любое изменение сущности/поля/связи — сначала правка DATA_MODEL.md (AGENTS.md §2).
//
// Соглашения: имена таблиц и колонок — snake_case через @map; id — uuid;
// события — timestamptz (UTC); stay dates — DATE в timezone объекта (AGENTS.md §13).
// Внешние ID действующих каналов хранятся как ссылки, не как собственные ключи (ADR-003, ADR-118).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // url задаётся в prisma.config.ts из DIRECT_URL / DATABASE_URL (значение — только в .env)
}

// ───────────────────────── §1 Объект и физическая структура ─────────────────────────

/// Объект размещения. В MVP одна запись (ADR-001), но все запросы фильтруются по property_id.
/// Вертикаль направления бизнеса (Platform P1, ADR-104, DATA_MODEL §18.1): canonical vertical живёт
/// ТОЛЬКО здесь — не на организации и не на филиале (Q-199, вариант Б).
enum BusinessVertical {
  HOSPITALITY
  BEAUTY
  FOOD_SERVICE
}

/// Удаления строк нет, как во всём §13 — только архив.
enum BusinessStatus {
  ACTIVE
  ARCHIVED
}

enum LocationStatus {
  ACTIVE
  ARCHIVED
}

/// Направление/бренд партнёра (Platform P1, ADR-104, DATA_MODEL §18.1): «Luxx Hotels», «Alma Beauty».
/// У организации N бизнесов; вертикаль — здесь. Тёзки внутри организации допустимы (§18.1).
model Business {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  name           String           @db.VarChar(200)
  vertical       BusinessVertical
  status         BusinessStatus   @default(ACTIVE)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization   Organization       @relation(fields: [organizationId], references: [id])
  locations      Location[]
  customers      CustomerBusiness[]
  employees      Employee[]
  beautyServices BeautyService[]

  @@index([organizationId])
  @@map("businesses")
}

/// Филиал бизнеса (Platform P1, ADR-104, DATA_MODEL §18.2): «Luxx Aparts», «Marina». Принадлежит одному
/// Business; БЕЗ organization_id (выводится через business_id — §18.3) и БЕЗ vertical (только у Business).
/// Правило дат AGENTS.md §13 отсчитывается от timezone филиала.
model Location {
  id                   String         @id @default(uuid()) @db.Uuid
  businessId           String         @map("business_id") @db.Uuid
  name                 String         @db.VarChar(200)
  address              String?        @db.VarChar(500)
  phone                String?
  email                String?
  /// IANA, «Asia/Almaty»
  timezone             String         @db.VarChar(50)
  /// операционная валюта филиала (KZT, AED, …)
  currency             String         @db.VarChar(3)
  status               LocationStatus @default(ACTIVE)
  /// Канонический сайт брони филиала (Q-275, MKT7): только его берёт ИИ-продавец; сайт только объекта этого филиала
  /// (триггер location_booking_site_guard); NULL: котировки нет, запасного «первого сайта» нет
  bookingTrackedSiteId String?        @map("booking_tracked_site_id") @db.Uuid
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  bookingTrackedSite     TrackedSite?            @relation("LocationBookingSite", fields: [bookingTrackedSiteId], references: [id], onDelete: SetNull)
  diningAreas            DiningArea[]
  servicePeriods         ServicePeriod[]
  restaurantReservations RestaurantReservation[]
  onboardingProgress     OnboardingProgress?
  business               Business                @relation(fields: [businessId], references: [id])
  property               Property?
  sellerAgents           SellerAgent[]
  employees              EmployeeLocation[]
  services               LocationService[]
  workingHours           WorkingHours[]
  appointments           Appointment[]
  /// MKT9.2: один филиал, один сайт навсегда (полный UNIQUE location_id, архив не освобождает филиал)
  marketingSite          MarketingSite?
  siteAssets             SiteAsset[]
  /// MKT9.2: лицензия конструктора сайта филиала; выдаёт только главный администратор платформы
  siteBuilderEntitlement SiteBuilderEntitlement?

  @@index([businessId])
  @@index([bookingTrackedSiteId])
  @@map("locations")
}

model Property {
  id                  String   @id @default(uuid()) @db.Uuid
  /// Чей это объект (ADR-061). Обязателен с v1.13 (ADR-103): по нему режет Row Level Security (§17).
  organizationId      String   @map("organization_id") @db.Uuid
  name                String
  legalName           String?  @map("legal_name")
  bin                 String?
  address             String?
  /// Контакты объекта для печатных форм (v1.7, ADR-082): до них телефон и почта были зашиты в код
  /// печати и напечатались бы в договоре любой организации. Пустое — в формах прочерк.
  phone               String?
  email               String?
  /// ISO 3166-1 alpha-2 for Channex property creation. NULL until the owner supplies it.
  countryCode         String?  @map("country_code") @db.VarChar(2)
  /// City sent to Channex; not inferred from the free-form address.
  city                String?  @db.VarChar(100)
  /// One of the Channex hotels-collection property_type values.
  channexPropertyType String?  @map("channex_property_type") @db.VarChar(40)
  /// IANA timezone объекта, например Asia/Almaty
  timezone            String
  /// ISO 4217, на объекте KZT
  currency            String   @db.Char(3)
  /// Локальное время заезда "HH:mm", на объекте 14:00
  checkInTime         String   @map("check_in_time")
  /// Локальное время выезда "HH:mm", на объекте 12:00
  checkOutTime        String   @map("check_out_time")
  /// Platform P1 (ADR-104, DATA_MODEL §18.4, v2.6): родитель объекта — филиал (1:1), NOT NULL с миграции
  /// 20260928000032; новый объект — через createPropertyInChain. organization_id остаётся, пока замок
  /// ADR-061 не переведён на цепочку Location → Business, и совпадает с организацией Business.
  locationId          String   @unique @map("location_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Ключ и индекс — как их строит миграция 20260920000016: ON DELETE и ON UPDATE — NO ACTION.
  /// Организацию, за которой числится объект, удалить нельзя: объект не становится ничьим молча.
  organization        Organization          @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// Location удалить, пока на ней объект, нельзя (RESTRICT): объект не остаётся без точки молча.
  location            Location              @relation(fields: [locationId], references: [id], onDelete: Restrict)
  buildings           Building[]
  accommodationTypes  AccommodationType[]
  reservations        Reservation[]
  ratePlans           RatePlan[]
  promoCodes          PromoCode[]
  channelMappings     ChannelMapping[]
  payments            Payment[]
  cashCategories      CashCategory[]
  cashOperations      CashOperation[]
  cashReconciliations CashReconciliation[]
  barCategories       BarCategory[]
  barProducts         BarProduct[]
  barSuppliers        BarSupplier[]
  barReceipts         BarReceipt[]
  barStockLots        BarStockLot[]
  barStockMovements   BarStockMovement[]
  barSales            BarSale[]
  deskTasks           DeskTask[]
  paymentRequests     PaymentRequest[]
  fiscalReceipts      FiscalReceipt[]
  competitors         Competitor[]
  competitorOccupancy CompetitorOccupancy[]
  services            Service[]
  trackedSites        TrackedSite[]
  inventoryUnits      InventoryUnit[]
  externalEvents      ExternalEvent[]
  channelOutbox       ChannelOutbox[]

  sellerBookingIntents SellerBookingIntent[]

  @@index([organizationId])
  @@map("properties")
}

model Building {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @map("property_id") @db.Uuid
  name       String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  property Property @relation(fields: [propertyId], references: [id])
  floors   Floor[]

  @@unique([propertyId, name])
  @@map("buildings")
}

model Floor {
  id         String   @id @default(uuid()) @db.Uuid
  buildingId String   @map("building_id") @db.Uuid
  name       String
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  building      Building       @relation(fields: [buildingId], references: [id])
  physicalRooms PhysicalRoom[]

  @@unique([buildingId, name])
  @@map("floors")
}

/// Продаваемая категория. Гендерное деление dorm — отдельные категории, не атрибут (DATA_MODEL §1).
enum AccommodationKind {
  PRIVATE_ROOM
  DORM_BED
  APARTMENT
}

model AccommodationType {
  id               String            @id @default(uuid()) @db.Uuid
  propertyId       String            @map("property_id") @db.Uuid
  code             String
  name             String
  kind             AccommodationKind
  capacityAdults   Int               @map("capacity_adults")
  /// На объекте у всех 0: детское размещение выключено
  capacityChildren Int               @default(0) @map("capacity_children")
  active           Boolean           @default(true)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  property        Property                    @relation(fields: [propertyId], references: [id])
  units           InventoryUnit[]
  items           ReservationItem[]
  ratePlanLinks   RatePlanAccommodationType[]
  dailyRates      DailyRate[]
  restrictions    Restriction[]
  channelMappings ChannelMapping[]

  sellerBookingIntents SellerBookingIntent[]

  @@unique([propertyId, code])
  @@map("accommodation_types")
}

/// Физическая комната. По ADR-013 при импорте заполняется 1:1 из единицы продажи (Q-095 отложен).
/// Бизнес-логика MVP на неё не опирается — только на InventoryUnit.
model PhysicalRoom {
  id         String   @id @default(uuid()) @db.Uuid
  floorId    String   @map("floor_id") @db.Uuid
  roomNumber String   @map("room_number")
  name       String?
  capacity   Int
  isDorm     Boolean  @default(false) @map("is_dorm")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  floor Floor           @relation(fields: [floorId], references: [id])
  units InventoryUnit[]

  @@unique([floorId, roomNumber])
  @@map("physical_rooms")
}

enum InventoryUnitKind {
  ROOM
  BED
}

/// Рабочий статус уборки. Ремонт/вывод из продажи — InventoryBlock.
enum HousekeepingStatus {
  DIRTY
  CLEAN
  INSPECTED
}

/// Единица продажи = ячейка (ADR-013). На объекте 88 = 16 ROOM + 72 BED.
/// Ничего не выводится из номера единицы — только явные связи (DATA_MODEL принцип 7).
model InventoryUnit {
  id                  String             @id @default(uuid()) @db.Uuid
  /// Объект места (v1.12, ADR-099): дублирует объект категории, чтобы код был уникален внутри объекта
  propertyId          String             @map("property_id") @db.Uuid
  physicalRoomId      String             @map("physical_room_id") @db.Uuid
  accommodationTypeId String             @map("accommodation_type_id") @db.Uuid
  kind                InventoryUnitKind
  /// Код места в PMS; уникален внутри объекта (v1.12) — искать только в паре с объектом
  code                String
  housekeepingStatus  HousekeepingStatus @default(DIRTY) @map("housekeeping_status")
  active              Boolean            @default(true)
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  property           Property            @relation(fields: [propertyId], references: [id])
  physicalRoom       PhysicalRoom        @relation(fields: [physicalRoomId], references: [id])
  accommodationType  AccommodationType   @relation(fields: [accommodationTypeId], references: [id])
  blocks             InventoryBlock[]
  housekeepingEvents HousekeepingEvent[]
  allocations        Allocation[]

  @@unique([propertyId, code])
  @@index([accommodationTypeId])
  @@index([physicalRoomId])
  @@map("inventory_units")
}

// ───────────────────────── §2 Бронирование ─────────────────────────

/// Источник брони. Обязателен без значения по умолчанию (Q-089 — до ответа принято самое строгое).
enum ReservationSource {
  DESK
  PHONE
  WHATSAPP
  WALK_IN
  INSTAGRAM
  OTA
  WEBSITE
}

enum ReservationStatus {
  TENTATIVE
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}

/// Шапка брони (коммерческая бронь). Статус — производный от проживаний (v0.3), хранится для выборок.
/// `confirmationNumber` — бизнес-ключ брони внутри объекта (ADR-003, ADR-007).
model Reservation {
  creationKey         String?           @map("creation_key") @db.Uuid
  creationFingerprint String?           @map("creation_fingerprint") @db.VarChar(64)
  id                  String            @id @default(uuid()) @db.Uuid
  propertyId          String            @map("property_id") @db.Uuid
  confirmationNumber  String            @map("confirmation_number")
  source              ReservationSource
  /// Канал OTA/сайт как текст источника (например Booking.com); null для стойки
  channel             String?
  /// Номер брони на стороне канала (OTA), если известен
  externalId          String?           @map("external_id")
  status              ReservationStatus
  bookedAt            DateTime?         @map("booked_at") @db.Timestamptz(6)
  arrivalDate         DateTime          @map("arrival_date") @db.Date
  departureDate       DateTime          @map("departure_date") @db.Date
  adults              Int
  children            Int               @default(0)
  currency            String            @db.Char(3)
  /// integer minor units (тиын), ADR-008
  totalAmount         BigInt            @map("total_amount")
  primaryGuestId      String?           @map("primary_guest_id") @db.Uuid
  /// Заметки — главный канал передачи смены (FINDINGS §2 #8)
  notes               String?
  /// Промокод, применённый к брони (DATA_MODEL §20); число использований — число броней с этой ссылкой
  promoCodeId         String?           @map("promo_code_id") @db.Uuid
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  property     Property          @relation(fields: [propertyId], references: [id])
  promoCode    PromoCode?        @relation(fields: [promoCodeId], references: [id], onDelete: Restrict)
  primaryGuest Guest?            @relation("primaryGuest", fields: [primaryGuestId], references: [id])
  items        ReservationItem[]
  deskTasks    DeskTask[]
  webSessions  WebSession[]

  sellerBookingIntent SellerBookingIntent?

  @@unique([propertyId, creationKey])
  @@unique([propertyId, confirmationNumber])
  /// дубль OTA-брони отвергает база, NULL ручных броней различны (ТЗ аудита 25.09, С-4; v1.10)
  @@unique([propertyId, externalId])
  @@index([propertyId, arrivalDate])
  @@index([propertyId, departureDate])
  @@index([status])
  @@index([promoCodeId])
  @@map("reservations")
}

/// Промокод объекта (DATA_MODEL §20, ADR-128): процент скидки, период проживания, предел использований.
/// Не удаляется: выключается (`active`), чтобы броням оставался след.
model PromoCode {
  id              String    @id @default(uuid()) @db.Uuid
  propertyId      String    @map("property_id") @db.Uuid
  /// Верхний регистр, 3–32 знака A–Z, 0–9, «-», «_»
  code            String
  discountPercent Int       @map("discount_percent")
  /// Первая и последняя ночь проживания, включительно; NULL — без границы
  stayFrom        DateTime? @map("stay_from") @db.Date
  stayTo          DateTime? @map("stay_to") @db.Date
  maxUses         Int?      @map("max_uses")
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  property     Property      @relation(fields: [propertyId], references: [id])
  reservations Reservation[]

  @@unique([propertyId, code])
  @@map("promo_codes")
}

/// Проживание (room stay): одна ячейка на весь период (ADR-013; `quantity` убран, v0.3).
/// Статус ведётся здесь: no-show, переселение и счёт — на уровне проживания.
model ReservationItem {
  id                  String            @id @default(uuid()) @db.Uuid
  reservationId       String            @map("reservation_id") @db.Uuid
  accommodationTypeId String            @map("accommodation_type_id") @db.Uuid
  arrivalDate         DateTime          @map("arrival_date") @db.Date
  departureDate       DateTime          @map("departure_date") @db.Date
  /// integer minor units (тиын), ADR-008
  price               BigInt
  status              ReservationStatus
  /// Тариф проживания (Q-102); null — тариф ещё не назначен
  ratePlanId          String?           @map("rate_plan_id") @db.Uuid
  /// Гостей на проживании (Q-102): occupancy для цены и штрафа
  adults              Int               @default(1)
  children            Int               @default(0)
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  reservation       Reservation       @relation(fields: [reservationId], references: [id])
  accommodationType AccommodationType @relation(fields: [accommodationTypeId], references: [id])
  ratePlan          RatePlan?         @relation(fields: [ratePlanId], references: [id])
  allocations       Allocation[]
  stayGuests        StayGuest[]
  folio             Folio?

  @@index([reservationId])
  @@index([ratePlanId])
  @@index([accommodationTypeId, arrivalDate, departureDate])
  @@map("reservation_items")
}

/// Кто живёт в каком проживании (v0.3). Нужно для eQonaq (на гостя) и folio по проживанию.
model StayGuest {
  reservationItemId String  @map("reservation_item_id") @db.Uuid
  guestId           String  @map("guest_id") @db.Uuid
  isPrimary         Boolean @default(false) @map("is_primary")

  reservationItem ReservationItem @relation(fields: [reservationItemId], references: [id])
  guest           Guest           @relation(fields: [guestId], references: [id])

  @@id([reservationItemId, guestId])
  @@index([guestId])
  @@map("stay_guests")
}

/// Фактическое назначение ячейки на период [start_date, end_date). Переселение = закрыть одну
/// allocation и открыть другую (ADR-006). Правило автоназначения для OTA — Q-094.
model Allocation {
  id                String   @id @default(uuid()) @db.Uuid
  reservationItemId String   @map("reservation_item_id") @db.Uuid
  inventoryUnitId   String   @map("inventory_unit_id") @db.Uuid
  startDate         DateTime @map("start_date") @db.Date
  endDate           DateTime @map("end_date") @db.Date
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  reservationItem ReservationItem @relation(fields: [reservationItemId], references: [id])
  inventoryUnit   InventoryUnit   @relation(fields: [inventoryUnitId], references: [id])

  @@index([inventoryUnitId, startDate, endDate])
  @@index([reservationItemId])
  @@map("allocations")
}

// ───────────────────────── §3 Гости ─────────────────────────

enum Gender {
  MALE
  FEMALE
  UNKNOWN
}

/// Персональные данные — доступ по роли, не попадают в логи (SECURITY.md §1).
/// В dev-БД только анонимизированные значения (ADR-018).
model Guest {
  id             String    @id @default(uuid()) @db.Uuid
  /// Гость принадлежит своей организации (v1.13 RLS-1, ADR-103; колонку nullable завела Phase 1 ADR-100 §17.2,
  /// NOT NULL и DEFAULT app_current_org() — миграция 20260927000027). Служебный путь передаёт организацию объекта сам.
  organizationId String    @default(dbgenerated("app_current_org()")) @map("organization_id") @db.Uuid
  firstName      String    @map("first_name")
  lastName       String    @map("last_name")
  middleName     String?   @map("middle_name")
  birthDate      DateTime? @map("birth_date") @db.Date
  /// ISO 3166-1 alpha-3 либо NULL; обязательно на check-in, не на импорте (DATA_MODEL §3).
  /// VARCHAR, не CHAR: тип фиксированной длины дополнял пустую строку пробелами, и '   ' читалось
  /// как заполненное гражданство. Формат стережёт CHECK guests_citizenship_alpha3 (Q-117).
  citizenship    String?   @db.VarChar(3)
  gender         Gender    @default(UNKNOWN)
  phone          String?
  email          String?
  notes          String?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization        Organization    @relation(fields: [organizationId], references: [id])
  documents           GuestDocument[]
  deskTasks           DeskTask[]
  stays               StayGuest[]
  primaryReservations Reservation[]   @relation("primaryGuest")

  @@index([organizationId])
  @@index([lastName, firstName])
  @@index([phone])
  @@map("guests")
}

/// Документ гостя. Номер — только шифротекст (PII_ENCRYPTION_KEY), просмотр логируется.
model GuestDocument {
  id                 String   @id @default(uuid()) @db.Uuid
  guestId            String   @map("guest_id") @db.Uuid
  type               String
  numberEncrypted    String   @map("number_encrypted")
  /// ISO 3166-1 alpha-3 либо NULL; CHECK guest_documents_issue_country_alpha3 (Q-117)
  /// Открытым остаётся намеренно: класс «персональные», как citizenship, нужен eQonaq (v1.7, ADR-082)
  issueCountry       String?  @map("issue_country") @db.VarChar(3)
  /// Даты документа — особо чувствительные (SECURITY.md §1): ISO-дата, зашифрованная тем же ключом,
  /// что номер (v1.7, ADR-082). В запросах не участвуют — только запись и показ, расшифровка в приложении
  issuedAtEncrypted  String?  @map("issued_at_encrypted")
  expiresAtEncrypted String?  @map("expires_at_encrypted")
  documentFileId     String?  @map("document_file_id")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  guest Guest @relation(fields: [guestId], references: [id])

  @@index([guestId])
  @@map("guest_documents")
}

// ───────────────────────── §4 Housekeeping и блокировки ─────────────────────────

model HousekeepingEvent {
  id              String             @id @default(uuid()) @db.Uuid
  inventoryUnitId String             @map("inventory_unit_id") @db.Uuid
  fromStatus      HousekeepingStatus @map("from_status")
  toStatus        HousekeepingStatus @map("to_status")
  /// Сущность User появится после Q-060…Q-064; до этого — идентификатор без FK
  userId          String?            @map("user_id") @db.Uuid
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  inventoryUnit InventoryUnit @relation(fields: [inventoryUnitId], references: [id])

  @@index([inventoryUnitId, createdAt])
  @@map("housekeeping_events")
}

enum InventoryBlockType {
  MAINTENANCE
  MANAGEMENT
  OUT_OF_ORDER
  OTHER
}

/// Единственный источник правды для «единица недоступна» (DATA_MODEL v0.3).
/// Даты — DATE в timezone объекта, полуинтервал [date_from, date_to).
model InventoryBlock {
  id              String             @id @default(uuid()) @db.Uuid
  inventoryUnitId String             @map("inventory_unit_id") @db.Uuid
  dateFrom        DateTime           @map("date_from") @db.Date
  dateTo          DateTime           @map("date_to") @db.Date
  reason          String?
  type            InventoryBlockType
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  inventoryUnit InventoryUnit @relation(fields: [inventoryUnitId], references: [id])

  @@index([inventoryUnitId, dateFrom, dateTo])
  @@map("inventory_blocks")
}

// ───────────────────────── §5 Тарифы ─────────────────────────

/// Тарифный план. На объекте 6 (3 без продаж — Q-082: до ответа импортируются с active=false).
/// Питания нет ни у одного; сезонов в модели нет (DailyRate покрывает).
model RatePlan {
  id                   String              @id @default(uuid()) @db.Uuid
  propertyId           String              @map("property_id") @db.Uuid
  code                 String
  name                 String
  currency             String              @db.Char(3)
  mealPlan             String?             @map("meal_plan")
  active               Boolean             @default(true)
  /// Служебная заметка тарифа; не участвует в расчётах
  note                 String?
  /// Штраф при отмене/незаезде (Q-103); умолчание — стоимость первых суток
  cancellationPenalty  CancellationPenalty @default(FIRST_NIGHT) @map("cancellation_penalty")
  /// Производный тариф (DATA_MODEL §20, ADR-128): родитель и процент скидки; NULL — обычный тариф
  parentRatePlanId     String?             @map("parent_rate_plan_id") @db.Uuid
  discountPercent      Int?                @map("discount_percent")
  /// Окно продаж: заезд не раньше чем через N дней (раннее бронирование) и не позже чем через N дней (last minute)
  minDaysBeforeArrival Int?                @map("min_days_before_arrival")
  maxDaysBeforeArrival Int?                @map("max_days_before_arrival")
  /// Минимум ночей (long stay)
  minNights            Int?                @map("min_nights")
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  property        Property                    @relation(fields: [propertyId], references: [id])
  types           RatePlanAccommodationType[]
  dailyRates      DailyRate[]
  restrictions    Restriction[]
  channelMappings ChannelMapping[]
  items           ReservationItem[]
  trackedSites    TrackedSite[]
  parent          RatePlan?                   @relation("RatePlanDerived", fields: [parentRatePlanId], references: [id], onDelete: Restrict)
  derived         RatePlan[]                  @relation("RatePlanDerived")

  sellerBookingIntents SellerBookingIntent[]

  @@unique([propertyId, code])
  @@index([parentRatePlanId])
  @@map("rate_plans")
}

/// Тариф действует на категорию. На объекте — декартово произведение (тарифы на все категории).
model RatePlanAccommodationType {
  ratePlanId          String @map("rate_plan_id") @db.Uuid
  accommodationTypeId String @map("accommodation_type_id") @db.Uuid

  ratePlan          RatePlan          @relation(fields: [ratePlanId], references: [id])
  accommodationType AccommodationType @relation(fields: [accommodationTypeId], references: [id])

  @@id([ratePlanId, accommodationTypeId])
  @@map("rate_plan_accommodation_types")
}

/// Цена за ночь на дату. occupancy — число гостей (1 или 2; отличается только у «Двухместной»).
model DailyRate {
  date                DateTime @db.Date
  accommodationTypeId String   @map("accommodation_type_id") @db.Uuid
  ratePlanId          String   @map("rate_plan_id") @db.Uuid
  occupancy           Int      @default(1)
  /// integer minor units (тиын), ADR-008
  price               BigInt
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  accommodationType AccommodationType @relation(fields: [accommodationTypeId], references: [id])
  ratePlan          RatePlan          @relation(fields: [ratePlanId], references: [id])

  @@id([date, accommodationTypeId, ratePlanId, occupancy])
  @@index([accommodationTypeId, date])
  @@map("daily_rates")
}

/// Ограничения продаж на дату. На объекте сейчас ни одного, механизм обязателен для OTA.
model Restriction {
  date                DateTime @db.Date
  accommodationTypeId String   @map("accommodation_type_id") @db.Uuid
  ratePlanId          String   @map("rate_plan_id") @db.Uuid
  minStay             Int?     @map("min_stay")
  maxStay             Int?     @map("max_stay")
  stopSell            Boolean  @default(false) @map("stop_sell")
  closedToArrival     Boolean  @default(false) @map("closed_to_arrival")
  closedToDeparture   Boolean  @default(false) @map("closed_to_departure")
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  accommodationType AccommodationType @relation(fields: [accommodationTypeId], references: [id])
  ratePlan          RatePlan          @relation(fields: [ratePlanId], references: [id])

  @@id([date, accommodationTypeId, ratePlanId])
  @@index([accommodationTypeId, date])
  @@map("restrictions")
}

// ───────────────────────── §10 Аудит ─────────────────────────

/// Обязательно логируется: даты, цена, room move, cancellation, payment, refund,
/// ручное изменение availability, изменение документа гостя (SECURITY.md §6). Без PII в логах.
model AuditLog {
  id             String        @id @default(uuid()) @db.Uuid
  userId         String?       @map("user_id") @db.Uuid
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  entityType     String        @map("entity_type")
  entityId       String        @map("entity_id")
  action         String
  before         Json?
  after          Json?
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Чья запись (v1.13 ADR-103 + Phase 1 ADR-100 §17.2). Пишет код из контекста запроса (attachAuthor), добирает
  /// триггер audit_logs_organization (организация запроса, иначе — по сущности). NULL — платформа/система.
  organizationId String?       @map("organization_id") @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ───────────────────────── §7 Channel Manager ─────────────────────────

/// Соответствие наших сущностей объектам Channex и каналов (DATA_MODEL §7). Vendor ID живут только здесь
/// и в packages/integrations (ADR-004). Одна строка = одна пара (категория, тариф) у одного провайдера.
model ChannelMapping {
  id                       String   @id @default(uuid()) @db.Uuid
  propertyId               String   @map("property_id") @db.Uuid
  /// Провайдер: пока только `channex`
  provider                 String
  /// Канал (booking.com, agoda, …); null для сущностей уровня провайдера
  channel                  String?
  localAccommodationTypeId String?  @map("local_accommodation_type_id") @db.Uuid
  localRatePlanId          String?  @map("local_rate_plan_id") @db.Uuid
  providerPropertyId       String   @map("provider_property_id")
  providerRoomTypeId       String?  @map("provider_room_type_id")
  providerRatePlanId       String?  @map("provider_rate_plan_id")
  channelPropertyId        String?  @map("channel_property_id")
  channelRoomId            String?  @map("channel_room_id")
  channelRateId            String?  @map("channel_rate_id")
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  property          Property           @relation(fields: [propertyId], references: [id])
  accommodationType AccommodationType? @relation(fields: [localAccommodationTypeId], references: [id])
  ratePlan          RatePlan?          @relation(fields: [localRatePlanId], references: [id])

  @@unique([provider, providerRatePlanId])
  @@index([propertyId, provider])
  @@index([localAccommodationTypeId])
  @@index([localRatePlanId])
  @@map("channel_mappings")
}

// ───────────────────────── §8 Внешние события ─────────────────────────

enum ExternalEventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
}

/// Журнал входящих событий (webhook, revision feed). UNIQUE(provider, external_event_id) —
/// идемпотентность обязательна (ADR-007): сначала записано, потом обработано, повтор безопасен.
model ExternalEvent {
  id              String              @id @default(uuid()) @db.Uuid
  /// Чей это объект (Phase 1 изоляции, ADR-100 §17.2, DATA_MODEL v2.1): scope по объекту — событие канала
  /// принадлежит гостинице, не организации. NULL — принадлежность не выведена при backfill (отчёт 20260927000026).
  /// Таблица без RLS (DATA_MODEL §17.3): читает и служебный путь; чтения стойки фильтрует код (Phase 1).
  propertyId      String?             @map("property_id") @db.Uuid
  property        Property?           @relation(fields: [propertyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  provider        String
  externalEventId String              @map("external_event_id")
  type            String
  receivedAt      DateTime            @default(now()) @map("received_at") @db.Timestamptz(6)
  payloadHash     String              @map("payload_hash")
  payload         Json?
  status          ExternalEventStatus @default(RECEIVED)
  attemptCount    Int                 @default(0) @map("attempt_count")
  lastError       String?             @map("last_error")
  /// Каким путём дошло: webhook, опрос ленты или кнопка «Обработать заново». Без этого поля
  /// «бронь пришла сама» и «подобрал опрос через пять минут» в журнале неразличимы.
  receivedVia     ExternalEventVia    @default(PULL) @map("received_via")
  processedAt     DateTime?           @map("processed_at") @db.Timestamptz(6)

  @@unique([provider, externalEventId])
  @@index([propertyId])
  @@index([status, receivedAt])
  @@map("external_events")
}

enum ExternalEventVia {
  WEBHOOK
  PULL
  MANUAL
}

enum ChannelOutboxKind {
  AVAILABILITY
  RESTRICTIONS
}

enum ChannelOutboxStatus {
  PENDING
  SENT
  FAILED
}

/// Очередь исходящих изменений ARI (DATA_MODEL §7, ChannelOutbox). Не бизнес-данные.
model ChannelOutbox {
  id            String              @id @default(uuid()) @db.Uuid
  /// Чей это объект (Phase 1 изоляции, ADR-100 §17.2, DATA_MODEL v2.1). NULL — backfill не вывел однозначно.
  /// Таблица без RLS (DATA_MODEL §17.3): читает и служебный путь; чтения стойки фильтрует код (Phase 1).
  propertyId    String?             @map("property_id") @db.Uuid
  property      Property?           @relation(fields: [propertyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  provider      String
  kind          ChannelOutboxKind
  payload       Json
  status        ChannelOutboxStatus @default(PENDING)
  attempts      Int                 @default(0)
  nextAttemptAt DateTime            @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  taskId        String?             @map("task_id")
  lastError     String?             @map("last_error")
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  sentAt        DateTime?           @map("sent_at") @db.Timestamptz(6)

  @@index([propertyId])
  @@index([provider, status, nextAttemptAt])
  @@map("channel_outbox")
}

// ───────────────────────── §6 Folio (финансы) ─────────────────────────

/// Штраф при отмене и незаезде — политика тарифа (Q-103): «первые сутки» по умолчанию
enum CancellationPenalty {
  NONE
  FIRST_NIGHT
  FULL_STAY
}

enum FolioStatus {
  OPEN
  CLOSED
}

enum ChargeKind {
  ACCOMMODATION
  SERVICE
  PENALTY
  ADJUSTMENT
}

/// Способы оплаты WETOP; «Наличными через кассу» сведено в CASH (Q-083).
enum PaymentMethod {
  CASH
  CARD_TERMINAL
  BANK_TRANSFER_LEGAL
  EXTERNAL
  BANK_TRANSFER_PERSON
  CARD_GUARANTEE
  DEPOSIT
  HALYK
  KASPI
}

enum PaymentStatus {
  COMPLETED
  VOIDED
}

/// Счёт гостя — один на проживание (ADR-014). Создаётся вместе с проживанием.
/// DATA_MODEL §24: запрос оплаты (ADR-144)
enum PaymentRequestStatus {
  PENDING
  PAID
  CANCELLED
}

model Folio {
  id                String      @id @default(uuid()) @db.Uuid
  reservationItemId String      @unique @map("reservation_item_id") @db.Uuid
  status            FolioStatus @default(OPEN)
  currency          String      @db.Char(3)
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  closedAt          DateTime?   @map("closed_at") @db.Timestamptz(6)

  reservationItem ReservationItem     @relation(fields: [reservationItemId], references: [id])
  charges         Charge[]
  allocations     PaymentAllocation[]
  refunds         Refund[]
  paymentRequests PaymentRequest[]
  barSales        BarSale[]

  @@map("folios")
}

model Service {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @map("property_id") @db.Uuid
  code       String
  nameRu     String   @map("name_ru")
  nameKz     String?  @map("name_kz")
  /// integer minor units (тиын), ADR-008
  price      BigInt
  tax        Int?
  group      String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  property Property @relation(fields: [propertyId], references: [id])
  charges  Charge[]

  @@unique([propertyId, code])
  @@map("services")
}

/// Начисление на счёт. Сторно — voided_at, строка не удаляется.
model Charge {
  id          String     @id @default(uuid()) @db.Uuid
  folioId     String     @map("folio_id") @db.Uuid
  kind        ChargeKind
  serviceId   String?    @map("service_id") @db.Uuid
  description String
  quantity    Int        @default(1)
  /// integer minor units (тиын), ADR-008
  unitPrice   BigInt     @map("unit_price")
  /// integer minor units; ADJUSTMENT может быть отрицательным
  amount      BigInt
  serviceDate DateTime?  @map("service_date") @db.Date
  createdBy   String?    @map("created_by") @db.Uuid
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  voidedAt    DateTime?  @map("voided_at") @db.Timestamptz(6)

  folio   Folio    @relation(fields: [folioId], references: [id])
  service Service? @relation(fields: [serviceId], references: [id])
  barSale BarSale?

  @@index([folioId])
  @@map("charges")
}

/// Платёж. Распределяется по счетам через PaymentAllocation (Σ = amount).
model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  propertyId        String        @map("property_id") @db.Uuid
  method            PaymentMethod
  /// integer minor units (тиын), ADR-008
  amount            BigInt
  currency          String        @db.Char(3)
  status            PaymentStatus @default(COMPLETED)
  /// Ссылка банка/канала для внешних платежей
  externalReference String?       @map("external_reference")
  note              String?
  paidAt            DateTime      @default(now()) @map("paid_at") @db.Timestamptz(6)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  property    Property            @relation(fields: [propertyId], references: [id])
  allocations PaymentAllocation[]
  refunds     Refund[]
  request     PaymentRequest?
  receipt     FiscalReceipt?

  @@unique([propertyId, externalReference])
  @@index([propertyId, paidAt])
  @@map("payments")
}

model PaymentAllocation {
  paymentId String @map("payment_id") @db.Uuid
  folioId   String @map("folio_id") @db.Uuid
  /// integer minor units (тиын), ADR-008
  amount    BigInt

  payment Payment @relation(fields: [paymentId], references: [id])
  folio   Folio   @relation(fields: [folioId], references: [id])

  @@id([paymentId, folioId])
  @@index([folioId])
  @@map("payment_allocations")
}

model Refund {
  id                String   @id @default(uuid()) @db.Uuid
  paymentId         String   @map("payment_id") @db.Uuid
  folioId           String   @map("folio_id") @db.Uuid
  /// integer minor units (тиын), ADR-008
  amount            BigInt
  reason            String?
  externalReference String?  @map("external_reference")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  payment Payment @relation(fields: [paymentId], references: [id])
  folio   Folio   @relation(fields: [folioId], references: [id])

  @@index([folioId])
  @@map("refunds")
}

// Касса (DATA_MODEL §21, утверждено 02.10.2026): движения денег мимо счетов гостей.
// Гостевые оплаты сюда не дублируются — остаток по способу вычисляется из payments/refunds и этих операций.
/// DATA_MODEL §22: приоритет задачи стойки
enum TaskPriority {
  LOW
  NORMAL
  HIGH
}

enum CashOperationKind {
  INCOME
  EXPENSE
  TRANSFER
}

enum BarReceiptStatus {
  DRAFT
  POSTED
  REVERSED
}

enum BarStockMovementKind {
  RECEIPT
  SALE
  WRITE_OFF
  SALE_RETURN
  INVENTORY_ADJUSTMENT
}

enum BarSaleStatus {
  POSTED
  REVERSED
}

model BarCategory {
  id                 String   @id @default(uuid()) @db.Uuid
  propertyId         String   @map("property_id") @db.Uuid
  name               String
  defaultMarkupBasis Int      @map("default_markup_basis")
  active             Boolean  @default(true)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  property Property     @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  products BarProduct[]

  @@unique([propertyId, name])
  @@map("bar_categories")
}

model BarProduct {
  id                String   @id @default(uuid()) @db.Uuid
  propertyId        String   @map("property_id") @db.Uuid
  categoryId        String?  @map("category_id") @db.Uuid
  code              String
  name              String
  barcode           String?
  unitsPerPackage   Int      @default(1) @map("units_per_package")
  markupBasis       Int?     @map("markup_basis")
  salePrice         BigInt   @map("sale_price")
  minimumStockUnits BigInt   @default(0) @map("minimum_stock_units")
  active            Boolean  @default(true)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  property     Property           @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  category     BarCategory?       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  receiptLines BarReceiptLine[]
  lots         BarStockLot[]
  movements    BarStockMovement[]
  saleLines    BarSaleLine[]

  @@unique([propertyId, code])
  @@unique([propertyId, barcode])
  @@index([propertyId, active])
  @@map("bar_products")
}

model BarSupplier {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @map("property_id") @db.Uuid
  name       String
  phone      String?
  email      String?
  details    String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  property Property     @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  receipts BarReceipt[]

  @@unique([propertyId, name])
  @@map("bar_suppliers")
}

model BarReceipt {
  id             String           @id @default(uuid()) @db.Uuid
  propertyId     String           @map("property_id") @db.Uuid
  supplierId     String           @map("supplier_id") @db.Uuid
  documentNumber String           @map("document_number")
  documentDate   DateTime         @map("document_date") @db.Date
  receivedDate   DateTime         @map("received_date") @db.Date
  status         BarReceiptStatus @default(DRAFT)
  currency       String           @db.Char(3)
  totalAmount    BigInt           @map("total_amount")
  note           String?
  createdById    String?          @map("created_by_id") @db.Uuid
  postedAt       DateTime?        @map("posted_at") @db.Timestamptz(6)
  reversedAt     DateTime?        @map("reversed_at") @db.Timestamptz(6)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  property Property             @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  supplier BarSupplier          @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  lines    BarReceiptLine[]
  payments BarSupplierPayment[]

  @@unique([propertyId, supplierId, documentNumber])
  @@index([propertyId, receivedDate])
  @@map("bar_receipts")
}

model BarReceiptLine {
  id              String @id @default(uuid()) @db.Uuid
  receiptId       String @map("receipt_id") @db.Uuid
  productId       String @map("product_id") @db.Uuid
  quantityUnits   BigInt @map("quantity_units")
  unitCost        BigInt @map("unit_cost")
  amount          BigInt
  markupBasis     Int    @map("markup_basis")
  calculatedPrice BigInt @map("calculated_price")

  receipt BarReceipt   @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  product BarProduct   @relation(fields: [productId], references: [id], onDelete: Restrict)
  lot     BarStockLot?

  @@unique([receiptId, productId])
  @@map("bar_receipt_lines")
}

model BarStockLot {
  id             String    @id @default(uuid()) @db.Uuid
  propertyId     String    @map("property_id") @db.Uuid
  productId      String    @map("product_id") @db.Uuid
  receiptLineId  String    @unique @map("receipt_line_id") @db.Uuid
  receivedUnits  BigInt    @map("received_units")
  remainingUnits BigInt    @map("remaining_units")
  unitCost       BigInt    @map("unit_cost")
  receivedAt     DateTime  @map("received_at") @db.Timestamptz(6)
  expiresOn      DateTime? @map("expires_on") @db.Date

  property    Property           @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  product     BarProduct         @relation(fields: [productId], references: [id], onDelete: Restrict)
  receiptLine BarReceiptLine     @relation(fields: [receiptLineId], references: [id], onDelete: Restrict)
  movements   BarStockMovement[]

  @@index([propertyId, productId, receivedAt])
  @@map("bar_stock_lots")
}

model BarStockMovement {
  id          String               @id @default(uuid()) @db.Uuid
  propertyId  String               @map("property_id") @db.Uuid
  productId   String               @map("product_id") @db.Uuid
  lotId       String?              @map("lot_id") @db.Uuid
  kind        BarStockMovementKind
  units       BigInt
  unitCost    BigInt               @map("unit_cost")
  sourceType  String               @map("source_type")
  sourceId    String               @map("source_id") @db.Uuid
  note        String?
  createdById String?              @map("created_by_id") @db.Uuid
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  property Property     @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  product  BarProduct   @relation(fields: [productId], references: [id], onDelete: Restrict)
  lot      BarStockLot? @relation(fields: [lotId], references: [id], onDelete: Restrict)

  @@unique([sourceType, sourceId, productId, lotId])
  @@index([propertyId, productId, createdAt])
  @@map("bar_stock_movements")
}

model BarSupplierPayment {
  id              String   @id @default(uuid()) @db.Uuid
  receiptId       String   @map("receipt_id") @db.Uuid
  cashOperationId String   @unique @map("cash_operation_id") @db.Uuid
  amount          BigInt
  paidAt          DateTime @map("paid_at") @db.Timestamptz(6)
  createdById     String?  @map("created_by_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  receipt       BarReceipt    @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  cashOperation CashOperation @relation(fields: [cashOperationId], references: [id], onDelete: Restrict)

  @@index([receiptId, paidAt])
  @@map("bar_supplier_payments")
}

model BarSale {
  id              String        @id @default(uuid()) @db.Uuid
  propertyId      String        @map("property_id") @db.Uuid
  folioId         String?       @map("folio_id") @db.Uuid
  cashOperationId String?       @unique @map("cash_operation_id") @db.Uuid
  chargeId        String?       @unique @map("charge_id") @db.Uuid
  idempotencyKey  String        @map("idempotency_key")
  status          BarSaleStatus @default(POSTED)
  currency        String        @db.Char(3)
  totalRevenue    BigInt        @map("total_revenue")
  totalCost       BigInt        @map("total_cost")
  createdById     String?       @map("created_by_id") @db.Uuid
  reversedAt      DateTime?     @map("reversed_at") @db.Timestamptz(6)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  property      Property       @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  folio         Folio?         @relation(fields: [folioId], references: [id], onDelete: Restrict)
  cashOperation CashOperation? @relation(fields: [cashOperationId], references: [id], onDelete: Restrict)
  charge        Charge?        @relation(fields: [chargeId], references: [id], onDelete: Restrict)
  lines         BarSaleLine[]

  @@unique([propertyId, idempotencyKey])
  @@index([propertyId, createdAt])
  @@map("bar_sales")
}

model BarSaleLine {
  id            String @id @default(uuid()) @db.Uuid
  saleId        String @map("sale_id") @db.Uuid
  productId     String @map("product_id") @db.Uuid
  quantityUnits BigInt @map("quantity_units")
  salePrice     BigInt @map("sale_price")
  revenue       BigInt
  cost          BigInt

  sale    BarSale    @relation(fields: [saleId], references: [id], onDelete: Restrict)
  product BarProduct @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([saleId, productId])
  @@map("bar_sale_lines")
}

/// Статья кассы: справочник объекта. Удаления нет — архив через active (как Service)
model CashCategory {
  id         String            @id @default(uuid()) @db.Uuid
  propertyId String            @map("property_id") @db.Uuid
  kind       CashOperationKind
  name       String
  active     Boolean           @default(true)
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  property   Property        @relation(fields: [propertyId], references: [id])
  operations CashOperation[]

  @@unique([propertyId, kind, name])
  @@map("cash_categories")
}

/// Поступление, расход или перевод между способами; прошлое не правится — ошибка аннулируется (status)
model CashOperation {
  id          String            @id @default(uuid()) @db.Uuid
  propertyId  String            @map("property_id") @db.Uuid
  kind        CashOperationKind
  /// для TRANSFER — способ «откуда»
  method      PaymentMethod
  /// только TRANSFER — способ «куда»
  methodTo    PaymentMethod?    @map("method_to")
  /// integer minor units (тиын), ADR-008; > 0
  amount      BigInt
  categoryId  String?           @map("category_id") @db.Uuid
  note        String?
  /// комиссия ссылается на свою операцию или перевод
  relatedId   String?           @map("related_id") @db.Uuid
  status      PaymentStatus     @default(COMPLETED)
  occurredAt  DateTime          @default(now()) @map("occurred_at") @db.Timestamptz(6)
  createdById String?           @map("created_by_id") @db.Uuid
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  property        Property            @relation(fields: [propertyId], references: [id])
  category        CashCategory?       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdBy       User?               @relation(fields: [createdById], references: [id])
  /// как в миграции 040: ключ на свою же таблицу, удалить операцию с комиссией нельзя
  related         CashOperation?      @relation("CashOperationRelated", fields: [relatedId], references: [id], onDelete: Restrict)
  dependents      CashOperation[]     @relation("CashOperationRelated")
  supplierPayment BarSupplierPayment?
  barSale         BarSale?

  @@index([propertyId, occurredAt])
  @@index([relatedId])
  @@map("cash_operations")
}

/// Сверка кассы (§21.4): снимок «по системе» и факт. Аннулирования нет — ошиблись, сверили заново
model CashReconciliation {
  id          String        @id @default(uuid()) @db.Uuid
  propertyId  String        @map("property_id") @db.Uuid
  method      PaymentMethod
  /// остаток по системе в момент сверки, тиыны (ADR-008): задним числом не восстановить
  expected    BigInt
  /// фактически пересчитано, >= 0
  counted     BigInt
  note        String?
  createdById String?       @map("created_by_id") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  property  Property @relation(fields: [propertyId], references: [id])
  createdBy User?    @relation(fields: [createdById], references: [id])

  @@index([propertyId, method, createdAt])
  @@map("cash_reconciliations")
}

/// DATA_MODEL §24 (03.10.2026, ADR-144): счёт Kaspi по телефону, ссылка банка или перевод, привязанные к счёту
/// проживания. «Оплачено» создаёт обычный Payment и закрывает запрос одной транзакцией.
model PaymentRequest {
  id          String               @id @default(uuid()) @db.Uuid
  propertyId  String               @map("property_id") @db.Uuid
  folioId     String               @map("folio_id") @db.Uuid
  /// integer minor units (тиын), ADR-008; > 0
  amount      BigInt
  currency    String               @db.Char(3)
  /// KASPI, HALYK, BANK_TRANSFER_PERSON, CARD_TERMINAL (CHECK в миграции)
  method      PaymentMethod
  /// только https://, до 500 знаков
  link        String?
  status      PaymentRequestStatus @default(PENDING)
  paymentId   String?              @unique @map("payment_id") @db.Uuid
  note        String?
  createdById String?              @map("created_by_id") @db.Uuid
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  closedAt    DateTime?            @map("closed_at") @db.Timestamptz(6)

  property  Property @relation(fields: [propertyId], references: [id])
  folio     Folio    @relation(fields: [folioId], references: [id])
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  createdBy User?    @relation(fields: [createdById], references: [id])

  @@index([folioId])
  @@index([propertyId, status])
  @@map("payment_requests")
}

/// DATA_MODEL §26 (03.10.2026, ADR-144): фискальный чек, выданный по запросу гостя. Номер — из кассы объекта,
/// один чек на платёж; адаптер облачной кассы допишет внешний id без смены таблицы (Q-263)
model FiscalReceipt {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @map("property_id") @db.Uuid
  paymentId  String   @unique @map("payment_id") @db.Uuid
  /// номер чека или фискальный признак из кассы, 1–64 знака
  number     String
  issuedAt   DateTime @default(now()) @map("issued_at") @db.Timestamptz(6)
  issuedById String?  @map("issued_by_id") @db.Uuid

  property Property @relation(fields: [propertyId], references: [id])
  payment  Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  issuedBy User?    @relation(fields: [issuedById], references: [id])

  @@index([propertyId, issuedAt])
  @@map("fiscal_receipts")
}

/// DATA_MODEL §25 (контракт 30.09.2026, ADR-144): намерение брони ИИ-продавца
enum SellerBookingIntentState {
  QUOTED
  CONFIRMED
  REJECTED
}

/// DATA_MODEL §25: котировка из чата живёт 30 минут; подтверждение создаёт бронь с creationKey = id
model SellerBookingIntent {
  id                  String                   @id @default(uuid()) @db.Uuid
  agentId             String                   @map("agent_id") @db.Uuid
  organizationId      String                   @map("organization_id") @db.Uuid
  propertyId          String                   @map("property_id") @db.Uuid
  conversationId      String                   @map("conversation_id") @db.VarChar(64)
  /// whatsapp | widget (CHECK в миграции)
  channel             String                   @db.VarChar(16)
  channelMessageId    String?                  @map("channel_message_id") @db.VarChar(128)
  accommodationTypeId String                   @map("accommodation_type_id") @db.Uuid
  ratePlanId          String                   @map("rate_plan_id") @db.Uuid
  arrivalDate         DateTime                 @map("arrival_date") @db.Date
  departureDate       DateTime                 @map("departure_date") @db.Date
  adults              Int
  /// integer minor units (тиын), ADR-008; > 0
  totalMinor          BigInt                   @map("total_minor")
  currency            String                   @db.Char(3)
  expiresAt           DateTime                 @map("expires_at") @db.Timestamptz(6)
  state               SellerBookingIntentState @default(QUOTED)
  reservationId       String?                  @unique @map("reservation_id") @db.Uuid
  requestHash         String                   @map("request_hash") @db.VarChar(64)
  createdAt           DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  agent             SellerAgent       @relation(fields: [agentId], references: [id], onDelete: Restrict)
  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  property          Property          @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  accommodationType AccommodationType @relation(fields: [accommodationTypeId], references: [id], onDelete: Restrict)
  ratePlan          RatePlan          @relation(fields: [ratePlanId], references: [id], onDelete: Restrict)
  reservation       Reservation?      @relation(fields: [reservationId], references: [id], onDelete: Restrict)

  @@unique([agentId, channelMessageId])
  @@index([agentId, conversationId, createdAt])
  @@map("seller_booking_intents")
}

// ───────────────────────── §23 Загрузка конкурентов ─────────────────────────
// ADR-142 (03.10.2026): конкуренты объекта и снимки их загрузки по ночам. Своя загрузка не хранится.

enum CompetitorObservationSource {
  MANUAL
  AI_AGENT
}

/// DATA_MODEL §23.1: что видно на площадке на ночь, когда процента загрузки соседа нет
enum CompetitorAvailabilityLevel {
  SOLD_OUT
  FEW_LEFT
  AVAILABLE
}

model Competitor {
  id          String   @id @default(uuid()) @db.Uuid
  propertyId  String   @map("property_id") @db.Uuid
  name        String
  /// расстояние в метрах, >= 0
  distanceM   Int?     @map("distance_m")
  /// номеров у конкурента, если известно (> 0)
  unitsTotal  Int?     @map("units_total")
  url         String?
  note        String?
  /// «убрать из списка» = архив, снимки остаются
  active      Boolean  @default(true)
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  property  Property              @relation(fields: [propertyId], references: [id])
  createdBy User?                 @relation(fields: [createdById], references: [id])
  readings  CompetitorOccupancy[]

  @@unique([propertyId, name])
  @@unique([id, propertyId])
  @@map("competitors")
}

/// Снимок загрузки конкурента на ночь stay_date, сделанный в день observed_on; повтор за день заменяет значение
model CompetitorOccupancy {
  id           String                      @id @default(uuid()) @db.Uuid
  propertyId   String                      @map("property_id") @db.Uuid
  competitorId String                      @map("competitor_id") @db.Uuid
  stayDate     DateTime                    @map("stay_date") @db.Date
  observedOn   DateTime                    @map("observed_on") @db.Date
  /// базисные пункты 0…10 000 (85,5 % = 8 550), ADR-008; NULL, когда известен только уровень (§23.1)
  occupancyBp       Int?                         @map("occupancy_bp")
  /// §23.1: уровень наличия; хотя бы одно из двух полей заполнено (CHECK competitor_occupancy_has_value)
  availabilityLevel CompetitorAvailabilityLevel? @map("availability_level")
  source       CompetitorObservationSource @default(MANUAL)
  createdById  String?                     @map("created_by_id") @db.Uuid
  observedAt   DateTime                    @default(now()) @map("observed_at") @db.Timestamptz(6)

  property   Property   @relation(fields: [propertyId], references: [id])
  competitor Competitor @relation(fields: [competitorId, propertyId], references: [id, propertyId], map: "competitor_occupancy_competitor_fkey")
  createdBy  User?      @relation(fields: [createdById], references: [id])

  @@unique([competitorId, stayDate, observedOn])
  @@index([propertyId, observedOn, stayDate])
  @@map("competitor_occupancy")
}

// ───────────────────────── §11 Аналитика сайта ─────────────────────────
// Срез 8 (план plans/slice-8-web-analytics.md, принят владельцем 12.09.2026). Персональных данных нет по
// построению: IP и полный User-Agent не сохраняются, visitor_key — случайное число из браузера (ADR-018).

enum TrackedSiteStatus {
  ACTIVE
  PAUSED
}

enum WebSourceKind {
  DIRECT
  SEARCH
  SOCIAL
  PAID
  EMAIL
  REFERRAL
}

enum WebDevice {
  DESKTOP
  MOBILE
  TABLET
}

/// Сайт объекта со счётчиком. Ключ стоит в HTML сайта — не секрет; домены ограничивают приёмник.
model TrackedSite {
  id                String            @id @default(uuid()) @db.Uuid
  propertyId        String            @map("property_id") @db.Uuid
  name              String
  /// Домены сайта; Origin/Referer приёмника должны совпадать (сам домен или поддомен)
  hosts             String[]
  /// pms_ + 12 hex — ключ в атрибуте data-site
  publicKey         String            @unique @map("public_key")
  status            TrackedSiteStatus @default(ACTIVE)
  /// Виджет бронирования на сайте (срез 9): выключен, пока владелец не включит на карточке сайта
  bookingEnabled    Boolean           @default(false) @map("booking_enabled")
  /// Тариф, по которому виджет считает цену и создаёт бронь; null — бронирование не настроено
  bookingRatePlanId String?           @map("booking_rate_plan_id") @db.Uuid
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  property        Property       @relation(fields: [propertyId], references: [id])
  bookingRatePlan RatePlan?      @relation(fields: [bookingRatePlanId], references: [id])
  sessions        WebSession[]
  marketingSite   MarketingSite?
  bookingOf       Location[]     @relation("LocationBookingSite")

  @@index([propertyId])
  @@map("tracked_sites")
}

/// Состояние управляемого сайта (DATA_MODEL §29.8). MKT3 заводит сайт только в DRAFT; публикация, пауза и архив
/// появятся со своими срезами (MKT7), значения заведены сразу как часть утверждённой целевой модели.
enum MarketingSiteState {
  DRAFT
  PUBLISHED
  PAUSED
  ARCHIVED
}

/// Откуда версия: ручная правка, результат ИИ (с MKT6 вместе с generation_run_id), перенос документа
enum SiteVersionSource {
  MANUAL
  AI
  IMPORT
}

/// Управляемый сайт филиала (DATA_MODEL §29.2, ADR-149, MKT3). Владелец Location; с MKT9.2 один сайт на филиал навсегда
/// (полный UNIQUE location_id, миграция …068), slug уникален среди неархивных (частичный индекс …060). Указатели на версии только
/// этого же сайта держит триггер marketing_site_guard. TrackedSite не CMS: связь заводится при публикации (MKT7).
model MarketingSite {
  id                  String             @id @default(uuid()) @db.Uuid
  locationId          String             @unique @map("location_id") @db.Uuid
  trackedSiteId       String?            @unique @map("tracked_site_id") @db.Uuid
  name                String             @db.VarChar(120)
  slug                String             @db.VarChar(40)
  state               MarketingSiteState @default(DRAFT)
  latestVersionId     String?            @map("latest_version_id") @db.Uuid
  publishedVersionId  String?            @map("published_version_id") @db.Uuid
  createdById         String?            @map("created_by_id") @db.Uuid
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt          DateTime?          @map("archived_at") @db.Timestamptz(6)
  /// MKT9.2: знания проекта, постоянные указания ИИ этого сайта; данные, а не правила системы
  builderInstructions String?            @map("builder_instructions") @db.VarChar(5000)

  location         Location                       @relation(fields: [locationId], references: [id], onDelete: Restrict)
  trackedSite      TrackedSite?                   @relation(fields: [trackedSiteId], references: [id], onDelete: SetNull)
  latestVersion    MarketingSiteVersion?          @relation("MarketingSiteLatest", fields: [latestVersionId], references: [id], onDelete: Restrict)
  publishedVersion MarketingSiteVersion?          @relation("MarketingSitePublished", fields: [publishedVersionId], references: [id], onDelete: Restrict)
  createdBy        User?                          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  versions         MarketingSiteVersion[]         @relation("MarketingSiteVersions")
  generationRuns   GenerationRun[]
  publications     MarketingSitePublication[]
  domains          SiteDomain[]
  aiRuns           SiteAiRun[]
  bookmarks        MarketingSiteVersionBookmark[]

  @@map("marketing_sites")
}

/// Неизменяемая версия SiteSpec (DATA_MODEL §29.3, MKT3). UPDATE и DELETE запрещает триггер, у ролей приложения прав на
/// них нет. Первая версия revision 1 без родителя, следующая revision родителя + 1 с родителем того же сайта
/// (триггер marketing_site_version_guard). Источник: MANUAL без задачи, AI только с задачей своего сайта (MKT6, CHECK
/// marketing_site_versions_source_provenance и триггер marketing_site_version_run_guard); одна задача, одна версия.
model MarketingSiteVersion {
  id              String            @id @default(uuid()) @db.Uuid
  siteId          String            @map("site_id") @db.Uuid
  revision        Int
  parentVersionId String?           @map("parent_version_id") @db.Uuid
  schemaVersion   String            @map("schema_version") @db.VarChar(20)
  spec            Json
  specHash        String            @map("spec_hash") @db.Char(64)
  source          SiteVersionSource
  generationRunId String?           @unique @map("generation_run_id") @db.Uuid
  createdById     String?           @map("created_by_id") @db.Uuid
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  site                   MarketingSite                  @relation("MarketingSiteVersions", fields: [siteId], references: [id], onDelete: Restrict)
  generationRun          GenerationRun?                 @relation("GenerationRunVersion", fields: [generationRunId], references: [id], onDelete: Restrict)
  baseOfRuns             GenerationRun[]                @relation("GenerationRunBase")
  outputOfRun            GenerationRun?                 @relation("GenerationRunOutput")
  parent                 MarketingSiteVersion?          @relation("MarketingSiteVersionParent", fields: [parentVersionId], references: [id], onDelete: Restrict)
  children               MarketingSiteVersion[]         @relation("MarketingSiteVersionParent")
  latestOf               MarketingSite[]                @relation("MarketingSiteLatest")
  publishedOf            MarketingSite[]                @relation("MarketingSitePublished")
  publicationsOf         MarketingSitePublication[]     @relation("PublicationVersion")
  publicationsPreviousOf MarketingSitePublication[]     @relation("PublicationPreviousVersion")
  createdBy              User?                          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  aiRunsBasedOn          SiteAiRun[]
  bookmarks              MarketingSiteVersionBookmark[]

  @@unique([siteId, revision])
  @@map("marketing_site_versions")
}

/// Вид задачи генерации (DATA_MODEL §29.7): MKT6 ставит только INITIAL; SECTION и PATCH откроет MKT9, SEO MKT11
enum GenerationRunType {
  INITIAL
  SECTION
  PATCH
  SEO
}

/// Состояние задачи генерации (§29.8): QUEUED → RUNNING → SUCCEEDED | FAILED; RUNNING → QUEUED при повторе;
/// QUEUED → CANCELLED | FAILED. Конечные не меняются (триггер generation_run_guard)
enum GenerationRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

/// Задача генерации сайта ИИ, она же очередь в Postgres (DATA_MODEL §29.7, MKT6, Q-274). Бриф, промпт и ответ модели
/// не хранятся: только хэш брифа, имя модели, расход токенов (сумма всех фактических вызовов run) и замаскированная
/// ошибка. Форму состояния, переходы, рост токенов и принадлежность версий держит база (CHECK и generation_run_guard).
/// next_attempt_at: время следующей попытки в QUEUED и срок аренды воркера в RUNNING; dispatched_at: запрос к ИИ ушёл,
/// расход ещё не записан (падение в это время даёт USAGE_UNAVAILABLE, а не повтор)
model GenerationRun {
  id              String              @id @default(uuid()) @db.Uuid
  siteId          String              @map("site_id") @db.Uuid
  type            GenerationRunType
  status          GenerationRunStatus @default(QUEUED)
  requestKey      String              @map("request_key") @db.Uuid
  requestedById   String?             @map("requested_by_id") @db.Uuid
  baseVersionId   String?             @map("base_version_id") @db.Uuid
  outputVersionId String?             @unique @map("output_version_id") @db.Uuid
  briefHash       String?             @map("brief_hash") @db.Char(64)
  instruction     String?             @db.VarChar(2000)
  model           String?             @db.VarChar(100)
  tokensInput     Int?                @map("tokens_input")
  tokensOutput    Int?                @map("tokens_output")
  tokensCached    Int?                @map("tokens_cached")
  attempts        Int                 @default(0)
  nextAttemptAt   DateTime?           @map("next_attempt_at") @db.Timestamptz(6)
  dispatchedAt    DateTime?           @map("dispatched_at") @db.Timestamptz(6)
  errorCode       String?             @map("error_code") @db.VarChar(40)
  errorMessage    String?             @map("error_message") @db.VarChar(500)
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  startedAt       DateTime?           @map("started_at") @db.Timestamptz(6)
  finishedAt      DateTime?           @map("finished_at") @db.Timestamptz(6)

  site          MarketingSite         @relation(fields: [siteId], references: [id], onDelete: Restrict)
  requestedBy   User?                 @relation(fields: [requestedById], references: [id], onDelete: SetNull)
  baseVersion   MarketingSiteVersion? @relation("GenerationRunBase", fields: [baseVersionId], references: [id], onDelete: Restrict)
  outputVersion MarketingSiteVersion? @relation("GenerationRunOutput", fields: [outputVersionId], references: [id], onDelete: Restrict)
  version       MarketingSiteVersion? @relation("GenerationRunVersion")

  @@unique([siteId, requestKey])
  @@index([status, nextAttemptAt])
  @@index([requestedById, createdAt])
  @@map("generation_runs")
}

/// Лицензия конструктора сайта филиала (MKT9.2, DATA_MODEL §29.12). Выдаёт, продлевает и выключает только главный
/// администратор платформы (служебной ролью базы); приложение только читает. Действует: TRIAL или ACTIVE и срок не вышел
/// (`active_until` пуст: бессрочно, у TRIAL срок обязателен, CHECK). Только гостиничный филиал (триггер). Строки не
/// удаляются: выключение это OFF. Опубликованный сайт лицензия не выключает.
model SiteBuilderEntitlement {
  locationId  String          @id @map("location_id") @db.Uuid
  status      ExtensionStatus
  activeUntil DateTime?       @map("active_until") @db.Timestamptz(6)
  /// Номер счёта и т. п.; без персональных данных
  note        String?         @db.VarChar(300)
  updatedBy   String?         @map("updated_by") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime        @map("updated_at") @db.Timestamptz(6)

  location Location @relation(fields: [locationId], references: [id], onDelete: Restrict)
  editor   User?    @relation(fields: [updatedBy], references: [id], onDelete: SetNull)

  @@map("site_builder_entitlements")
}

/// Режим разговорной задачи ИИ сайта (MKT9.2): ответ словами, план сборки, три направления оформления
enum SiteAiRunMode {
  CHAT
  PLAN
  DESIGN
}

/// Состояние разговорной задачи: QUEUED → RUNNING → SUCCEEDED | FAILED; RUNNING → QUEUED при повторе; QUEUED → FAILED
enum SiteAiRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

/// Разговорная задача ИИ сайта (MKT9.2, DATA_MODEL §29.13): Чат, План, Оформление. Версий не создаёт никогда; сборка
/// идёт только через generation_runs. Хранит запрос человека и проверенный ответ (текст и структуру по режиму), без
/// промпта и сырого ответа модели. Очередь, бюджет организации и одна активная задача ИИ на сайт общие с generation_runs.
model SiteAiRun {
  id            String          @id @default(uuid()) @db.Uuid
  siteId        String          @map("site_id") @db.Uuid
  mode          SiteAiRunMode
  status        SiteAiRunStatus @default(QUEUED)
  requestKey    String          @map("request_key") @db.Uuid
  requestedById String?         @map("requested_by_id") @db.Uuid
  baseVersionId String?         @map("base_version_id") @db.Uuid
  briefHash     String?         @map("brief_hash") @db.Char(64)
  userText      String          @map("user_text") @db.VarChar(4000)
  assistantText String?         @map("assistant_text") @db.VarChar(12000)
  /// Структура ответа по режиму (вопросы, план, направления), до 32 КиБ (CHECK)
  payload       Json?
  model         String?         @db.VarChar(100)
  tokensInput   Int?            @map("tokens_input")
  tokensOutput  Int?            @map("tokens_output")
  tokensCached  Int?            @map("tokens_cached")
  attempts      Int             @default(0)
  nextAttemptAt DateTime?       @map("next_attempt_at") @db.Timestamptz(6)
  dispatchedAt  DateTime?       @map("dispatched_at") @db.Timestamptz(6)
  errorCode     String?         @map("error_code") @db.VarChar(40)
  errorMessage  String?         @map("error_message") @db.VarChar(500)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  startedAt     DateTime?       @map("started_at") @db.Timestamptz(6)
  finishedAt    DateTime?       @map("finished_at") @db.Timestamptz(6)

  site        MarketingSite         @relation(fields: [siteId], references: [id], onDelete: Restrict)
  requestedBy User?                 @relation(fields: [requestedById], references: [id], onDelete: SetNull)
  baseVersion MarketingSiteVersion? @relation(fields: [baseVersionId], references: [id], onDelete: Restrict)

  @@unique([siteId, requestKey])
  @@index([status, nextAttemptAt])
  @@index([requestedById, createdAt])
  @@index([siteId, createdAt])
  @@map("site_ai_runs")
}

/// Закладка версии сайта (MKT9.2, DATA_MODEL §29.14): звёздочка с подписью в «Истории». Только версия этого сайта, одна
/// на версию, не больше 20 на сайт (триггер). Ставит и снимает человек с правом `settings` при действующей лицензии.
model MarketingSiteVersionBookmark {
  id          String   @id @default(uuid()) @db.Uuid
  siteId      String   @map("site_id") @db.Uuid
  versionId   String   @map("version_id") @db.Uuid
  label       String   @db.VarChar(120)
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  site      MarketingSite        @relation(fields: [siteId], references: [id], onDelete: Restrict)
  version   MarketingSiteVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  createdBy User?                @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([siteId, versionId])
  @@index([versionId])
  @@map("marketing_site_version_bookmarks")
}

/// Действие журнала публикаций (DATA_MODEL §29.4, MKT7)
enum SitePublicationAction {
  PUBLISH
  ROLLBACK
  PAUSE
  RESUME
  ARCHIVE
}

/// Журнал публикаций управляемого сайта (DATA_MODEL §29.4, MKT7): только дописывается (триггер
/// marketing_site_publication_immutable, права); у PUBLISH, ROLLBACK, RESUME версия есть, у PAUSE и ARCHIVE нет (CHECK
/// marketing_site_publications_shape); версии только своего сайта (триггер marketing_site_publication_guard). Откат
/// возможен только на версию, которая встречается в этом журнале
model MarketingSitePublication {
  id                String                @id @default(uuid()) @db.Uuid
  siteId            String                @map("site_id") @db.Uuid
  action            SitePublicationAction
  versionId         String?               @map("version_id") @db.Uuid
  previousVersionId String?               @map("previous_version_id") @db.Uuid
  actorId           String?               @map("actor_id") @db.Uuid
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  site            MarketingSite         @relation(fields: [siteId], references: [id], onDelete: Restrict)
  version         MarketingSiteVersion? @relation("PublicationVersion", fields: [versionId], references: [id], onDelete: Restrict)
  previousVersion MarketingSiteVersion? @relation("PublicationPreviousVersion", fields: [previousVersionId], references: [id], onDelete: Restrict)
  actor           User?                 @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([siteId, createdAt])
  @@map("marketing_site_publications")
}

/// Вид домена сайта: платформенный поддомен `<slug>.<SITES_BASE_DOMAIN>` (MKT7) или свой домен клиента (MKT10,
/// Cloudflare for SaaS, Q-271)
enum SiteDomainKind {
  PLATFORM_SUBDOMAIN
  CUSTOM
}

/// Жизнь домена (§29.8): платформа PENDING → ACTIVE; свой домен PENDING → VERIFYING → VERIFIED → ACTIVE,
/// VERIFYING → FAILED; снятие REMOVED конечное (триггер site_domain_guard)
enum SiteDomainStatus {
  PENDING
  VERIFYING
  VERIFIED
  ACTIVE
  FAILED
  REMOVED
}

enum SiteDomainVerificationMethod {
  DNS_TXT
  HTTP_FILE
}

/// Хост управляемого сайта (DATA_MODEL §29.6, MKT7). Хост в одном виде (CHECK site_domains_host_format), один живой
/// владелец хоста и один основной домен сайта (частичные UNIQUE в миграции …064), сайт, хост и вид не меняются.
/// Физически не удаляется: снятие это REMOVED. providerRef: id Custom Hostname Cloudflare (MKT10)
model SiteDomain {
  id                 String                        @id @default(uuid()) @db.Uuid
  siteId             String                        @map("site_id") @db.Uuid
  host               String                        @db.VarChar(253)
  kind               SiteDomainKind
  isPrimary          Boolean                       @default(false) @map("is_primary")
  status             SiteDomainStatus              @default(PENDING)
  verificationMethod SiteDomainVerificationMethod? @map("verification_method")
  verificationToken  String?                       @map("verification_token") @db.VarChar(64)
  verifiedAt         DateTime?                     @map("verified_at") @db.Timestamptz(6)
  activatedAt        DateTime?                     @map("activated_at") @db.Timestamptz(6)
  removedAt          DateTime?                     @map("removed_at") @db.Timestamptz(6)
  lastCheckAt        DateTime?                     @map("last_check_at") @db.Timestamptz(6)
  failureCode        String?                       @map("failure_code") @db.VarChar(40)
  providerRef        String?                       @map("provider_ref") @db.VarChar(200)
  createdAt          DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                      @updatedAt @map("updated_at") @db.Timestamptz(6)

  site MarketingSite @relation(fields: [siteId], references: [id], onDelete: Restrict)

  @@index([siteId])
  @@map("site_domains")
}

enum SiteAssetKind {
  IMAGE
  LOGO
  FAVICON
}

enum SiteAssetStatus {
  UPLOADING
  PROCESSING
  READY
  REJECTED
  DELETED
}

enum SiteAssetSource {
  UPLOAD
  CHANNEX_IMPORT
}

/// Изображение управляемого сайта (DATA_MODEL §29.5, MKT8; Q-270: приватный S3 в Казахстане). Владелец Location. В базе
/// только непрозрачный ключ объекта `storage_ref` = `site-assets/<location_id>/<id>/<sha256>.webp|png` (CHECK), без
/// поставщика, бакета и адреса. Хранится только обработанная копия: без EXIF, WebP (картинка, логотип) или PNG 512×512
/// (фавиконка); `sha256` от неё. Неизменяемость после READY, переходы и запрет смены владельца держит триггер
/// site_asset_guard; физического DELETE у ролей приложения нет, удаление это DELETED.
model SiteAsset {
  id          String          @id @default(uuid()) @db.Uuid
  locationId  String          @map("location_id") @db.Uuid
  kind        SiteAssetKind
  status      SiteAssetStatus
  source      SiteAssetSource
  mimeType    String          @map("mime_type") @db.VarChar(40)
  storageRef  String          @unique @map("storage_ref") @db.VarChar(500)
  byteSize    Int             @map("byte_size")
  width       Int
  height      Int
  sha256      String          @db.Char(64)
  defaultAlt  Json?           @map("default_alt")
  createdById String?         @map("created_by_id") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime?       @map("deleted_at") @db.Timestamptz(6)

  location  Location @relation(fields: [locationId], references: [id], onDelete: Restrict)
  createdBy User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([locationId, status])
  @@map("site_assets")
}

/// Сессия посетителя (GA4: рвётся после 30 минут бездействия). Источник и устройство — на первом просмотре.
model WebSession {
  id              String        @id @default(uuid()) @db.Uuid
  siteId          String        @map("site_id") @db.Uuid
  visitorKey      String        @map("visitor_key")
  sessionKey      String        @map("session_key")
  startedAt       DateTime      @map("started_at") @db.Timestamptz(6)
  lastSeenAt      DateTime      @map("last_seen_at") @db.Timestamptz(6)
  pageviews       Int           @default(0)
  /// last_seen_at − started_at, обновляется приёмником
  durationSeconds Int           @default(0) @map("duration_seconds")
  landingPath     String?       @map("landing_path")
  referrerHost    String?       @map("referrer_host")
  sourceKind      WebSourceKind @default(DIRECT) @map("source_kind")
  source          String?
  medium          String?
  campaign        String?
  content         String?
  term            String?
  device          WebDevice     @default(DESKTOP)
  browser         String?
  os              String?
  language        String?
  /// Бронь, сделанная виджетом в этой сессии (срез 9): конверсия по источникам
  reservationId   String?       @map("reservation_id") @db.Uuid

  site         TrackedSite   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  reservation  Reservation?  @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  pageviewRows WebPageview[]
  events       WebEvent[]

  @@unique([siteId, sessionKey])
  @@index([siteId, startedAt])
  @@map("web_sessions")
}

model WebPageview {
  id        String   @id @default(uuid()) @db.Uuid
  sessionId String   @map("session_id") @db.Uuid
  at        DateTime @db.Timestamptz(6)
  path      String
  title     String?

  session WebSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([at])
  @@map("web_pageviews")
}

/// Событие с сайта: search (даты заезда → календарь спроса), booking_step, phone_click, whatsapp_click, custom.
/// props — только ключи из allow-list домена (arrival, departure, adults, children, category, rate, step).
model WebEvent {
  id        String   @id @default(uuid()) @db.Uuid
  sessionId String   @map("session_id") @db.Uuid
  at        DateTime @db.Timestamptz(6)
  name      String
  props     Json?

  session WebSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([at])
  @@map("web_events")
}

// ───────────────────────── §12 Неисправности системы ─────────────────────────
// Одно место для всего, что сломалось (ADR-028, срез 11). Техническая таблица, бизнес-данных не хранит.

enum IncidentClass {
  A
  B
  C
}

enum IncidentSeverity {
  CRITICAL
  WARNING
}

enum IncidentStatus {
  OPEN
  FIXING
  ESCALATED
  ACKNOWLEDGED
  RESOLVED
}

enum IncidentResolvedBy {
  GUARD
  AGENT
  STAFF
}

/// Одна строка на неисправность: пока не закрыта, повтор с тем же fingerprint только увеличивает occurrences
/// (частичный уникальный индекс WHERE status <> 'RESOLVED' — в миграции, Prisma такой не описывает).
/// В subject_id и details нет ФИО, телефонов, тел запросов и секретов (DATA_MODEL §12).
model SystemIncident {
  id             String              @id @default(uuid()) @db.Uuid
  kind           String
  class          IncidentClass
  severity       IncidentSeverity
  fingerprint    String
  status         IncidentStatus      @default(OPEN)
  title          String
  subjectType    String?             @map("subject_type")
  subjectId      String?             @map("subject_id")
  details        Json?
  occurrences    Int                 @default(1)
  firstSeenAt    DateTime            @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt     DateTime            @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  fixAttempts    Int                 @default(0) @map("fix_attempts")
  lastFixAt      DateTime?           @map("last_fix_at") @db.Timestamptz(6)
  lastFixResult  String?             @map("last_fix_result")
  alertedAt      DateTime?           @map("alerted_at") @db.Timestamptz(6)
  acknowledgedAt DateTime?           @map("acknowledged_at") @db.Timestamptz(6)
  resolvedAt     DateTime?           @map("resolved_at") @db.Timestamptz(6)
  resolvedBy     IncidentResolvedBy? @map("resolved_by")

  @@index([status, severity])
  @@index([kind, firstSeenAt])
  @@index([resolvedAt])
  @@map("system_incidents")
}

enum OrganizationStatus {
  TRIAL
  ACTIVE
  READ_ONLY
  SUSPENDED
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

/// Арендатор: одна организация — один клиент платформы (DATA_MODEL §13, ADR-046).
/// Разделения данных объекта по организациям в срезе 13 нет: пробный период пускает в демо-объект.
model Organization {
  id                String             @id @default(uuid()) @db.Uuid
  name              String             @db.VarChar(200)
  status            OrganizationStatus @default(TRIAL)
  /// Отчётная валюта партнёра (Platform P1, ADR-104, DATA_MODEL §18.4): в неё сводится аналитика филиалов
  /// с разными операционными валютами. Backfill — из фактической валюты Property, где она однозначна.
  reportingCurrency String             @default("KZT") @map("reporting_currency") @db.VarChar(3)
  trialEndsAt       DateTime?          @map("trial_ends_at") @db.Timestamptz(6)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  memberships    Membership[]
  sessions       Session[]
  invites        Invite[]
  properties     Property[]
  businesses     Business[]
  userErrors     UserError[]
  sellerProfiles SellerProfile[]
  agents         SellerAgent[]
  wizardDrafts   WizardDraft[]
  extensions     OrganizationExtension[]
  guests         Guest[]
  auditLogs      AuditLog[]
  customers      Customer[]

  sellerBookingIntents SellerBookingIntent[]

  @@map("organizations")
}

/// Человек. Почта в нижнем регистре — за этим следит CHECK в миграции, Prisma такого не описывает.
/// Паролей нет намеренно (ADR-046): вход по одноразовому коду на почту.
model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String     @unique @db.VarChar(320)
  name            String?    @db.VarChar(200)
  status          UserStatus @default(ACTIVE)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  lastLoginAt     DateTime?  @map("last_login_at") @db.Timestamptz(6)
  /// Когда человек подтвердил почту по ссылке из письма (решение владельца 20.09.2026).
  /// NULL — не подтвердил: вход закрыт. У заведённых до 20.09.2026 проставлено миграцией.
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(6)

  /// Вход по паролю (§13.8, ADR-049, миграция 20260915000014). Пустая строка — пароль не задан:
  /// такой человек по паролю не войдёт. scrypt из node:crypto, формат «scrypt$N$r$p$соль$хеш».
  passwordHash   String    @default("") @map("password_hash")
  /// Промахи подряд; после пяти вход заперт до locked_until (домен accounts)
  failedAttempts Int       @default(0) @map("failed_attempts")
  lockedUntil    DateTime? @map("locked_until") @db.Timestamptz(6)

  sellerAgents                 SellerAgent[]
  wizardDrafts                 WizardDraft[]
  memberships                  Membership[]
  sessions                     Session[]
  invitesIssued                Invite[]                       @relation("InviteCreatedBy")
  passwordResets               PasswordReset[]
  emailVerifications           EmailVerification[]
  auditLogs                    AuditLog[]
  cashOperations               CashOperation[]
  cashReconciliations          CashReconciliation[]
  tasksAssigned                DeskTask[]                     @relation("DeskTaskAssignee")
  tasksDone                    DeskTask[]                     @relation("DeskTaskDoneBy")
  tasksCreated                 DeskTask[]                     @relation("DeskTaskCreatedBy")
  paymentRequests              PaymentRequest[]
  fiscalReceipts               FiscalReceipt[]
  competitorsCreated           Competitor[]
  competitorReadings           CompetitorOccupancy[]
  userErrors                   UserError[]
  beautyEmployees              Employee[]
  appointmentsCreated          Appointment[]
  sellerProfileEdits           SellerProfile[]
  platformAdmin                PlatformAdmin?
  extensionEdits               OrganizationExtension[]
  foodReservationsCreated      RestaurantReservation[]
  foodAssignmentsCreated       TableAssignment[]
  marketingSitesCreated        MarketingSite[]
  marketingSiteVersionsCreated MarketingSiteVersion[]
  generationRunsRequested      GenerationRun[]
  sitePublications             MarketingSitePublication[]
  siteAssetsCreated            SiteAsset[]
  siteAiRunsRequested          SiteAiRun[]
  siteBookmarksCreated         MarketingSiteVersionBookmark[]
  siteBuilderEntitlementEdits  SiteBuilderEntitlement[]

  @@map("users")
}

/// Одноразовая ссылка на установку пароля: приглашение сотрудника и сброс по его просьбе (§13.9, ADR-049).
/// В базе только хеш токена — утечка базы не даёт задать пароль.
model PasswordReset {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("password_resets")
}

/// Ссылка подтверждения почты. В базе только хеш ссылки, срок 72 часа, ссылка одноразовая.
/// Новая ссылка гасит прежние: одна живая ссылка на человека.
model EmailVerification {
  /// id выдаёт база, у ключа на users нет ON UPDATE — как в миграции 20260920000015
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("email_verifications")
}

/// Роль в организации (DATA_MODEL §16.1, ADR-083). MANAGER — управляющий (v1.14, ADR-107); STAFF на экране —
/// «администратор». Роль — готовый набор прав (§16.5, `packages/domain/src/accounts/permissions.ts`).
enum MembershipRole {
  OWNER
  MANAGER
  STAFF
}

/// Человек в организации. Роль — §16.1: у самого раннего участника организации `OWNER` (миграция 20260925000020).
model Membership {
  userId         String         @map("user_id") @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  role           MembershipRole @default(STAFF)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Рабочий телефон в этой организации, +E.164 (CHECK в миграции 044; DATA_MODEL v2.10, Q-244)
  phone          String?        @db.VarChar(16)
  /// Должность свободным текстом; права даёт роль, не должность
  position       String?        @db.VarChar(100)

  user         User         @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@id([userId, organizationId])
  @@index([organizationId])
  @@map("memberships")
}

/// Активная сессия. В куке подписанное значение, не сам id. «Выйти везде» проставляет revoked_at всем строкам.
model Session {
  id             String    @id @default(uuid()) @db.Uuid
  tokenHash      String    @unique @map("token_hash") @db.VarChar(64)
  userId         String    @map("user_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  issuedAt       DateTime  @default(now()) @map("issued_at") @db.Timestamptz(6)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  userAgent      String?   @map("user_agent") @db.VarChar(400)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)
  /// Когда сессию видели последний раз: заполняется при проверке токена (§13.9)
  lastSeenAt     DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)

  user         User         @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Приглашение в организацию по почте. В базе только хеш ссылки, срок 7 суток.
model Invite {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  email          String         @db.VarChar(320)
  /// С какой ролью человек войдёт (v1.14, ADR-107): MANAGER или STAFF; CHECK invites_role_not_owner — не OWNER
  role           MembershipRole @default(STAFF)
  tokenHash      String         @unique @map("token_hash") @db.VarChar(64)
  expiresAt      DateTime       @map("expires_at") @db.Timestamptz(6)
  acceptedAt     DateTime?      @map("accepted_at") @db.Timestamptz(6)
  createdBy      String         @map("created_by") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  creator      User         @relation("InviteCreatedBy", fields: [createdBy], references: [id])

  @@index([organizationId])
  @@map("invites")
}

// ───────────────────────── §14 Ошибки, которые видит человек ─────────────────────────

/// Ответ API с ошибкой (4xx, 5xx), который получил вошедший человек (DATA_MODEL §14, ТЗ ред. 1 П3, ADR-079).
/// Читает ИИ-помощник по узкому ключу. Время ставит приложение — у колонки нет DEFAULT; CHECK status 400…599 — в миграции.
/// Тела запроса, значений из адреса и данных гостей нет по построению: маршрут шаблоном, текст ответа с маской.
model UserError {
  id             String   @id @default(uuid()) @db.Uuid
  at             DateTime @db.Timestamptz(6)
  userId         String   @map("user_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  method         String   @db.VarChar(10)
  route          String   @db.VarChar(200)
  status         Int      @db.SmallInt
  message        String   @db.VarChar(500)
  requestId      String   @map("request_id") @db.Uuid

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId, organizationId, at])
  @@index([at])
  @@map("user_errors")
}

// ───────────────────────── §15 Профиль ИИ-продавца ─────────────────────────

enum SellerAddressForm {
  FORMAL
  INFORMAL
}

/// Эмодзи в ответах продавца — значения модели бота `SellerProfile` (Б6): нет, изредка, только в приветствии
enum SellerEmoji {
  NEVER
  MODERATE
  GREETING_ONLY
}

/// Длина реплик — значения модели бота: коротко или развёрнуто
enum SellerReplyLength {
  SHORT
  DETAILED
}

/// Профиль ИИ-продавца: одна строка на АГЕНТА (SA2.5; до сужения — на организацию; DATA_MODEL §15, ТЗ ред. 1 П5, ADR-079, ADR-081). Поля экрана
/// «Настройки», не текст промпта: ядро правил держит бот. Перечисления и пределы — модели бота `SellerProfile`. Поля
/// доставки (П8) ведёт платформа. CHECK на число языков и строк в списках — в миграции.
model SellerProfile {
  /// Агент, которому принадлежит профиль (DATA_MODEL §20.2, сужение SA2.5 — миграция 036): первичный ключ. У перенесённого
  /// продавца равен `organization_id`; у организации может быть по профилю на каждого агента
  agentId          String            @id @map("agent_id") @db.Uuid
  agent            SellerAgent       @relation(fields: [agentId], references: [id], onDelete: Restrict)
  /// Организация профиля — граница арендатора (RLS §17.3); согласие с организацией агента держит триггер
  organizationId   String            @map("organization_id") @db.Uuid
  botName          String?           @map("bot_name") @db.VarChar(40)
  addressForm      SellerAddressForm @map("address_form")
  emoji            SellerEmoji       @default(NEVER)
  replyLength      SellerReplyLength @map("reply_length")
  languages        String[]
  greeting         String            @default("") @db.VarChar(300)
  includedInPrice  String            @default("") @map("included_in_price") @db.VarChar(1000)
  extraCharges     String            @default("") @map("extra_charges") @db.VarChar(1000)
  houseRules       String            @default("") @map("house_rules") @db.VarChar(2000)
  /// Запреты по одному в строке: до 30 (CHECK в миграции), строка до 300 — проверяет домен
  prohibitions     String[]          @default([])
  /// Когда звать человека, по одному в строке: до 30 (CHECK), строка до 300
  callHumanWhen    String[]          @default([]) @map("call_human_when")
  /// [{ question, answer }], до 50 — проверяет домен (`parseSellerProfile`)
  faq              Json              @default("[]")
  /// Инструкция продавцу одним текстом (ADR-097); есть — продавцу уходит она, а не поля выше
  promptText       String?           @map("prompt_text") @db.VarChar(20000)
  updatedAt        DateTime          @map("updated_at") @db.Timestamptz(6)
  updatedBy        String?           @map("updated_by") @db.Uuid
  /// Версия профиля (`updated_at`), которую продавец принял; NULL — не принимал
  profileAppliedAt DateTime?         @map("profile_applied_at") @db.Timestamptz(6)
  /// SHA-256 последних доставленных фактов объекта
  factsHash        String?           @map("facts_hash") @db.Char(64)
  factsAppliedAt   DateTime?         @map("facts_applied_at") @db.Timestamptz(6)
  /// Последний отказ продавца, маскированный; NULL — отказов нет
  lastError        String?           @map("last_error") @db.VarChar(500)
  lastErrorAt      DateTime?         @map("last_error_at") @db.Timestamptz(6)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  editor       User?        @relation(fields: [updatedBy], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@map("seller_profiles")
}

/// Главный администратор платформы (DATA_MODEL §16.2, ADR-083). Ставит и снимает только команда на сервере
/// (`npm run accounts -- platform-admin`): маршрута API, который пишет сюда, нет. Действует, пока `revoked_at` пуст.
/// Отдельная таблица, а не поле в `users`: правка профиля человека не может задеть отметку.
model PlatformAdmin {
  userId    String    @id @map("user_id") @db.Uuid
  grantedAt DateTime  @default(now()) @map("granted_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  note      String?   @db.VarChar(200)

  user User @relation(fields: [userId], references: [id])

  @@map("platform_admins")
}

/// Платное расширение организации (DATA_MODEL §16.3, ADR-083)
enum ExtensionKind {
  AI_SELLER
}

/// `TRIAL` — пробный, `ACTIVE` — оплачен, `OFF` — выключен
enum ExtensionStatus {
  TRIAL
  ACTIVE
  OFF
}

/// Расширение действует, если статус `TRIAL` или `ACTIVE` и срок не вышел (`active_until` пуст — бессрочно). Меняет
/// только главный администратор; строки не удаляются, выключение — `OFF`. Денег здесь нет (Q-141, Q-143).
model OrganizationExtension {
  organizationId String          @map("organization_id") @db.Uuid
  extension      ExtensionKind
  status         ExtensionStatus
  /// NULL — бессрочно; у пробного обязателен (CHECK в миграции)
  activeUntil    DateTime?       @map("active_until") @db.Timestamptz(6)
  /// Номер счёта и т. п.; без персональных данных
  note           String?         @db.VarChar(300)
  updatedAt      DateTime        @map("updated_at") @db.Timestamptz(6)
  updatedBy      String?         @map("updated_by") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  editor       User?        @relation(fields: [updatedBy], references: [id], onDelete: SetNull)

  @@id([organizationId, extension])
  @@map("organization_extensions")
}

/// Guest onboarding model approved 26.09.2026; production migration requires separate cutover.
model SellerAgent {
  createdBy      String         @map("created_by") @db.Uuid
  creator        User           @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name           String         @db.VarChar(200)
  scenario       String         @default("sales") @db.VarChar(16)
  /// Хранимых состояний четыре: draft / active / paused / archived (DATA_MODEL §20.3); active и paused — только с филиалом (CHECK)
  lifecycle      String         @default("draft") @db.VarChar(16)
  /// Филиал агента (DATA_MODEL §20.2). Частичный уникальный индекс `seller_agents_one_seller_per_location` — не более
  /// одного неархивного AI-продавца (scenario = 'sales') на филиал; триггер сверяет организацию филиала с организацией агента
  locationId     String?        @map("location_id") @db.Uuid
  location       Location?      @relation(fields: [locationId], references: [id], onDelete: Restrict)
  profile        Json           @default("{}")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  draft          WizardDraft?
  /// Рабочий профиль продавца этого агента (`seller_profiles`, DATA_MODEL §20.2); у агентов мастера пусто
  workingProfile SellerProfile?

  bookingIntents SellerBookingIntent[]

  @@index([organizationId])
  @@index([locationId])
  @@map("seller_agents")
}

model WizardSession {
  id        String        @id @default(uuid()) @db.Uuid
  tokenHash String        @unique @map("token_hash") @db.VarChar(64)
  ref       String        @default("") @db.VarChar(200)
  lastStep  String        @default("intro") @map("last_step") @db.VarChar(24)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt DateTime      @map("expires_at") @db.Timestamptz(6)
  draft     WizardDraft?
  survey    WizardSurvey?
  events    WizardEvent[]

  @@index([expiresAt])
  @@map("wizard_sessions")
}

model WizardDraft {
  claimedBy          String?         @map("claimed_by") @db.Uuid
  claimant           User?           @relation(fields: [claimedBy], references: [id], onDelete: Restrict)
  organizationId     String?         @map("organization_id") @db.Uuid
  organization       Organization?   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  id                 String          @id @default(uuid()) @db.Uuid
  guestSessionId     String          @unique @map("guest_session_id") @db.Uuid
  session            WizardSession   @relation(fields: [guestSessionId], references: [id], onDelete: Cascade)
  businessName       String          @default("") @map("business_name") @db.VarChar(200)
  niche              String          @default("") @db.VarChar(200)
  description        String          @default("") @db.VarChar(10000)
  config             Json            @default("{}")
  sources            Json            @default("[]")
  revision           Int             @default(0)
  generatedRevision  Int?            @map("generated_revision")
  generatedPrompt    String?         @map("generated_prompt")
  generatedKnowledge Json            @default("[]") @map("generated_knowledge")
  testMessagesUsed   Int             @default(0) @map("test_messages_used")
  agentId            String?         @unique @map("agent_id") @db.Uuid
  agent              SellerAgent?    @relation(fields: [agentId], references: [id], onDelete: Restrict)
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  jobs               WizardJob[]
  messages           WizardMessage[]

  @@map("wizard_drafts")
}

model WizardJob {
  id          String      @id @default(uuid()) @db.Uuid
  draftId     String      @map("draft_id") @db.Uuid
  draft       WizardDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  kind        String      @db.VarChar(16)
  revision    Int
  state       String      @default("queued") @db.VarChar(16)
  attempt     Int         @default(0)
  retryAt     DateTime?   @map("retry_at") @db.Timestamptz(6)
  maskedError String?     @map("masked_error") @db.VarChar(500)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([draftId, kind, revision])
  @@map("wizard_jobs")
}

model WizardMessage {
  id        String      @id @default(uuid()) @db.Uuid
  draftId   String      @map("draft_id") @db.Uuid
  draft     WizardDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  requestId String      @map("request_id") @db.VarChar(64)
  role      String      @db.VarChar(16)
  text      String      @db.VarChar(16000)
  state     String      @db.VarChar(16)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([draftId, requestId, role])
  @@map("wizard_messages")
}

model WizardSurvey {
  guestSessionId String        @id @map("guest_session_id") @db.Uuid
  session        WizardSession @relation(fields: [guestSessionId], references: [id], onDelete: Cascade)
  goal           String        @default("") @db.VarChar(1000)
  teamSize       String        @default("") @map("team_size") @db.VarChar(32)
  leadsPerDay    String        @default("") @map("leads_per_day") @db.VarChar(32)
  source         String        @default("") @db.VarChar(200)
  industry       String        @default("") @db.VarChar(200)

  @@map("wizard_surveys")
}

model WizardEvent {
  id               String        @id @default(uuid()) @db.Uuid
  guestSessionId   String        @map("guest_session_id") @db.Uuid
  session          WizardSession @relation(fields: [guestSessionId], references: [id], onDelete: Cascade)
  eventType        String        @map("event_type") @db.VarChar(60)
  payload          Json          @default("{}")
  deduplicationKey String        @unique @map("deduplication_key") @db.VarChar(200)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([guestSessionId, createdAt])
  @@map("wizard_events")
}

/// Задача стойки (DATA_MODEL §22, утверждено 03.10.2026): открыта или сделана, без повторов и уведомлений
model DeskTask {
  id             String       @id @default(uuid()) @db.Uuid
  propertyId     String       @map("property_id") @db.Uuid
  title          String
  note           String?
  dueDate        DateTime     @map("due_date") @db.Date
  /// «HH:MM» по часам объекта; null — «весь день»
  dueTime        String?      @map("due_time")
  priority       TaskPriority @default(NORMAL)
  assigneeUserId String?      @map("assignee_user_id") @db.Uuid
  reservationId  String?      @map("reservation_id") @db.Uuid
  guestId        String?      @map("guest_id") @db.Uuid
  doneAt         DateTime?    @map("done_at") @db.Timestamptz(6)
  doneById       String?      @map("done_by_id") @db.Uuid
  createdById    String?      @map("created_by_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  property    Property     @relation(fields: [propertyId], references: [id])
  assignee    User?        @relation("DeskTaskAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull)
  doneBy      User?        @relation("DeskTaskDoneBy", fields: [doneById], references: [id], onDelete: SetNull)
  createdBy   User?        @relation("DeskTaskCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  reservation Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  guest       Guest?       @relation(fields: [guestId], references: [id], onDelete: SetNull)

  @@index([propertyId, dueDate])
  @@index([reservationId])
  @@map("desk_tasks")
}

// ───────────────────────── Beauty-домен (DATA_MODEL §19 и §19.1, ADR-104, срез B1) ─────────────────────────
// Своя предметная область вертикали BEAUTY: Property, Reservation, InventoryUnit, RatePlan и шахматка здесь
// не участвуют, общей таблицы броней и общего «ресурса» у вертикалей нет (ARCHITECTURE.md §19).
// Пересечение записей одного мастера держит база: EXCLUDE USING gist в миграции, Prisma такого не описывает.

enum CustomerStatus {
  ACTIVE
  ARCHIVED
}

enum EmployeeStatus {
  ACTIVE
  ARCHIVED
}

enum AppointmentStatus {
  BOOKED
  CONFIRMED
  DONE
  NO_SHOW
  CANCELLED
}

/// Клиент сети: канонический на организацию (freeze-решение №2, закрыло Q-198). Гость §3 не меняется.
/// Телефон уникален внутри организации, частичным индексом в миграции (без телефона клиентов много).
model Customer {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  firstName      String         @map("first_name") @db.VarChar(100)
  lastName       String?        @map("last_name") @db.VarChar(100)
  phone          String?        @db.VarChar(32)
  email          String?        @db.VarChar(320)
  notes          String?
  status         CustomerStatus @default(ACTIVE)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization           Organization            @relation(fields: [organizationId], references: [id])
  businesses             CustomerBusiness[]
  appointments           Appointment[]
  restaurantReservations RestaurantReservation[]

  @@index([organizationId])
  @@map("customers")
}

/// Видимость клиента в конкретном бизнесе: строка появляется при первом обращении в этот бизнес
model CustomerBusiness {
  customerId String   @map("customer_id") @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  customer Customer @relation(fields: [customerId], references: [id])
  business Business @relation(fields: [businessId], references: [id])

  @@id([customerId, businessId])
  @@index([businessId])
  @@map("customer_businesses")
}

/// Мастер: сотрудник сети, не филиала. Филиалы ведёт EmployeeLocation, к одному салону навсегда не привязан.
/// `userId`: мастер со входом в систему (ARCHITECTURE.md §13), самого входа фаза 3 не делает.
model Employee {
  id         String         @id @default(uuid()) @db.Uuid
  businessId String         @map("business_id") @db.Uuid
  name       String         @db.VarChar(200)
  phone      String?        @db.VarChar(32)
  email      String?        @db.VarChar(320)
  userId     String?        @map("user_id") @db.Uuid
  status     EmployeeStatus @default(ACTIVE)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  business     Business           @relation(fields: [businessId], references: [id])
  user         User?              @relation(fields: [userId], references: [id])
  locations    EmployeeLocation[]
  services     EmployeeService[]
  workingHours WorkingHours[]
  timeOffs     TimeOff[]
  appointments Appointment[]

  @@index([businessId])
  @@map("employees")
}

/// Один мастер работает в нескольких салонах. Филиал своего бизнеса, проверяет триггер
model EmployeeLocation {
  employeeId String   @map("employee_id") @db.Uuid
  locationId String   @map("location_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  employee Employee @relation(fields: [employeeId], references: [id])
  location Location @relation(fields: [locationId], references: [id])

  @@id([employeeId, locationId])
  @@index([locationId])
  @@map("employee_locations")
}

/// Единый каталог услуг сети: принадлежит бизнесу, на филиалы не копируется.
/// `currency`: валюта цены каталога (Q-257), цену в своей валюте филиал задаёт через LocationService.
model BeautyService {
  id              String   @id @default(uuid()) @db.Uuid
  businessId      String   @map("business_id") @db.Uuid
  name            String   @db.VarChar(200)
  category        String?  @db.VarChar(100)
  durationMinutes Int      @map("duration_minutes")
  price           BigInt
  currency        String   @db.VarChar(3)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  business     Business          @relation(fields: [businessId], references: [id])
  locations    LocationService[]
  employees    EmployeeService[]
  appointments Appointment[]

  @@index([businessId])
  @@map("beauty_services")
}

/// Филиал включает услугу каталога и может поставить свои цену и длительность; пусто, действует каталог
model LocationService {
  locationId       String   @map("location_id") @db.Uuid
  serviceId        String   @map("service_id") @db.Uuid
  enabled          Boolean  @default(true)
  priceOverride    BigInt?  @map("price_override")
  durationOverride Int?     @map("duration_override")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  location Location      @relation(fields: [locationId], references: [id])
  service  BeautyService @relation(fields: [serviceId], references: [id])

  @@id([locationId, serviceId])
  @@index([serviceId])
  @@map("location_services")
}

/// Что мастер умеет. Услуга своего бизнеса, проверяет триггер
model EmployeeService {
  employeeId String   @map("employee_id") @db.Uuid
  serviceId  String   @map("service_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  employee Employee      @relation(fields: [employeeId], references: [id])
  service  BeautyService @relation(fields: [serviceId], references: [id])

  @@id([employeeId, serviceId])
  @@index([serviceId])
  @@map("employee_services")
}

/// График мастера всегда в контексте филиала (в каком салоне он стоит в этот день).
/// Недельный шаблон (Q-251), исключения в TimeOff. `weekday`: 0 воскресенье, как Date.getDay()
model WorkingHours {
  id         String   @id @default(uuid()) @db.Uuid
  employeeId String   @map("employee_id") @db.Uuid
  locationId String   @map("location_id") @db.Uuid
  weekday    Int      @db.SmallInt
  timeFrom   DateTime @map("time_from") @db.Time(6)
  timeTo     DateTime @map("time_to") @db.Time(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  employee Employee @relation(fields: [employeeId], references: [id])
  location Location @relation(fields: [locationId], references: [id])

  @@unique([employeeId, locationId, weekday, timeFrom])
  @@index([locationId, weekday])
  @@map("working_hours")
}

/// Отпуска и отсутствия мастера: календарные даты включительно с обеих сторон
model TimeOff {
  id         String   @id @default(uuid()) @db.Uuid
  employeeId String   @map("employee_id") @db.Uuid
  dateFrom   DateTime @map("date_from") @db.Date
  dateTo     DateTime @map("date_to") @db.Date
  reason     String?  @db.VarChar(200)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId, dateFrom])
  @@map("time_offs")
}

/// Запись клиента к мастеру на услугу. `price` и `currency`: снимок на момент записи, не ссылка на каталог.
/// Пересечение записей одного мастера запрещает база (EXCLUDE в миграции), отменённая и незаезд места не держат.
model Appointment {
  id          String            @id @default(uuid()) @db.Uuid
  locationId  String            @map("location_id") @db.Uuid
  customerId  String            @map("customer_id") @db.Uuid
  employeeId  String            @map("employee_id") @db.Uuid
  serviceId   String            @map("service_id") @db.Uuid
  startsAt    DateTime          @map("starts_at") @db.Timestamptz(6)
  endsAt      DateTime          @map("ends_at") @db.Timestamptz(6)
  status      AppointmentStatus @default(BOOKED)
  price       BigInt
  currency    String            @db.VarChar(3)
  notes       String?
  createdById String?           @map("created_by_id") @db.Uuid
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  location  Location      @relation(fields: [locationId], references: [id])
  customer  Customer      @relation(fields: [customerId], references: [id])
  employee  Employee      @relation(fields: [employeeId], references: [id])
  service   BeautyService @relation(fields: [serviceId], references: [id])
  createdBy User?         @relation(fields: [createdById], references: [id])

  @@index([locationId, startsAt])
  @@index([employeeId, startsAt])
  @@index([customerId])
  @@map("appointments")
}

/// MV3 server resume, approved 04.10.2026. Vertical is derived from Location.Business.
model OnboardingProgress {
  locationId  String    @id @map("location_id") @db.Uuid
  flowVersion Int       @map("flow_version")
  currentStep String    @map("current_step") @db.VarChar(50)
  draft       Json      @default("{}")
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  location    Location  @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@map("onboarding_progress")
}

enum RestaurantReservationStatus {
  BOOKED
  CONFIRMED
  SEATED
  COMPLETED
  NO_SHOW
  CANCELLED
}

enum RestaurantReservationSource {
  DESK
  WALK_IN
}

model DiningArea {
  id         String        @id @default(uuid()) @db.Uuid
  locationId String        @map("location_id") @db.Uuid
  name       String        @db.VarChar(200)
  sortOrder  Int           @default(0) @map("sort_order")
  active     Boolean       @default(true)
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  location   Location      @relation(fields: [locationId], references: [id])
  tables     DiningTable[]

  @@index([locationId])
  @@map("dining_areas")
}

model DiningTable {
  id          String            @id @default(uuid()) @db.Uuid
  areaId      String            @map("area_id") @db.Uuid
  name        String            @db.VarChar(100)
  capacity    Int
  sortOrder   Int               @default(0) @map("sort_order")
  active      Boolean           @default(true)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  area        DiningArea        @relation(fields: [areaId], references: [id])
  assignments TableAssignment[]

  @@unique([areaId, name])
  @@map("dining_tables")
}

model ServicePeriod {
  id                     String                  @id @default(uuid()) @db.Uuid
  locationId             String                  @map("location_id") @db.Uuid
  name                   String                  @db.VarChar(100)
  weekday                Int                     @db.SmallInt
  timeFrom               DateTime                @map("time_from") @db.Time(0)
  timeTo                 DateTime                @map("time_to") @db.Time(0)
  endsNextDay            Boolean                 @default(false) @map("ends_next_day")
  defaultDurationMinutes Int                     @map("default_duration_minutes")
  active                 Boolean                 @default(true)
  createdAt              DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  location               Location                @relation(fields: [locationId], references: [id])
  reservations           RestaurantReservation[]

  @@index([locationId])
  @@map("service_periods")
}

model RestaurantReservation {
  id                  String                      @id @default(uuid()) @db.Uuid
  locationId          String                      @map("location_id") @db.Uuid
  customerId          String                      @map("customer_id") @db.Uuid
  servicePeriodId     String                      @map("service_period_id") @db.Uuid
  startsAt            DateTime                    @map("starts_at") @db.Timestamptz(6)
  endsAt              DateTime                    @map("ends_at") @db.Timestamptz(6)
  partySize           Int                         @map("party_size")
  status              RestaurantReservationStatus @default(BOOKED)
  source              RestaurantReservationSource @default(DESK)
  notes               String?
  creationKey         String                      @map("creation_key") @db.VarChar(200)
  creationFingerprint String                      @map("creation_fingerprint") @db.VarChar(64)
  createdById         String?                     @map("created_by_id") @db.Uuid
  createdAt           DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(6)
  location            Location                    @relation(fields: [locationId], references: [id])
  customer            Customer                    @relation(fields: [customerId], references: [id])
  servicePeriod       ServicePeriod               @relation(fields: [servicePeriodId], references: [id])
  createdBy           User?                       @relation(fields: [createdById], references: [id])
  tableAssignment     TableAssignment?

  @@unique([locationId, creationKey])
  @@index([locationId, startsAt])
  @@index([customerId])
  @@index([status])
  @@index([servicePeriodId])
  @@map("restaurant_reservations")
}

model TableAssignment {
  reservationId String                @id @map("reservation_id") @db.Uuid
  tableId       String                @map("table_id") @db.Uuid
  assignedAt    DateTime              @default(now()) @map("assigned_at") @db.Timestamptz(6)
  assignedById  String?               @map("assigned_by_id") @db.Uuid
  updatedAt     DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  reservation   RestaurantReservation @relation(fields: [reservationId], references: [id])
  table         DiningTable           @relation(fields: [tableId], references: [id])
  assignedBy    User?                 @relation(fields: [assignedById], references: [id])

  @@index([tableId])
  @@map("table_assignments")
}
