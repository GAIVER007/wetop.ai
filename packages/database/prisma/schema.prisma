// Prisma schema — ТОЛЬКО утверждённые разделы DATA_MODEL.md v1.0 (07.09.2026):
//   §1 Объект и физическая структура, §2 Бронирование, §3 Гости, §4 Housekeeping и блокировки,
//   §5 Тарифы, §6 Folio, §7 Channel Manager, §8 Внешние события, §10 Аудит. Плюс SQL вне Prisma: exclusion constraint на allocations (миграция 20260909000003).
// Раздел 6 (Folio) утверждён 09.09.2026 (ADR-014): счёт на проживание, миграция 20260909000006.
// Любое изменение сущности/поля/связи — сначала правка DATA_MODEL.md (AGENTS.md §2).
//
// Соглашения: имена таблиц и колонок — snake_case через @map; id — uuid;
// события — timestamptz (UTC); stay dates — DATE в timezone объекта (AGENTS.md §13).
// Внешние ID Exely хранятся как ссылки (exely_*), не как собственные ключи (ADR-003).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // url задаётся в prisma.config.ts из DIRECT_URL / DATABASE_URL (значение — только в .env)
}

// ───────────────────────── §1 Объект и физическая структура ─────────────────────────

/// Объект размещения. В MVP одна запись (ADR-001), но все запросы фильтруются по property_id.
model Property {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  legalName    String?  @map("legal_name")
  bin          String?
  address      String?
  /// IANA timezone объекта, например Asia/Almaty
  timezone     String
  /// ISO 4217, на объекте KZT
  currency     String   @db.Char(3)
  /// Локальное время заезда "HH:mm", на объекте 14:00
  checkInTime  String   @map("check_in_time")
  /// Локальное время выезда "HH:mm", на объекте 12:00
  checkOutTime String   @map("check_out_time")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  buildings          Building[]
  accommodationTypes AccommodationType[]
  reservations       Reservation[]
  ratePlans          RatePlan[]
  channelMappings    ChannelMapping[]
  payments           Payment[]
  services           Service[]
  trackedSites       TrackedSite[]

  @@map("properties")
}

model Building {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @map("property_id") @db.Uuid
  name       String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  property Property @relation(fields: [propertyId], references: [id])
  floors   Floor[]

  @@unique([propertyId, name])
  @@map("buildings")
}

model Floor {
  id         String   @id @default(uuid()) @db.Uuid
  buildingId String   @map("building_id") @db.Uuid
  name       String
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  building      Building       @relation(fields: [buildingId], references: [id])
  physicalRooms PhysicalRoom[]

  @@unique([buildingId, name])
  @@map("floors")
}

/// Продаваемая категория. Гендерное деление dorm — отдельные категории, не атрибут (DATA_MODEL §1).
enum AccommodationKind {
  PRIVATE_ROOM
  DORM_BED
  APARTMENT
}

model AccommodationType {
  id               String            @id @default(uuid()) @db.Uuid
  propertyId       String            @map("property_id") @db.Uuid
  code             String
  name             String
  kind             AccommodationKind
  capacityAdults   Int               @map("capacity_adults")
  /// На объекте у всех 0: детское размещение выключено
  capacityChildren Int               @default(0) @map("capacity_children")
  active           Boolean           @default(true)
  /// ID категории в Exely (например 5074312) — внешняя ссылка, ADR-003
  exelyId          String?           @map("exely_id")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  property        Property                    @relation(fields: [propertyId], references: [id])
  units           InventoryUnit[]
  items           ReservationItem[]
  ratePlanLinks   RatePlanAccommodationType[]
  dailyRates      DailyRate[]
  restrictions    Restriction[]
  channelMappings ChannelMapping[]

  @@unique([propertyId, code])
  @@unique([propertyId, exelyId])
  @@map("accommodation_types")
}

/// Физическая комната. По ADR-013 при импорте заполняется 1:1 из единицы продажи (Q-095 отложен).
/// Бизнес-логика MVP на неё не опирается — только на InventoryUnit.
model PhysicalRoom {
  id         String   @id @default(uuid()) @db.Uuid
  floorId    String   @map("floor_id") @db.Uuid
  roomNumber String   @map("room_number")
  name       String?
  capacity   Int
  isDorm     Boolean  @default(false) @map("is_dorm")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  floor Floor           @relation(fields: [floorId], references: [id])
  units InventoryUnit[]

  @@unique([floorId, roomNumber])
  @@map("physical_rooms")
}

enum InventoryUnitKind {
  ROOM
  BED
}

/// Статус уборки по Exely: «Грязно», «Убрано», «Проверено». Ремонт/вывод из продажи — InventoryBlock.
enum HousekeepingStatus {
  DIRTY
  CLEAN
  INSPECTED
}

/// Единица продажи = ячейка (ADR-013). На объекте 88 = 16 ROOM + 72 BED.
/// Ничего не выводится из номера единицы — только явные связи (DATA_MODEL принцип 7).
model InventoryUnit {
  id                  String             @id @default(uuid()) @db.Uuid
  physicalRoomId      String             @map("physical_room_id") @db.Uuid
  accommodationTypeId String             @map("accommodation_type_id") @db.Uuid
  kind                InventoryUnitKind
  /// Код единицы в PMS; в MVP уникален глобально (один объект)
  code                String             @unique
  housekeepingStatus  HousekeepingStatus @default(DIRTY) @map("housekeeping_status")
  active              Boolean            @default(true)
  /// «№ комнаты в Exely» (1…88) — внешняя ссылка, ADR-003. Из него ничего не выводится.
  exelyRoomNumber     String?            @unique @map("exely_room_number")
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  physicalRoom       PhysicalRoom        @relation(fields: [physicalRoomId], references: [id])
  accommodationType  AccommodationType   @relation(fields: [accommodationTypeId], references: [id])
  blocks             InventoryBlock[]
  housekeepingEvents HousekeepingEvent[]
  allocations        Allocation[]

  @@index([accommodationTypeId])
  @@index([physicalRoomId])
  @@map("inventory_units")
}

// ───────────────────────── §2 Бронирование ─────────────────────────

/// Источник брони. Обязателен без значения по умолчанию (Q-089 — до ответа принято самое строгое).
enum ReservationSource {
  DESK
  PHONE
  WHATSAPP
  WALK_IN
  INSTAGRAM
  OTA
  WEBSITE
}

enum ReservationStatus {
  TENTATIVE
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}

/// Шапка брони (коммерческая бронь). Статус — производный от проживаний (v0.3), хранится для выборок.
/// `confirmationNumber` у перенесённых броней = номер брони в Exely (20260802-513903-…): один
/// бизнес-ключ для идемпотентного импорта (ADR-003, ADR-007).
model Reservation {
  id                 String            @id @default(uuid()) @db.Uuid
  propertyId         String            @map("property_id") @db.Uuid
  confirmationNumber String            @map("confirmation_number")
  source             ReservationSource
  /// Канал OTA/сайт как текст источника (например Booking.com); null для стойки
  channel            String?
  /// Номер брони на стороне канала (OTA), если известен
  externalId         String?           @map("external_id")
  status             ReservationStatus
  bookedAt           DateTime?         @map("booked_at") @db.Timestamptz(6)
  arrivalDate        DateTime          @map("arrival_date") @db.Date
  departureDate      DateTime          @map("departure_date") @db.Date
  adults             Int
  children           Int               @default(0)
  currency           String            @db.Char(3)
  /// integer minor units (тиын), ADR-008
  totalAmount        BigInt            @map("total_amount")
  primaryGuestId     String?           @map("primary_guest_id") @db.Uuid
  /// Заметки — главный канал передачи смены (FINDINGS §2 #8)
  notes              String?
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  property     Property          @relation(fields: [propertyId], references: [id])
  primaryGuest Guest?            @relation("primaryGuest", fields: [primaryGuestId], references: [id])
  items        ReservationItem[]
  webSessions  WebSession[]

  @@unique([propertyId, confirmationNumber])
  @@index([propertyId, arrivalDate])
  @@index([propertyId, departureDate])
  @@index([status])
  @@map("reservations")
}

/// Проживание (room stay): одна ячейка на весь период (ADR-013; `quantity` убран, v0.3).
/// Статус ведётся здесь: no-show, переселение и счёт в Exely — на уровне проживания.
model ReservationItem {
  id                  String            @id @default(uuid()) @db.Uuid
  reservationId       String            @map("reservation_id") @db.Uuid
  accommodationTypeId String            @map("accommodation_type_id") @db.Uuid
  arrivalDate         DateTime          @map("arrival_date") @db.Date
  departureDate       DateTime          @map("departure_date") @db.Date
  /// integer minor units (тиын), ADR-008
  price               BigInt
  status              ReservationStatus
  /// Тариф проживания (Q-102); null — перенесено из Exely, где тариф на проживании не отдаётся
  ratePlanId          String?           @map("rate_plan_id") @db.Uuid
  /// Гостей на проживании (Q-102): occupancy для цены и штрафа
  adults              Int               @default(1)
  children            Int               @default(0)
  /// pmsRoomStayId в Exely — внешняя ссылка для идемпотентного импорта (ADR-003)
  exelyRoomStayId     String?           @unique @map("exely_room_stay_id")
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  reservation       Reservation       @relation(fields: [reservationId], references: [id])
  accommodationType AccommodationType @relation(fields: [accommodationTypeId], references: [id])
  ratePlan          RatePlan?         @relation(fields: [ratePlanId], references: [id])
  allocations       Allocation[]
  stayGuests        StayGuest[]
  folio             Folio?

  @@index([reservationId])
  @@index([ratePlanId])
  @@index([accommodationTypeId, arrivalDate, departureDate])
  @@map("reservation_items")
}

/// Кто живёт в каком проживании (v0.3). Нужно для eQonaq (на гостя) и folio по проживанию.
model StayGuest {
  reservationItemId String  @map("reservation_item_id") @db.Uuid
  guestId           String  @map("guest_id") @db.Uuid
  isPrimary         Boolean @default(false) @map("is_primary")

  reservationItem ReservationItem @relation(fields: [reservationItemId], references: [id])
  guest           Guest           @relation(fields: [guestId], references: [id])

  @@id([reservationItemId, guestId])
  @@index([guestId])
  @@map("stay_guests")
}

/// Фактическое назначение ячейки на период [start_date, end_date). Переселение = закрыть одну
/// allocation и открыть другую (ADR-006). Правило автоназначения для OTA — Q-094.
model Allocation {
  id                String   @id @default(uuid()) @db.Uuid
  reservationItemId String   @map("reservation_item_id") @db.Uuid
  inventoryUnitId   String   @map("inventory_unit_id") @db.Uuid
  startDate         DateTime @map("start_date") @db.Date
  endDate           DateTime @map("end_date") @db.Date
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  reservationItem ReservationItem @relation(fields: [reservationItemId], references: [id])
  inventoryUnit   InventoryUnit   @relation(fields: [inventoryUnitId], references: [id])

  @@index([inventoryUnitId, startDate, endDate])
  @@index([reservationItemId])
  @@map("allocations")
}

// ───────────────────────── §3 Гости ─────────────────────────

enum Gender {
  MALE
  FEMALE
  UNKNOWN
}

/// Персональные данные — доступ по роли, не попадают в логи (SECURITY.md §1).
/// В dev-БД только анонимизированные значения (ADR-018).
model Guest {
  id            String    @id @default(uuid()) @db.Uuid
  firstName     String    @map("first_name")
  lastName      String    @map("last_name")
  middleName    String?   @map("middle_name")
  birthDate     DateTime? @map("birth_date") @db.Date
  /// ISO 3166-1 alpha-3; обязательно на check-in, не на импорте (DATA_MODEL §3)
  citizenship   String?   @db.Char(3)
  gender        Gender    @default(UNKNOWN)
  phone         String?
  email         String?
  notes         String?
  /// pmsPersonId в Exely — внешняя ссылка (ADR-003)
  exelyPersonId String?   @unique @map("exely_person_id")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  documents           GuestDocument[]
  stays               StayGuest[]
  primaryReservations Reservation[]   @relation("primaryGuest")

  @@index([lastName, firstName])
  @@index([phone])
  @@map("guests")
}

/// Документ гостя. Номер — только шифротекст (PII_ENCRYPTION_KEY), просмотр логируется.
model GuestDocument {
  id              String    @id @default(uuid()) @db.Uuid
  guestId         String    @map("guest_id") @db.Uuid
  type            String
  numberEncrypted String    @map("number_encrypted")
  issueCountry    String?   @map("issue_country") @db.Char(3)
  issuedAt        DateTime? @map("issued_at") @db.Date
  expiresAt       DateTime? @map("expires_at") @db.Date
  documentFileId  String?   @map("document_file_id")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  guest Guest @relation(fields: [guestId], references: [id])

  @@index([guestId])
  @@map("guest_documents")
}

// ───────────────────────── §4 Housekeeping и блокировки ─────────────────────────

model HousekeepingEvent {
  id              String             @id @default(uuid()) @db.Uuid
  inventoryUnitId String             @map("inventory_unit_id") @db.Uuid
  fromStatus      HousekeepingStatus @map("from_status")
  toStatus        HousekeepingStatus @map("to_status")
  /// Сущность User появится после Q-060…Q-064; до этого — идентификатор без FK
  userId          String?            @map("user_id") @db.Uuid
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  inventoryUnit InventoryUnit @relation(fields: [inventoryUnitId], references: [id])

  @@index([inventoryUnitId, createdAt])
  @@map("housekeeping_events")
}

enum InventoryBlockType {
  MAINTENANCE
  MANAGEMENT
  OUT_OF_ORDER
  OTHER
}

/// Единственный источник правды для «единица недоступна» (DATA_MODEL v0.3).
/// Даты — DATE в timezone объекта, полуинтервал [date_from, date_to).
model InventoryBlock {
  id              String             @id @default(uuid()) @db.Uuid
  inventoryUnitId String             @map("inventory_unit_id") @db.Uuid
  dateFrom        DateTime           @map("date_from") @db.Date
  dateTo          DateTime           @map("date_to") @db.Date
  reason          String?
  type            InventoryBlockType
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  inventoryUnit InventoryUnit @relation(fields: [inventoryUnitId], references: [id])

  @@index([inventoryUnitId, dateFrom, dateTo])
  @@map("inventory_blocks")
}

// ───────────────────────── §5 Тарифы ─────────────────────────

/// Тарифный план. На объекте 6 (3 без продаж — Q-082: до ответа импортируются с active=false).
/// Питания нет ни у одного; сезонов в модели нет (DailyRate покрывает).
model RatePlan {
  id                  String              @id @default(uuid()) @db.Uuid
  propertyId          String              @map("property_id") @db.Uuid
  code                String
  name                String
  currency            String              @db.Char(3)
  mealPlan            String?             @map("meal_plan")
  active              Boolean             @default(true)
  /// ID тарифа в Exely (например 10157482) — внешняя ссылка, ADR-003
  exelyId             String?             @map("exely_id")
  /// Пометка импорта: каналы, к которым тариф привязан в Exely (справочно, не бизнес-логика)
  note                String?
  /// Штраф при отмене/незаезде (Q-103); умолчание — правило Exely «стоимость первых суток»
  cancellationPenalty CancellationPenalty @default(FIRST_NIGHT) @map("cancellation_penalty")
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  property        Property                    @relation(fields: [propertyId], references: [id])
  types           RatePlanAccommodationType[]
  dailyRates      DailyRate[]
  restrictions    Restriction[]
  channelMappings ChannelMapping[]
  items           ReservationItem[]
  trackedSites    TrackedSite[]

  @@unique([propertyId, code])
  @@unique([propertyId, exelyId])
  @@map("rate_plans")
}

/// Тариф действует на категорию. На объекте — декартово произведение (тарифы на все категории).
model RatePlanAccommodationType {
  ratePlanId          String @map("rate_plan_id") @db.Uuid
  accommodationTypeId String @map("accommodation_type_id") @db.Uuid

  ratePlan          RatePlan          @relation(fields: [ratePlanId], references: [id])
  accommodationType AccommodationType @relation(fields: [accommodationTypeId], references: [id])

  @@id([ratePlanId, accommodationTypeId])
  @@map("rate_plan_accommodation_types")
}

/// Цена за ночь на дату. occupancy — число гостей (1 или 2; отличается только у «Двухместной»).
model DailyRate {
  date                DateTime @db.Date
  accommodationTypeId String   @map("accommodation_type_id") @db.Uuid
  ratePlanId          String   @map("rate_plan_id") @db.Uuid
  occupancy           Int      @default(1)
  /// integer minor units (тиын), ADR-008
  price               BigInt
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  accommodationType AccommodationType @relation(fields: [accommodationTypeId], references: [id])
  ratePlan          RatePlan          @relation(fields: [ratePlanId], references: [id])

  @@id([date, accommodationTypeId, ratePlanId, occupancy])
  @@index([accommodationTypeId, date])
  @@map("daily_rates")
}

/// Ограничения продаж на дату. На объекте сейчас ни одного, механизм обязателен для OTA.
model Restriction {
  date                DateTime @db.Date
  accommodationTypeId String   @map("accommodation_type_id") @db.Uuid
  ratePlanId          String   @map("rate_plan_id") @db.Uuid
  minStay             Int?     @map("min_stay")
  maxStay             Int?     @map("max_stay")
  stopSell            Boolean  @default(false) @map("stop_sell")
  closedToArrival     Boolean  @default(false) @map("closed_to_arrival")
  closedToDeparture   Boolean  @default(false) @map("closed_to_departure")
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  accommodationType AccommodationType @relation(fields: [accommodationTypeId], references: [id])
  ratePlan          RatePlan          @relation(fields: [ratePlanId], references: [id])

  @@id([date, accommodationTypeId, ratePlanId])
  @@index([accommodationTypeId, date])
  @@map("restrictions")
}

// ───────────────────────── §10 Аудит ─────────────────────────

/// Обязательно логируется: даты, цена, room move, cancellation, payment, refund,
/// ручное изменение availability, изменение документа гостя (SECURITY.md §6). Без PII в логах.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  action     String
  before     Json?
  after      Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ───────────────────────── §7 Channel Manager ─────────────────────────

/// Соответствие наших сущностей объектам Channex и каналов (DATA_MODEL §7). Vendor ID живут только здесь
/// и в packages/integrations (ADR-004). Одна строка = одна пара (категория, тариф) у одного провайдера.
model ChannelMapping {
  id                       String   @id @default(uuid()) @db.Uuid
  propertyId               String   @map("property_id") @db.Uuid
  /// Провайдер: пока только `channex`
  provider                 String
  /// Канал (booking.com, agoda, …); null для сущностей уровня провайдера
  channel                  String?
  localAccommodationTypeId String?  @map("local_accommodation_type_id") @db.Uuid
  localRatePlanId          String?  @map("local_rate_plan_id") @db.Uuid
  providerPropertyId       String   @map("provider_property_id")
  providerRoomTypeId       String?  @map("provider_room_type_id")
  providerRatePlanId       String?  @map("provider_rate_plan_id")
  channelPropertyId        String?  @map("channel_property_id")
  channelRoomId            String?  @map("channel_room_id")
  channelRateId            String?  @map("channel_rate_id")
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  property          Property           @relation(fields: [propertyId], references: [id])
  accommodationType AccommodationType? @relation(fields: [localAccommodationTypeId], references: [id])
  ratePlan          RatePlan?          @relation(fields: [localRatePlanId], references: [id])

  @@unique([provider, providerRatePlanId])
  @@index([propertyId, provider])
  @@index([localAccommodationTypeId])
  @@index([localRatePlanId])
  @@map("channel_mappings")
}

// ───────────────────────── §8 Внешние события ─────────────────────────

enum ExternalEventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
}

/// Журнал входящих событий (webhook, revision feed). UNIQUE(provider, external_event_id) —
/// идемпотентность обязательна (ADR-007): сначала записано, потом обработано, повтор безопасен.
model ExternalEvent {
  id              String              @id @default(uuid()) @db.Uuid
  provider        String
  externalEventId String              @map("external_event_id")
  type            String
  receivedAt      DateTime            @default(now()) @map("received_at") @db.Timestamptz(6)
  payloadHash     String              @map("payload_hash")
  payload         Json?
  status          ExternalEventStatus @default(RECEIVED)
  attemptCount    Int                 @default(0) @map("attempt_count")
  lastError       String?             @map("last_error")
  /// Каким путём дошло: webhook, опрос ленты или кнопка «Обработать заново». Без этого поля
  /// «бронь пришла сама» и «подобрал опрос через пять минут» в журнале неразличимы.
  receivedVia     ExternalEventVia    @default(PULL) @map("received_via")
  processedAt     DateTime?           @map("processed_at") @db.Timestamptz(6)

  @@unique([provider, externalEventId])
  @@index([status, receivedAt])
  @@map("external_events")
}

enum ExternalEventVia {
  WEBHOOK
  PULL
  MANUAL
}

enum ChannelOutboxKind {
  AVAILABILITY
  RESTRICTIONS
}

enum ChannelOutboxStatus {
  PENDING
  SENT
  FAILED
}

/// Очередь исходящих изменений ARI (DATA_MODEL §7, ChannelOutbox). Не бизнес-данные.
model ChannelOutbox {
  id            String              @id @default(uuid()) @db.Uuid
  provider      String
  kind          ChannelOutboxKind
  payload       Json
  status        ChannelOutboxStatus @default(PENDING)
  attempts      Int                 @default(0)
  nextAttemptAt DateTime            @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  taskId        String?             @map("task_id")
  lastError     String?             @map("last_error")
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  sentAt        DateTime?           @map("sent_at") @db.Timestamptz(6)

  @@index([provider, status, nextAttemptAt])
  @@map("channel_outbox")
}

// ───────────────────────── §6 Folio (финансы) ─────────────────────────

/// Штраф при отмене и незаезде — политика тарифа (Q-103): правило Exely «первые сутки» для всех тарифов
enum CancellationPenalty {
  NONE
  FIRST_NIGHT
  FULL_STAY
}

enum FolioStatus {
  OPEN
  CLOSED
}

enum ChargeKind {
  ACCOMMODATION
  SERVICE
  PENALTY
  ADJUSTMENT
}

/// 9 способов оплаты из справочника Exely (spravochniki.md §9); дубль «Наличными через кассу» сведён в CASH (Q-083).
enum PaymentMethod {
  CASH
  CARD_TERMINAL
  BANK_TRANSFER_LEGAL
  EXTERNAL
  BANK_TRANSFER_PERSON
  CARD_GUARANTEE
  DEPOSIT
  HALYK
  KASPI
}

enum PaymentStatus {
  COMPLETED
  VOIDED
}

/// Счёт гостя — один на проживание (ADR-014). Создаётся вместе с проживанием.
model Folio {
  id                String      @id @default(uuid()) @db.Uuid
  reservationItemId String      @unique @map("reservation_item_id") @db.Uuid
  status            FolioStatus @default(OPEN)
  currency          String      @db.Char(3)
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  closedAt          DateTime?   @map("closed_at") @db.Timestamptz(6)

  reservationItem ReservationItem     @relation(fields: [reservationItemId], references: [id])
  charges         Charge[]
  allocations     PaymentAllocation[]
  refunds         Refund[]

  @@map("folios")
}

model Service {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @map("property_id") @db.Uuid
  code       String
  nameRu     String   @map("name_ru")
  nameKz     String?  @map("name_kz")
  /// integer minor units (тиын), ADR-008
  price      BigInt
  tax        Int?
  group      String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  property Property @relation(fields: [propertyId], references: [id])
  charges  Charge[]

  @@unique([propertyId, code])
  @@map("services")
}

/// Начисление на счёт. Сторно — voided_at, строка не удаляется.
model Charge {
  id          String     @id @default(uuid()) @db.Uuid
  folioId     String     @map("folio_id") @db.Uuid
  kind        ChargeKind
  serviceId   String?    @map("service_id") @db.Uuid
  description String
  quantity    Int        @default(1)
  /// integer minor units (тиын), ADR-008
  unitPrice   BigInt     @map("unit_price")
  /// integer minor units; ADJUSTMENT может быть отрицательным
  amount      BigInt
  serviceDate DateTime?  @map("service_date") @db.Date
  createdBy   String?    @map("created_by") @db.Uuid
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  voidedAt    DateTime?  @map("voided_at") @db.Timestamptz(6)

  folio   Folio    @relation(fields: [folioId], references: [id])
  service Service? @relation(fields: [serviceId], references: [id])

  @@index([folioId])
  @@map("charges")
}

/// Платёж. Распределяется по счетам через PaymentAllocation (Σ = amount).
model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  propertyId        String        @map("property_id") @db.Uuid
  method            PaymentMethod
  /// integer minor units (тиын), ADR-008
  amount            BigInt
  currency          String        @db.Char(3)
  status            PaymentStatus @default(COMPLETED)
  /// exely:<roomStayId> для перенесённых платежей; ссылка банка/канала для живых
  externalReference String?       @map("external_reference")
  note              String?
  paidAt            DateTime      @default(now()) @map("paid_at") @db.Timestamptz(6)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  property    Property            @relation(fields: [propertyId], references: [id])
  allocations PaymentAllocation[]
  refunds     Refund[]

  @@unique([propertyId, externalReference])
  @@index([propertyId, paidAt])
  @@map("payments")
}

model PaymentAllocation {
  paymentId String @map("payment_id") @db.Uuid
  folioId   String @map("folio_id") @db.Uuid
  /// integer minor units (тиын), ADR-008
  amount    BigInt

  payment Payment @relation(fields: [paymentId], references: [id])
  folio   Folio   @relation(fields: [folioId], references: [id])

  @@id([paymentId, folioId])
  @@index([folioId])
  @@map("payment_allocations")
}

model Refund {
  id                String   @id @default(uuid()) @db.Uuid
  paymentId         String   @map("payment_id") @db.Uuid
  folioId           String   @map("folio_id") @db.Uuid
  /// integer minor units (тиын), ADR-008
  amount            BigInt
  reason            String?
  externalReference String?  @map("external_reference")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  payment Payment @relation(fields: [paymentId], references: [id])
  folio   Folio   @relation(fields: [folioId], references: [id])

  @@index([folioId])
  @@map("refunds")
}

// ───────────────────────── §11 Аналитика сайта ─────────────────────────
// Срез 8 (план plans/slice-8-web-analytics.md, принят владельцем 12.09.2026). Персональных данных нет по
// построению: IP и полный User-Agent не сохраняются, visitor_key — случайное число из браузера (ADR-018).

enum TrackedSiteStatus {
  ACTIVE
  PAUSED
}

enum WebSourceKind {
  DIRECT
  SEARCH
  SOCIAL
  PAID
  EMAIL
  REFERRAL
}

enum WebDevice {
  DESKTOP
  MOBILE
  TABLET
}

/// Сайт объекта со счётчиком. Ключ стоит в HTML сайта — не секрет; домены ограничивают приёмник.
model TrackedSite {
  id                String            @id @default(uuid()) @db.Uuid
  propertyId        String            @map("property_id") @db.Uuid
  name              String
  /// Домены сайта; Origin/Referer приёмника должны совпадать (сам домен или поддомен)
  hosts             String[]
  /// pms_ + 12 hex — ключ в атрибуте data-site
  publicKey         String            @unique @map("public_key")
  status            TrackedSiteStatus @default(ACTIVE)
  /// Виджет бронирования на сайте (срез 9): выключен, пока владелец не включит на карточке сайта
  bookingEnabled    Boolean           @default(false) @map("booking_enabled")
  /// Тариф, по которому виджет считает цену и создаёт бронь; null — бронирование не настроено
  bookingRatePlanId String?           @map("booking_rate_plan_id") @db.Uuid
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  property        Property     @relation(fields: [propertyId], references: [id])
  bookingRatePlan RatePlan?    @relation(fields: [bookingRatePlanId], references: [id])
  sessions        WebSession[]

  @@index([propertyId])
  @@map("tracked_sites")
}

/// Сессия посетителя (GA4: рвётся после 30 минут бездействия). Источник и устройство — на первом просмотре.
model WebSession {
  id              String        @id @default(uuid()) @db.Uuid
  siteId          String        @map("site_id") @db.Uuid
  visitorKey      String        @map("visitor_key")
  sessionKey      String        @map("session_key")
  startedAt       DateTime      @map("started_at") @db.Timestamptz(6)
  lastSeenAt      DateTime      @map("last_seen_at") @db.Timestamptz(6)
  pageviews       Int           @default(0)
  /// last_seen_at − started_at, обновляется приёмником
  durationSeconds Int           @default(0) @map("duration_seconds")
  landingPath     String?       @map("landing_path")
  referrerHost    String?       @map("referrer_host")
  sourceKind      WebSourceKind @default(DIRECT) @map("source_kind")
  source          String?
  medium          String?
  campaign        String?
  content         String?
  term            String?
  device          WebDevice     @default(DESKTOP)
  browser         String?
  os              String?
  language        String?
  /// Бронь, сделанная виджетом в этой сессии (срез 9): конверсия по источникам
  reservationId   String?       @map("reservation_id") @db.Uuid

  site         TrackedSite   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  reservation  Reservation?  @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  pageviewRows WebPageview[]
  events       WebEvent[]

  @@unique([siteId, sessionKey])
  @@index([siteId, startedAt])
  @@map("web_sessions")
}

model WebPageview {
  id        String   @id @default(uuid()) @db.Uuid
  sessionId String   @map("session_id") @db.Uuid
  at        DateTime @db.Timestamptz(6)
  path      String
  title     String?

  session WebSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([at])
  @@map("web_pageviews")
}

/// Событие с сайта: search (даты заезда → календарь спроса), booking_step, phone_click, whatsapp_click, custom.
/// props — только ключи из allow-list домена (arrival, departure, adults, children, category, rate, step).
model WebEvent {
  id        String   @id @default(uuid()) @db.Uuid
  sessionId String   @map("session_id") @db.Uuid
  at        DateTime @db.Timestamptz(6)
  name      String
  props     Json?

  session WebSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([at])
  @@map("web_events")
}
