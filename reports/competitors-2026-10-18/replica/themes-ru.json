{
  "_about": "Русские темы для reviews.py (салоны, отели, рестораны в Казахстане). Регулярные выражения Python, без учёта регистра.",
  "request_patterns": [
    "хотелось бы", "добавьте", "добавить бы", "было бы (хорошо|удобно|здорово|неплохо)", "не хватает",
    "нет (возможности|функции|опции)", "нельзя (добавить|изменить|удалить|выбрать|настроить|выгрузить)",
    "невозможно", "почему (нельзя|нет)", "просим", "пожалуйста,? (сделайте|добавьте)"
  ],
  "themes": [
    {"id": "crash", "label": "Вылеты, зависания, ошибки", "kind": "complaint",
     "patterns": ["выл[её]т", "вылета", "завис", "глюч", "глюк", "баг", "ошибк", "не работает", "не открывается", "белый экран", "сбо[йи]", "крашит", "тормоз", "лага", "медленн", "долго гру"]},
    {"id": "login", "label": "Вход, пароль, аккаунт", "kind": "complaint",
     "patterns": ["не (могу|можем|получается) (войти|зайти)", "авторизац", "парол", "вход", "код (не приходит|не пришёл|не пришел)", "смс не", "выкидывает", "разлогин"]},
    {"id": "support", "label": "Поддержка", "kind": "complaint",
     "patterns": ["поддержк", "техподдерж", "не отвеча", "менеджер", "игнор", "дозвон", "оператор"]},
    {"id": "price", "label": "Цена и доплаты", "kind": "complaint",
     "patterns": ["дорог", "цен[аыу]", "стоимост", "тариф", "доплат", "подписк", "платн", "деньги", "комисси", "абонентск"]},
    {"id": "billing", "label": "Списания, возвраты, отключение", "kind": "complaint",
     "patterns": ["списа", "возврат", "верн(ите|уть) деньги", "отключ", "заблокир", "мошен", "развод", "предоплат"]},
    {"id": "booking", "label": "Запись, брони, овербукинг", "kind": "complaint",
     "patterns": ["запис", "брон", "овербук", "двойн", "отмен", "не пришл[аи]? (запись|бронь)", "пропал[аи]? (запись|бронь)", "время"]},
    {"id": "notifications", "label": "Уведомления, WhatsApp, SMS", "kind": "complaint",
     "patterns": ["уведомлен", "напоминан", "whatsapp", "ватсап", "вотсап", "смс", "sms", "пуш", "push", "рассылк"]},
    {"id": "updates", "label": "Обновления ломают привычное", "kind": "complaint",
     "patterns": ["обновлен", "после обнов", "верните", "стало хуже", "новая версия", "старая версия"]},
    {"id": "ux", "label": "Неудобный интерфейс", "kind": "complaint",
     "patterns": ["неудоб", "непонятн", "сложн", "запутан", "интерфейс", "мелк", "не интуитив"]},
    {"id": "fiscal", "label": "Касса, чеки, ОФД, Kaspi", "kind": "complaint",
     "patterns": ["касс", "чек", "офд", "фискал", "kaspi", "каспи", "терминал", "эквайр", "webkassa", "вебкасс"]},
    {"id": "stock", "label": "Склад, техкарты, учёт", "kind": "complaint",
     "patterns": ["склад", "остатк", "техкарт", "себестоим", "инвентар", "списан", "накладн", "учёт", "учет"]},
    {"id": "reports", "label": "Отчёты и аналитика", "kind": "request",
     "patterns": ["отч[её]т", "аналитик", "статистик", "выгруз", "excel", "эксель"]},
    {"id": "registration", "label": "Регистрация гостей, eQonaq, МВД", "kind": "complaint",
     "patterns": ["eqonaq", "е-?конак", "иконак", "регистрац", "мвд", "миграц", "иностран", "паспорт", "штраф"]},
    {"id": "staff", "label": "Сотрудники, зарплата, права", "kind": "request",
     "patterns": ["зарплат", "сотрудник", "мастер", "официант", "администратор", "права доступа", "процент мастер"]},
    {"id": "integrations", "label": "Интеграции", "kind": "request",
     "patterns": ["интеграц", "1с", "1c", "booking\\.com", "glovo", "wolt", "яндекс", "instagram", "инстаграм", "2гис", "2gis", "api"]},
    {"id": "language", "label": "Казахский язык и локализация", "kind": "request",
     "patterns": ["казах", "қазақ", "на казахском", "перевод"]}
  ]
}
