+      if (loading) return;
+      main.focus({ preventScroll: true });
+      stop();
+    });
+  };
+  const observer = new MutationObserver(focus);
+  observer.observe(content, {
+    childList: true,
+    subtree: true,
+    attributes: true,
+    attributeFilter: ['aria-busy', 'hidden', 'class'],
+  });
