/* ---------- свет за стеклом ---------- */
body {
  position: relative;
  isolation: isolate;
}
body::before {
  content: '';
  position: fixed;
  inset: -20vmax;
  z-index: var(--layer-glass-glow);
  pointer-events: none;
  background:
    radial-gradient(42vmax 38vmax at 14% 4%, var(--glow-1), transparent 62%),
    radial-gradient(38vmax 34vmax at 88% 10%, var(--glow-2), transparent 60%),
    radial-gradient(46vmax 40vmax at 74% 82%, var(--glow-3), transparent 64%),
    radial-gradient(34vmax 30vmax at 6% 88%, var(--glow-1), transparent 66%);
}
body::after {
  content: '';
  position: fixed;
  inset: 0;
  z-index: var(--layer-glass-stars);
  pointer-events: none;
  opacity: 0.6;
  background-image:
    radial-gradient(1px 1px at 12% 18%, var(--star), transparent),
    radial-gradient(1px 1px at 68% 8%, var(--star), transparent),
    radial-gradient(1px 1px at 36% 62%, var(--star), transparent),
    radial-gradient(1px 1px at 82% 46%, var(--star), transparent),
    radial-gradient(1px 1px at 24% 88%, var(--star), transparent),
    radial-gradient(1px 1px at 92% 74%, var(--star), transparent);
  background-size: 620px 620px;
}
/* Печать и режим повышенного контраста света за стеклом не знают: там бумага и плотный фон. */
@media print {
  body::before,
  body::after {
    display: none;
  }
}
[data-theme='contrast'] body::before,
[data-theme='contrast'] body::after {
  display: none;
}

/*
