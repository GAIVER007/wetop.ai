              «{draft.site.name}» — адрес сайта не указан.{' '}
              <Link href=\"/website/settings\">Указать адрес</Link>
            </Notice>
          ))}
        </Stack>
      )}
    </Page>
  );
}

async function SiteOverview({ card }: { card: TrackedSiteCard }) {
