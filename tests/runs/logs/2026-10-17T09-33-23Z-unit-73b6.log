              {report.sources.map((r) => (
                <tr
                  key={`${r.kind}-${r.source ?? ''}`}
                  data-testid=\"an-source-row\"
                  data-kind={r.kind}
                  data-source={r.source ?? ''}
                  data-sessions={r.sessions}
                >
                  <td>{KIND_RU[r.kind]}</td>
                  <td>{r.source ?? '—'}</td>
                  <td className=\"num\">{r.sessions}</td>
                  <td className=\"num\">{r.visitors}</td>
