{
  "extends": "./tsconfig.base.json",
  "compilerOptions": { "noEmit": true, "experimentalDecorators": true, "emitDecoratorMetadata": true },
  "include": [
    "packages/*/src/**/*.ts",
    "scripts/*/src/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts"
